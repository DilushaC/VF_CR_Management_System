@using System.Text.Json
@using VF_CR_Management_System.Data.Models

@{
    var username = Context.Session.GetString("UserName");
    var empNo = Context.Session.GetString("EmpNo");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
    var userId = Context.Session.GetString("UserId");
    var pageURLs = Context.Session.GetString("PageUrls");

    List<string> allowedPages = new List<string>();
    List<string> pagePermissions = new List<string>();
    List<string> iconClasses = new List<string>();

    var menuJson = Context.Session.GetString("MenuItems");

    // Deserialize
    List<MenuItem> menus = string.IsNullOrWhiteSpace(menuJson)
        ? new List<MenuItem>()
        : JsonSerializer.Deserialize<List<MenuItem>>(menuJson,
            new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? new List<MenuItem>();

    // Only ACTIVE main menus (ParentMenuItemId == null)
    List<MenuItem> mainMenus = menus
        .Where(m => m.ParentMenuItemId == null && m.IsActive)
        .OrderBy(m => m.DisplayOrder)
        .ToList();

    // Current path (no query string, no trailing slash, lowercased)
    var currentPath = Context.Request.Path.ToString()
        .ToLower()
        .TrimEnd('/');
    if (string.IsNullOrWhiteSpace(currentPath))
        currentPath = "/";

    // Exact-match helper: "/role/management" == "/role/management"  — no partial hits
    Func<string, bool> matches = (url) =>
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var normalized = "/" + url.ToLower().TrimStart('/').TrimEnd('/');
        return currentPath == normalized;
    };

    // Initials for the avatar (e.g. "John Smith" -> "JS")
    string Initials(string? n)
    {
        var l = (n ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(p => char.IsLetter(p[0]))
            .Select(p => char.ToUpperInvariant(p[0]))
            .Take(2)
            .ToArray();
        return l.Length > 0 ? new string(l) : "?";
    }

    var firstName = (username ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "there";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRMS</title>
    <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description" />
    <meta content="Coderthemes" name="author" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/Vallibel-logo.ico">

    <!-- Sweet Alert css-->
    <link href="~/assets/vendor/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />

    <!-- Vendor css -->
    <link href="~/assets/css/vendor.min.css" rel="stylesheet" type="text/css" />

    <!-- App css -->
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />

    <!-- Icons css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    @*     <!-- Site css (project-specific overrides) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CR_Management_System.styles.css" asp-append-version="true" /> *@

    <link href="~/assets/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/vendor/datatables.net-fixedcolumns-bs5/css/fixedColumns.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/vendor/datatables.net-fixedheader-bs5/css/fixedHeader.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/vendor/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/vendor/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" type="text/css" />

    <!-- Layout look and feel (loads after the theme css so it can override it; page styles load later still) -->
    <style>
        /* ===== Palette ===== */
        :root,
        [data-bs-theme="light"] {
            --ct-primary: #e57373;
            --ct-primary-rgb: 229, 115, 115;
            --ct-primary-text-emphasis: #b71c1c;
            --crl-brand: #591120;
            --crl-brand-mid: #7d1d31;
            --crl-brand-deep: #3a0a15;
            --crl-gold: #e0b25a;
            --crl-bg: #f6f2f2;
            --crl-surface: #ffffff;
            --crl-line: #eadfe1;
            --crl-text: #2b1a1e;
            --crl-muted: #7b6b6f;
            --crl-glass: rgba(255, 255, 255, .78);
        }

        [data-bs-theme="dark"] {
            --crl-bg: #15111a;
            --crl-surface: #1e1a25;
            --crl-line: #332d3b;
            --crl-text: #f0e7e9;
            --crl-muted: #a99ca1;
            --crl-glass: rgba(30, 26, 37, .82);
        }

        /* ===== Animated top line ===== */
        .color-line {
            height: 3px !important;
            background: linear-gradient(90deg, #591120, #c0475f, #e0b25a, #c0475f, #591120) !important;
            background-size: 200% 100%;
            animation: crl-flow 8s linear infinite;
        }

            .color-line.is-loading {
                animation-duration: 1s;
            }

        @@keyframes crl-flow {
            to {
                background-position: 200% 0;
            }
        }

        /* ===== Sidebar ===== */
        .sidenav-menu {
            background: linear-gradient(180deg, #4e0f1e 0%, #3a0a15 55%, #2a0710 100%) !important;
            border-right: 0 !important;
            box-shadow: 8px 0 30px -18px rgba(58, 10, 21, .7);
        }

            .sidenav-menu .logo.crl-logo {
                display: flex !important;
                align-items: center;
                gap: .75rem;
                height: auto;
                min-height: 76px;
                padding: 14px 14px;
                text-decoration: none;
            }

        .crl-logo-tile {
            flex: 0 0 auto;
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: .8rem;
            background: #fff;
            box-shadow: 0 6px 16px -6px rgba(0, 0, 0, .5);
        }

            .crl-logo-tile img {
                width: 32px;
                height: 32px;
                object-fit: contain;
            }

        .crl-logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

            .crl-logo-text strong {
                color: #fff;
                font-size: 1.3rem;
                font-weight: 800;
                letter-spacing: .02em;
            }

            .crl-logo-text small {
                color: rgba(255, 255, 255, .55);
                font-size: .72rem;
            }

        /* Menu search */
        .crl-menusearch {
            position: relative;
            margin: .25rem 14px .5rem;
        }

            .crl-menusearch i {
                position: absolute;
                left: .8rem;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255, 255, 255, .55);
                pointer-events: none;
            }

            .crl-menusearch input {
                width: 100%;
                padding: .5rem .8rem .5rem 2.2rem;
                border-radius: .7rem;
                border: 1px solid rgba(255, 255, 255, .14);
                background: rgba(255, 255, 255, .08);
                color: #fff;
                font-size: .88rem;
            }

                .crl-menusearch input::placeholder {
                    color: rgba(255, 255, 255, .5);
                    opacity: 1;
                }

                .crl-menusearch input:focus {
                    outline: 0;
                    border-color: var(--crl-gold);
                    background: rgba(255, 255, 255, .12);
                    box-shadow: 0 0 0 3px rgba(224, 178, 90, .2);
                }

        [data-sidenav-size="condensed"] .crl-menusearch,
        [data-sidenav-size="sm-hover"] .crl-menusearch {
            display: none;
        }

        /* Titles */
        .sidenav-menu .side-nav-title {
            color: rgba(255, 255, 255, .45) !important;
            opacity: 1 !important;
            font-size: .74rem;
            letter-spacing: .04em;
            text-transform: none !important;
            padding: 1rem 1.4rem .35rem;
        }

        /* Links */
        .sidenav-menu .side-nav-link {
            position: relative;
            margin: 2px 10px;
            padding: .6rem .8rem;
            border-radius: .75rem;
            color: rgba(255, 255, 255, .78) !important;
            transition: background .15s ease, color .15s ease;
        }

            .sidenav-menu .side-nav-link i {
                color: rgba(255, 255, 255, .7) !important;
                font-size: 1.15rem;
            }

            .sidenav-menu .side-nav-link:hover {
                background: rgba(255, 255, 255, .09) !important;
                color: #fff !important;
            }

            .sidenav-menu .side-nav-link[aria-expanded="true"] {
                background: rgba(255, 255, 255, .1) !important;
                color: #fff !important;
            }

            .sidenav-menu .side-nav-link.active {
                color: #fff !important;
                background: linear-gradient(90deg, rgba(224, 178, 90, .3), rgba(255, 255, 255, .08)) !important;
                box-shadow: inset 3px 0 0 var(--crl-gold);
            }

                .sidenav-menu .side-nav-link.active i,
                .sidenav-menu .side-nav-link[aria-expanded="true"] i {
                    color: var(--crl-gold) !important;
                }

        /* Sub menus get a thin guide rail */
        .sub-menu {
            list-style: none;
            padding-left: 0;
            margin: 0;
        }

            .sub-menu li {
                list-style: none;
            }

        .sidenav-menu .sub-menu {
            background: transparent !important;
            margin: 0 0 .25rem 1.7rem;
            padding-left: .3rem;
            border-left: 1px solid rgba(255, 255, 255, .14);
        }

            .sidenav-menu .sub-menu .side-nav-link {
                font-size: .88rem;
                padding: .5rem .8rem .5rem .9rem;
                color: rgba(255, 255, 255, .72) !important;
            }

                .sidenav-menu .sub-menu .side-nav-link.active {
                    color: #fff !important;
                    font-weight: 600;
                }

        /* Help box */
        .sidenav-menu .help-box {
            margin: 1.1rem 12px;
            padding: 1.1rem 1rem;
            border-radius: 1rem;
            background: linear-gradient(135deg, rgba(255, 255, 255, .15), rgba(255, 255, 255, .04)) !important;
            border: 1px solid rgba(255, 255, 255, .14);
        }

            .sidenav-menu .help-box h5,
            .sidenav-menu .help-box p {
                color: #fff !important;
            }

            .sidenav-menu .help-box p {
                opacity: .75;
                font-size: .85rem;
            }

            .sidenav-menu .help-box .btn {
                background: #fff !important;
                border-color: #fff !important;
                color: var(--crl-brand) !important;
                border-radius: 999px;
                font-weight: 600;
                padding-left: 1rem;
                padding-right: 1rem;
            }

        .crl-help-ico {
            width: 42px;
            height: 42px;
            margin: 0 auto .6rem;
            display: grid;
            place-items: center;
            border-radius: 50%;
            font-size: 1.3rem;
            color: var(--crl-gold);
            background: rgba(224, 178, 90, .16);
        }

        /* ===== Topbar ===== */
        .app-topbar {
            background: var(--crl-glass) !important;
            -webkit-backdrop-filter: saturate(160%) blur(12px);
            backdrop-filter: saturate(160%) blur(12px);
            border-bottom: 1px solid var(--crl-line) !important;
            box-shadow: 0 8px 24px -20px rgba(58, 10, 21, .5);
        }

            .app-topbar .topbar-link {
                color: var(--crl-text) !important;
                border-radius: .7rem;
            }

                .app-topbar .topbar-link:hover {
                    background-color: rgba(125, 29, 49, .08) !important;
                    color: var(--crl-brand) !important;
                }

            .app-topbar .sidenav-toggle-button i,
            .app-topbar .topnav-toggle-button i {
                color: var(--crl-brand-mid) !important;
            }

        .crl-pagehead {
            display: flex;
            flex-direction: column;
            justify-content: center;
            line-height: 1.2;
            margin-left: .5rem;
            padding-left: 1rem;
            border-left: 1px solid var(--crl-line);
        }

        .crl-greet {
            font-size: .78rem;
            color: var(--crl-muted);
        }

        .crl-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--crl-text);
        }

        .crl-clock {
            align-items: center;
            gap: .45rem;
            padding: .4rem .85rem;
            border-radius: 999px;
            font-size: .85rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            color: var(--crl-brand-mid);
            background: rgba(125, 29, 49, .08);
        }

        .crl-user {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .crl-avatar {
            flex: 0 0 auto;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            font-size: .9rem;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--crl-brand-mid), var(--crl-brand));
            box-shadow: 0 0 0 2px var(--crl-surface), 0 0 0 4px rgba(224, 178, 90, .6);
        }

        .app-topbar .nav-user h5 {
            color: var(--crl-text) !important;
            font-size: .92rem;
        }

        .app-topbar .nav-user small {
            color: var(--crl-muted) !important;
        }

        .crl-usermenu {
            min-width: 270px;
            padding: .5rem;
            border: 1px solid var(--crl-line);
            border-radius: 1rem;
            box-shadow: 0 20px 40px -20px rgba(58, 10, 21, .45);
        }

        .crl-usercard {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin-bottom: .4rem;
            padding: .8rem;
            border-radius: .8rem;
            background: linear-gradient(135deg, rgba(125, 29, 49, .1), rgba(224, 178, 90, .12));
        }

            .crl-usercard .crl-avatar {
                width: 46px;
                height: 46px;
                font-size: 1.05rem;
            }

            .crl-usercard strong {
                display: block;
                color: var(--crl-text);
            }

            .crl-usercard small {
                display: block;
                color: var(--crl-muted);
                line-height: 1.35;
                word-break: break-all;
            }

        .crl-usermenu .dropdown-item {
            border-radius: .6rem;
            padding: .55rem .75rem;
        }

            .crl-usermenu .dropdown-item.active {
                background: rgba(214, 56, 74, .1) !important;
            }

        /* ===== Page content ===== */
        .page-content {
            background: radial-gradient(900px 320px at 95% -5%, rgba(125, 29, 49, .08), transparent 65%), radial-gradient(700px 300px at 0% 100%, rgba(224, 178, 90, .08), transparent 60%), var(--crl-bg) !important;
        }

            .page-content .page-container {
                background-color: transparent !important;
                padding: 24px 20px !important;
            }

        .footer {
            background: transparent !important;
            border-top: 1px solid var(--crl-line) !important;
            color: var(--crl-muted) !important;
            font-size: .85rem;
        }

        /* ===== Cards ===== */
        .card {
            background-color: var(--crl-surface);
            border: 1px solid var(--crl-line) !important;
            border-radius: 1rem;
            box-shadow: 0 12px 30px -24px rgba(58, 10, 21, .55);
        }

        .card-header {
            background: linear-gradient(90deg, rgba(125, 29, 49, .08), transparent 70%) !important;
            border-bottom: 1px solid var(--crl-line) !important;
            border-top-left-radius: 1rem !important;
            border-top-right-radius: 1rem !important;
            color: var(--crl-brand) !important;
        }

            .card-header h4,
            .card-header h5,
            .card-header .card-title {
                color: var(--crl-brand) !important;
                font-weight: 700;
            }

        [data-bs-theme="dark"] .card-header h4,
        [data-bs-theme="dark"] .card-header h5,
        [data-bs-theme="dark"] .card-header .card-title {
            color: #f3b7c1 !important;
        }

        .card-body {
            background-color: transparent !important;
            color: var(--crl-text);
        }

        .card-footer {
            background-color: transparent !important;
            border-top: 1px solid var(--crl-line) !important;
        }

        /* ===== Buttons ===== */
        .bg-primary,
        .btn-primary {
            background: linear-gradient(135deg, var(--crl-brand-mid), var(--crl-brand)) !important;
            border-color: var(--crl-brand) !important;
            color: #ffffff !important;
        }

        .btn-primary {
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .btn-primary:hover,
            .btn-primary:focus,
            .btn-primary:active {
                background: linear-gradient(135deg, var(--crl-brand), var(--crl-brand-deep)) !important;
                border-color: var(--crl-brand-deep) !important;
                transform: translateY(-1px);
                box-shadow: 0 10px 18px -10px rgba(89, 17, 32, .7);
            }

        .text-primary {
            color: var(--crl-brand) !important;
        }

        [data-bs-theme="dark"] .text-primary {
            color: #f3b7c1 !important;
        }

        /* ===== Form fields ===== */
        .form-control,
        .form-select {
            border-color: var(--crl-line);
            border-radius: .6rem;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--crl-brand) !important;
                box-shadow: 0 0 0 .2rem rgba(89, 17, 32, .2) !important;
                outline: none;
            }

            .form-control::selection,
            .form-select::selection,
            textarea::selection,
            input::selection {
                background-color: var(--crl-brand);
                color: #ffffff;
            }

            .form-control::placeholder {
                color: #b98a92;
                opacity: .8;
            }

        /* Dropdowns and modals share the softer shape */
        .dropdown-menu {
            border-radius: .9rem;
        }

        .modal-content {
            border-radius: 1rem;
        }

        @@media (prefers-reduced-motion: reduce) {
            .color-line {
                animation: none;
            }

            .btn-primary, .sidenav-menu .side-nav-link {
                transition: none;
            }
        }
    </style>

    <!-- Theme Config Js -->
    <script src="~/assets/js/config.js"></script>
</head>
<body>
    <!-- Begin page -->
    <div class="wrapper">

        <!-- Sidenav Menu Start -->
        <div class="sidenav-menu">
            <a href="" class="logo crl-logo">
                <span class="crl-logo-tile">
                    <img src="~/assets/Vallibel-Small-logo.png" alt="logo">
                </span>
                <span class="logo-lg crl-logo-text">
                    <strong>CRMS</strong>
                    <small>Change Request Management System</small>
                </span>
            </a>

            <div data-simplebar>

                <!-- Quick menu search -->
                <div class="crl-menusearch">
                    <i class="ri-search-line"></i>
                    <input type="search" id="crl-menu-filter" placeholder="Search menu..." autocomplete="off" aria-label="Search menu">
                </div>

                <ul class="side-nav" id="side-menu">

                    @foreach (var categoryGroup in mainMenus
                                        .GroupBy(m => m.CategoryName)
                                        .OrderBy(g => g.Key))
                    {
                        <li class="side-nav-title side-nav-title-sm fw-bold mt-2">
                            @(string.IsNullOrWhiteSpace(categoryGroup.Key) ? "Menu" : categoryGroup.Key)
                        </li>

                        @foreach (var mainMenu in categoryGroup.OrderBy(m => m.DisplayOrder))
                        {
                            var level1Menus = menus
                            .Where(m => m.ParentMenuItemId == mainMenu.Id && m.IsActive)
                            .OrderBy(m => m.DisplayOrder)
                            .ToList();

                            var mainCollapseId = $"sidebar_{mainMenu.Id}";

                            bool isMainActive = matches(mainMenu.PageUrl) || level1Menus.Any(l1 =>
                            matches(l1.PageUrl) || menus.Any(l2 => l2.ParentMenuItemId == l1.Id && l2.IsActive && matches(l2.PageUrl)));

                            @if (level1Menus.Any())
                            {
                                <li class="side-nav-item">
                                    <a data-bs-toggle="collapse" href="#@mainCollapseId"
                                       aria-expanded="@(isMainActive.ToString().ToLower())"
                                       aria-controls="@mainCollapseId"
                                       class="side-nav-link @(isMainActive ? "" : "collapsed")">
                                        <i class="@(string.IsNullOrWhiteSpace(mainMenu.IconClass) ? "ri-asterisk" : mainMenu.IconClass)"></i>
                                        <span class="menu-text"> @mainMenu.MenuTitle </span>
                                        <span class="menu-arrow"></span>
                                    </a>
                                    <div class="collapse @(isMainActive ? "show" : "")" id="@mainCollapseId">
                                        <ul class="sub-menu">

                                            @foreach (var level1 in level1Menus)
                                            {
                                                var level2Menus = menus
                                                .Where(m => m.ParentMenuItemId == level1.Id && m.IsActive)
                                                .OrderBy(m => m.DisplayOrder)
                                                .ToList();

                                                var level1CollapseId = $"sidebar_{level1.Id}";

                                                bool isLevel1Active = matches(level1.PageUrl) || level2Menus.Any(l2 => matches(l2.PageUrl));

                                                <li class="side-nav-item">
                                                    @if (level2Menus.Any())
                                                    {
                                                        <a data-bs-toggle="collapse" href="#@level1CollapseId"
                                                           aria-expanded="@(isLevel1Active.ToString().ToLower())"
                                                           aria-controls="@level1CollapseId"
                                                           class="side-nav-link @(isLevel1Active ? "" : "collapsed")">
                                                            <span class="menu-text"> @level1.MenuTitle </span>
                                                            <span class="menu-arrow"></span>
                                                        </a>
                                                        <div class="collapse @(isLevel1Active ? "show" : "")" id="@level1CollapseId">
                                                            <ul class="sub-menu">

                                                                @foreach (var level2 in level2Menus)
                                                                {
                                                                    bool isLevel2Active = matches(level2.PageUrl);

                                                                    <li class="side-nav-item">
                                                                        <a href="@Url.Content("~/" + level2.PageUrl)"
                                                                           class="side-nav-link @(isLevel2Active ? "active" : "")">
                                                                            <span class="menu-text">@level2.MenuTitle</span>
                                                                        </a>
                                                                    </li>
                                                                }

                                                            </ul>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        bool isLevel1DirectActive = matches(level1.PageUrl);

                                                        <a href="@Url.Content("~/" + level1.PageUrl)"
                                                           class="side-nav-link @(isLevel1DirectActive ? "active" : "")">
                                                            <span class="menu-text">@level1.MenuTitle</span>
                                                        </a>
                                                    }
                                                </li>
                                            }

                                        </ul>
                                    </div>
                                </li>
                            }
                            else if (!string.IsNullOrWhiteSpace(mainMenu.PageUrl))
                            {
                                bool isDirectMainActive = matches(mainMenu.PageUrl);

                                <li class="side-nav-item">
                                    <a href="@Url.Content("~/" + mainMenu.PageUrl)"
                                       class="side-nav-link @(isDirectMainActive ? "active" : "")">
                                        <i class="@(string.IsNullOrWhiteSpace(mainMenu.IconClass) ? "ri-asterisk" : mainMenu.IconClass)"></i>
