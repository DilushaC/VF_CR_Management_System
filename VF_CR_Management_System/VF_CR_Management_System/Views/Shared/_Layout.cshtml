                    <div class="btn-group radio" role="group">
                        <input type="radio" class="btn-check" name="data-layout-position" id="layout-position-fixed" value="fixed">
                        <label class="btn btn-sm btn-soft-primary w-sm" for="layout-position-fixed">Fixed</label>

                        <input type="radio" class="btn-check" name="data-layout-position" id="layout-position-scrollable" value="scrollable">
                        <label class="btn btn-sm btn-soft-primary w-sm ms-0" for="layout-position-scrollable">Scrollable</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 px-3 py-2 offcanvas-header border-top border-dashed">
            <button type="button" class="btn w-100 btn-soft-danger" id="reset-layout">Reset</button>
        </div>

    </div>

    <!-- Vendor js (jQuery, Bootstrap, SimpleBar, etc. are bundled inside) -->
    <script src="~/assets/js/vendor.min.js"></script>

    <!-- App js (theme behavior: sidenav toggle, dark mode, offcanvas settings, etc.) -->
    <script src="~/assets/js/app.js"></script>

    <!-- Apex Chart js -->
    <script src="~/assets/vendor/apexcharts/apexcharts.min.js"></script>

    <!-- Sweet Alerts js -->
    <script src="~/assets/vendor/sweetalert2/sweetalert2.min.js"></script>

    @* 
    <!-- Project site js -->
    <script src="~/js/site.js" asp-append-version="true"></script> *@

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Layout behaviours: greeting + clock, menu search, navigation progress line -->
    <script>
        (function () {
            // ----- Greeting and clock -----
            var greetEl = document.getElementById('crl-greet');
            var dateEl = document.getElementById('crl-date');
            var timeEl = document.getElementById('crl-time');
            var firstName = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(firstName))';

            function tick() {
                var now = new Date();
                var h = now.getHours();
                var part = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
                if (greetEl) { greetEl.textContent = part + ', ' + firstName; }
                if (dateEl) { dateEl.textContent = now.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' }); }
                if (timeEl) { timeEl.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }
            }
            tick();
            setInterval(tick, 30000);

            // ----- Sidebar menu search -----
            var input = document.getElementById('crl-menu-filter');
            var menu = document.getElementById('side-menu');

            if (input && menu) {
                var collapses = [].slice.call(menu.querySelectorAll('.collapse'));
                var original = null;

                function toggleFor(collapse) {
                    return menu.querySelector('[href="#' + collapse.id + '"]');
                }

                function setOpen(collapse, open) {
                    collapse.classList.toggle('show', open);
                    var t = toggleFor(collapse);
                    if (t) {
                        t.classList.toggle('collapsed', !open);
                        t.setAttribute('aria-expanded', open ? 'true' : 'false');
                    }
                }

                function visible(li, q) {
                    var link = li.querySelector(':scope > a');
                    var own = !!link && link.textContent.toLowerCase().indexOf(q) > -1;
                    var subs = [].slice.call(li.querySelectorAll(':scope > .collapse > .sub-menu > li'));
                    var any = false;

                    subs.forEach(function (s) { if (visible(s, q)) { any = true; } });

                    // A matching parent shows all of its children
                    if (own && !any) { subs.forEach(function (s) { s.style.display = ''; }); }

                    var collapse = li.querySelector(':scope > .collapse');
                    if (collapse && (own || any)) { setOpen(collapse, true); }

                    li.style.display = (own || any) ? '' : 'none';
                    return own || any;
                }

                input.addEventListener('input', function () {
                    var q = input.value.trim().toLowerCase();

                    if (original === null) {
                        original = collapses.map(function (c) { return c.classList.contains('show'); });
                    }

                    var kids = [].slice.call(menu.children);

                    if (!q) {
                        menu.querySelectorAll('li').forEach(function (li) { li.style.display = ''; });
                        collapses.forEach(function (c, i) { setOpen(c, original[i]); });
                        original = null;
                        return;
                    }

                    var title = null;
                    var titleHasItem = false;

                    kids.forEach(function (li) {
                        if (li.classList.contains('side-nav-title')) {
                            if (title) { title.style.display = titleHasItem ? '' : 'none'; }
                            title = li;
                            titleHasItem = false;
                        } else if (li.classList.contains('side-nav-item')) {
                            if (visible(li, q)) { titleHasItem = true; }
                        }
                    });
                    if (title) { title.style.display = titleHasItem ? '' : 'none'; }
                });
            }

            // ----- Speed up the top line while navigating to another page -----
            var line = document.getElementById('crl-line');
            if (line) {
                document.addEventListener('click', function (e) {
                    var a = e.target.closest ? e.target.closest('a[href]') : null;
                    if (!a || a.target === '_blank' || a.hasAttribute('download')) { return; }
                    var href = a.getAttribute('href') || '';
                    if (href.charAt(0) === '#' || href.indexOf('javascript:') === 0 || a.origin !== location.origin) { return; }
                    line.classList.add('is-loading');
                });
                window.addEventListener('pageshow', function () { line.classList.remove('is-loading'); });
            }
        })();
    </script>
</body>
</html>
