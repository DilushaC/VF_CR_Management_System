    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model VF_CR_Management_System.Data.Models.UserModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRMS</title>

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/Vallibel-logo.ico">

    <!-- Vendor css -->
    <link href="~/assets/css/vendor.min.css" rel="stylesheet" type="text/css" />
    <!-- App css -->
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />
    <!-- Icons css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- Theme Config Js -->
    <script src="~/assets/js/config.js"></script>

    <style>
        body {
            margin: 0;
            background-image: url('@Url.Content("~/assets/Background.jpg")');
            background-size: 110% 110%;
            background-position: center center;
            background-repeat: no-repeat;
            min-height: 100vh;
            transition: background-position 0.2s ease-out;
            overflow-x: hidden;
        }

        .auth-bg {
            background: transparent;
        }

        /* Two-column layout: card on the left, clipart space on the right */
        .login-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .login-left {
            flex: 0 0 45%;
            max-width: 45%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

            .login-right img {
                max-width: 100%;
                max-height: 80vh;
                object-fit: contain;
            }

        @@media (max-width: 991px) {
            .login-wrapper {
                flex-direction: column;
            }

            .login-left,
            .login-right {
                flex: 1 1 auto;
                max-width: 100%;
                width: 100%;
            }

            .login-right {
                display: none; /* hide clipart on small screens so the form stays front and center */
            }
        }

        .card {
            position: relative;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(92, 21, 38, 0.25) 50%, rgba(120, 30, 55, 0.15) 100%);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.5), inset 0 0 60px rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            width: 100%;
            overflow: hidden;
        }

            .card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 50%;
                background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
                pointer-events: none;
                z-index: 0;
            }

            .card::after {
                content: "";
                position: absolute;
                top: -50%;
                left: -20%;
                width: 60%;
                height: 100%;
                background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
                pointer-events: none;
                z-index: 0;
                transform: rotate(-15deg);
            }

            .card > * {
                position: relative;
                z-index: 1;
            }

        .card h4,
        .card p,
        .card .form-label {
            color: #f2d9df;
        }

        .system-name {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #ffffff;
            text-shadow: 0 2px 12px rgba(139, 0, 40, 0.6);
            margin-bottom: 0.5rem;
        }

        .form-control {
            background-color: #4a1020;
            border: 1px solid #8a2a44;
            color: #f2d9df;
        }

            .form-control:focus {
                background-color: #4a1020;
                border-color: #c85070;
                box-shadow: 0 0 0 0.2rem rgba(200, 80, 112, 0.35);
                color: #ffffff;
            }

            .form-control::placeholder {
                color: #c090a0;
            }

        .btn-primary {
            background-color: #a8203f;
            border-color: #a8203f;
            font-weight: 600;
        }

            .btn-primary:hover,
            .btn-primary:active {
                background-color: #c02a4d;
                border-color: #c02a4d;
            }

        .card p.mt-auto span {
            color: #e0b0be;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">

        <!-- Left side: login card -->
        <div class="login-left">
            <div class="row g-0 justify-content-center w-100">
                <div class="col-xl-9 col-lg-10 col-md-10">
                    <div class="card overflow-hidden text-center h-100 p-xxl-4 p-3 mb-0">

                        <a href="" class="auth-brand mb-4">
                            <img src="~/assets/Vallibel_Finance_logo.jpg" alt="logo" style="height:80px;" class="logo-dark">
                        </a>

                        <h1 class="system-name">CR Management System</h1>

                        <form class="text-start mb-3"
                              asp-action="Login"
                              asp-controller="User"
                              method="post"
                              id="loginForm">

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">User Name</label>
                                <input asp-for="UserName"
                                       class="form-control"
                                       placeholder="Enter your Employee Number"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Password</label>
                                <div class="input-group input-group-merge">
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter your AD password"
                                           required />
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="button" class="btn btn-primary fw-semibold" onclick="submitLogin()">
                                    Login
                                </button>
                            </div>

                            <div class="alert alert-danger text-center mt-3" id="Error" style="display:none;"></div>

                        </form>

                        <p class="mt-auto mb-0">
                            <script>document.write(new Date().getFullYear())</script> © CRMS - By
                            <span class="fw-bold text-decoration-underline text-uppercase text-reset fs-12">Vallibel Finance IT</span>
                        </p>

                    </div>
                </div>
            </div>
        </div>

@*         <!-- Right side: clipart -->
        <div class="login-right">
            <img src="~/assets/D2.png" alt="Login illustration" />
        </div> *@

    </div>

    <!-- bundle -->
    <link rel="stylesheet" href="~/assets/vendor/sweetalert2/sweetalert2.min.css">
    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <script src="~/assets/vendor/sweetalert2/sweetalert2.min.js"></script>
    <script type="text/javascript">

        (function () {
            const body = document.body;
            const strength = 6; // higher = more jiggle, lower = more subtle

            document.addEventListener('mousemove', function (e) {
                const xRatio = (e.clientX / window.innerWidth) - 0.5;   // -0.5 to 0.5
                const yRatio = (e.clientY / window.innerHeight) - 0.5;  // -0.5 to 0.5

                const offsetX = 50 - (xRatio * strength);
                const offsetY = 50 - (yRatio * strength);

                body.style.backgroundPosition = offsetX + '% ' + offsetY + '%';
            });
        })();

        $(document).on('keypress', '#loginForm input', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                submitLogin();
            }
        });

        $("#Error").hide();

        function submitLogin() {
            var form = $("#loginForm");

            $.ajax({
                url: "/User/Login",
                type: "POST",
                data: form.serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },

                beforeSend: function () {
                    Swal.fire({
                        title: "Please wait...",
                        text: "Checking credentials",
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },

                success: function (response) {
                    Swal.close();

                    console.log(response.pageUrls);

                    if (response.success) {
                        let username = response.loggedUser;

                        Swal.fire({
                            title: 'Login Success!',
                            text: "Welcome back " + username,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });

                    } else if (response.redirectUrl != null) {
                        window.location.href = response.redirectUrl;

                    } else {
                        Swal.fire({
                            title: "Login Failed!",
                            text: response.message,
                            icon: "error"
                        });
                    }
                },

                error: function (xhr, status, error) {
                    Swal.close();
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Something went wrong! Please try again.'
                    });
                }
            });
        }

    </script>
</body>
</html>
