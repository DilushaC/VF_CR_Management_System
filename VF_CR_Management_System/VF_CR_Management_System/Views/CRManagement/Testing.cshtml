@using VF_CR_Management_System.Data.Models
@model VF_CR_Management_System.Data.Models.ChangeRequest
@{
    ViewData["Title"] = "CR Assesment - Testing";
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");

    var latestTest = Model.Tests?
        .Where(t => t.Active)
        .OrderByDescending(t => t.TestCycleNumber)
        .FirstOrDefault();

    // UAT link uploaded by the developer (read-only here)
    var uatLink = latestTest?.UATLink?.Trim() ?? string.Empty;

    // ===== Attachments grouped by type =====
    var rawAttachments = ((IEnumerable<object>?)ViewBag.Attachments)?.ToList() ?? new List<object>();

    // Reads AttachmentTypeName from whatever object type the controller put in ViewBag.Attachments
    string AttachmentType(object a) =>
        (a.GetType().GetProperty("AttachmentTypeName")?.GetValue(a) as string ?? string.Empty).Trim();

    var srsFiles = rawAttachments
        .Where(a => string.Equals(AttachmentType(a), "SRS", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var baFiles = rawAttachments
        .Where(a => string.Equals(AttachmentType(a), "BA", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Vendor Report files (also catches older uploads that have no type recorded)
    var vendorFiles = rawAttachments
        .Where(a =>
        {
            var t = AttachmentType(a);
            return t.Length == 0 || string.Equals(t, "Vendor Report", StringComparison.OrdinalIgnoreCase);
        })
        .ToList();

    // Test result files uploaded by the tester (shown under the Test Plan uploader)
    var testResultFiles = rawAttachments
        .Where(a => string.Equals(AttachmentType(a), "QA Report", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Any other type, so nothing is hidden
    var otherFiles = rawAttachments
        .Except(srsFiles)
        .Except(baFiles)
        .Except(vendorFiles)
        .Except(testResultFiles)
        .ToList();

    var hasAnyAttachments = rawAttachments.Any();

    // ===== User display helpers (full name - UserName), same logic as the details popup =====
    string Normalize(string? u)
    {
        u = (u ?? string.Empty).Trim();
        var slash = u.LastIndexOf('\\');
        return slash >= 0 ? u.Substring(slash + 1) : u;
    }

    // "6407 - John Smith" -> "6407"
    string EmpNoOf(string? v)
    {
        var x = Normalize(v);
        var i = x.IndexOf(" - ", StringComparison.Ordinal);
        return (i >= 0 ? x.Substring(0, i) : x).Trim();
    }

    var userLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var nameLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    if (ViewBag.Users != null)
    {
        foreach (var u in ViewBag.Users)
        {
            string un = u.UserName;
            if (string.IsNullOrWhiteSpace(un)) { continue; }
            un = un.Trim();
            string fullName = ((string)u.FirstName + " " + (string)u.LastName).Trim();
            var display = fullName.Length > 0 ? $"{fullName} - {un}" : un;
            userLookup[un] = display;
            if (fullName.Length > 0) { nameLookup[fullName] = display; }
        }
    }

    string DisplayUser(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return string.Empty; }
        var raw = Normalize(v);

        if (userLookup.TryGetValue(EmpNoOf(raw), out var d)) { return d; }

        if (nameLookup.TryGetValue(raw, out d)) { return d; }

        var i = raw.IndexOf(" - ", StringComparison.Ordinal);
        if (i > 0 && raw.Substring(0, i).Trim().All(char.IsDigit))
        {
            return $"{raw.Substring(i + 3).Trim()} - {raw.Substring(0, i).Trim()}";
        }

        return raw;
    }

    string StepKey(string? s) => (s ?? string.Empty).Replace(" ", string.Empty);

    // Developer = AssignedTo of the FIRST "Developer Documentation" row (matched by step NAME).
    // Falls back to AssessmentUserName when the step rows are not loaded.
    var developerUser = (Model.StepAssignments ?? new List<WorkflowStepAssignment>())
        .Where(s => string.Equals(StepKey(s.StepName), StepKey("Developer Documentation"), StringComparison.OrdinalIgnoreCase))
        .Select(s => s.AssignedTo)
        .FirstOrDefault();

    if (string.IsNullOrWhiteSpace(developerUser))
    {
        developerUser = Model.AssessmentUserName;
    }

    var hasAssignedUsers = new[]
    {
        Model.RequestedBy,
        Model.ApproverUserName,
        developerUser,
        Model.SecurityUserName,
        Model.TestingUserName,
        Model.FinalApproverUserName,
        Model.TesterUserName,
        Model.TestingApproverUserName
    }.Any(u => !string.IsNullOrWhiteSpace(u));

    // ===== Visual helpers (purely cosmetic, no logic changes) =====
    string PriorityTone(string? p)
    {
        var v = (p ?? string.Empty).Trim().ToLowerInvariant();
        if (v.Contains("high") || v.Contains("urgent") || v.Contains("critical")) return "bad";
        if (v.Contains("medium")) return "warn";
        if (v.Contains("low")) return "ok";
        return "muted";
    }

    string StatusTone(string? s)
    {
        var v = (s ?? string.Empty).Trim().ToLowerInvariant();
        if (v.Contains("pass") || v.Contains("approved") || v.Contains("complete")) return "ok";
        if (v.Contains("fail") || v.Contains("reject") || v.Contains("return")) return "bad";
        if (v.Contains("test") || v.Contains("progress") || v.Contains("pending")) return "info";
        return "muted";
    }

    string Initials(string? displayName)
    {
        if (string.IsNullOrWhiteSpace(displayName)) return "?";
        var namePart = displayName.Split(" - ")[0].Trim();
        var parts = namePart.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string FileIconClass(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName)?.ToLower() ?? "";
        return ext switch
        {
            ".pdf" => "ri-file-pdf-2-line ctst-file-ic-pdf",
            ".doc" or ".docx" => "ri-file-word-2-line ctst-file-ic-word",
            ".xls" or ".xlsx" or ".csv" => "ri-file-excel-2-line ctst-file-ic-excel",
            ".zip" => "ri-file-zip-line ctst-file-ic-zip",
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" => "ri-image-2-line ctst-file-ic-image",
            _ => "ri-file-3-line ctst-file-ic-default"
        };
    }
}

<style>
    .ctst-page {
        --ctst-accent: rgb(89, 17, 32);
        --ctst-accent-soft: rgba(89, 17, 32, .1);
        --ctst-progress: #3b5bdb;
        --ctst-ok: #1f9d6b;
        --ctst-line: var(--bs-border-color, #e3e6ec);
        --ctst-muted: var(--bs-secondary-color, #6b7385);
        --ctst-card: var(--bs-card-bg, var(--bs-body-bg, #fff));
    }

        .ctst-page .tone-ok {
            --t: #1f9d6b;
            --t-bg: rgba(31,157,107,.14);
        }

        .ctst-page .tone-warn {
            --t: #b57600;
            --t-bg: rgba(255,176,32,.2);
        }

        .ctst-page .tone-bad {
            --t: #d6384a;
            --t-bg: rgba(255,93,108,.16);
        }

        .ctst-page .tone-info {
            --t: #4a63d6;
            --t-bg: rgba(59,91,219,.13);
        }

        .ctst-page .tone-muted {
            --t: #6b7385;
            --t-bg: #eef0f6;
        }

    /* ===== Hero ===== */
    .ctst-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 1.25rem;
        padding: 1.5rem 1.75rem;
        border-radius: .9rem;
        color: #fff;
        background: #451423;
    }

        .ctst-hero::after {
            content: "";
            position: absolute;
            right: -60px;
            top: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,.05);
            pointer-events: none;
        }

    .ctst-hero-row {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ctst-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: .5rem;
        padding: .25rem .7rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        background: rgba(255,255,255,.12);
    }

    .ctst-hero h3 {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .ctst-hero p {
        margin: .25rem 0 0;
        color: rgba(255,255,255,.7);
        font-size: .92rem;
    }

    .ctst-hero-badges {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin-top: .6rem;
    }

    .ctst-back {
        color: rgba(255,255,255,.85);
        text-decoration: none;
        font-weight: 600;
        font-size: .9rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .9rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.3);
    }

        .ctst-back:hover {
            background: rgba(255,255,255,.12);
            color: #fff;
        }

    /* ===== Layout ===== */
    .ctst-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 1.25rem;
        align-items: start;
    }

    .ctst-aside {
        position: sticky;
        top: 90px;
        display: grid;
        gap: 1rem;
    }

    @@media (max-width: 991px) {
        .ctst-grid {
            grid-template-columns: 1fr;
        }

        .ctst-aside {
            position: static;
        }
    }

    /* ===== Section cards ===== */
    .ctst-sec {
        margin-bottom: 1.1rem;
        border: 1px solid var(--ctst-line);
        border-radius: .9rem;
        background: var(--ctst-card);
        animation: ctst-rise .4s ease-out backwards;
    }

        .ctst-sec:nth-of-type(1) {
            animation-delay: .00s;
        }

        .ctst-sec:nth-of-type(2) {
            animation-delay: .06s;
        }

        .ctst-sec:nth-of-type(3) {
            animation-delay: .12s;
        }

        .ctst-sec:nth-of-type(4) {
            animation-delay: .18s;
        }

        .ctst-sec:nth-of-type(5) {
            animation-delay: .24s;
        }

    @@keyframes ctst-rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    .ctst-sec-head {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--ctst-line);
    }

    .ctst-step {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-weight: 700;
        font-size: .9rem;
        color: var(--ctst-accent);
        background: var(--ctst-accent-soft);
    }

    .ctst-sec-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 700;
    }

    .ctst-sec-sub {
        margin: 0;
        font-size: .83rem;
        color: var(--ctst-muted);
    }

    .ctst-sec-body {
        padding: 1.25rem;
    }

    /* ===== Tester strip ===== */
    .ctst-who {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .ctst-avatar {
        flex: 0 0 auto;
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
        background: var(--ctst-accent);
    }

    .ctst-who-name {
        font-weight: 700;
        font-size: 1.05rem;
    }

    .ctst-who-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem 1.25rem;
        margin-top: .15rem;
        font-size: .85rem;
        color: var(--ctst-muted);
    }

        .ctst-who-meta span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

        .ctst-who-meta i {
            color: var(--ctst-accent);
        }

    /* ===== Inputs ===== */
    .ctst-label {
        font-weight: 600;
        margin-bottom: .35rem;
        display: block;
    }

    .ctst-label-sm {
        font-weight: 700;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--ctst-muted);
        display: block;
        margin-bottom: .5rem;
    }

    .ctst-page .form-control,
    .ctst-page .form-select {
        border-radius: .6rem;
    }

        .ctst-page .form-control:focus,
        .ctst-page .form-select:focus {
            border-color: var(--ctst-accent) !important;
            box-shadow: 0 0 0 3px var(--ctst-accent-soft) !important;
        }

        .ctst-page .form-control.is-invalid {
            border-color: #d6384a !important;
        }

            .ctst-page .form-control.is-invalid:focus {
                box-shadow: 0 0 0 3px rgba(214,56,74,.15) !important;
            }

    .ctst-counter {
        display: flex;
        justify-content: flex-end;
        margin-top: .35rem;
        font-size: .8rem;
        color: var(--ctst-muted);
    }

    /* ===== Inline field errors ===== */
    .ctst-field-error {
        display: none;
        align-items: center;
        gap: .35rem;
        margin-top: .35rem;
        font-size: .8rem;
        font-weight: 500;
        color: #d6384a;
    }

        .ctst-field-error.is-visible {
            display: flex;
        }

        .ctst-field-error i {
            font-size: .95rem;
        }

    /* ===== Attachments ===== */
    .ctst-attgroup + .ctst-attgroup {
        margin-top: 1.1rem;
    }

    .ctst-filelist {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: .5rem;
    }

        .ctst-filelist li {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .5rem .7rem;
            border: 1px solid var(--ctst-line);
            border-radius: .6rem;
            background: var(--ctst-card);
        }

    .ctst-file-ico {
        flex: 0 0 auto;
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: .5rem;
        background: var(--ctst-accent-soft);
    }

    .ctst-file-ic-pdf {
        color: #e23744;
    }

    .ctst-file-ic-word {
        color: #2b579a;
    }

    .ctst-file-ic-excel {
        color: #1d6f42;
    }

    .ctst-file-ic-zip {
        color: #b08900;
    }

    .ctst-file-ic-image {
        color: #8a4fff;
    }

    .ctst-file-ic-default {
        color: var(--ctst-accent);
    }

    .ctst-file-name {
        flex: 1 1 auto;
        min-width: 0;
        font-size: .88rem;
    }

        .ctst-file-name a {
            color: inherit;
            text-decoration: none;
            font-weight: 600;
            word-break: break-word;
        }

            .ctst-file-name a:hover {
                color: var(--ctst-accent);
                text-decoration: underline;
            }

    .ctst-empty {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .88rem;
        color: var(--ctst-muted);
    }

    /* ===== Assigned users ===== */
    .ctst-users {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: .5rem;
    }

    .ctst-user-row {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .5rem .6rem;
        border: 1px solid var(--ctst-line);
        border-radius: .7rem;
    }

    .ctst-user-name {
        font-size: .88rem;
        font-weight: 600;
        word-break: break-word;
    }

    /* ===== UAT link ===== */
    .ctst-uat-box {
        border: 1.5px dashed var(--ctst-line);
        background: var(--ctst-accent-soft);
        border-radius: .8rem;
        padding: .9rem 1rem;
        max-width: 560px;
    }

    /* ===== Dropzone ===== */
    .ctst-dropzone {
        border: 1.5px dashed var(--ctst-line);
        border-radius: .8rem;
        padding: 1rem;
        transition: border-color .15s ease, background .15s ease;
    }

        .ctst-dropzone:hover,
        .ctst-dropzone:focus-within {
            border-color: var(--ctst-accent);
            background: var(--ctst-accent-soft);
        }

    #selectedFilesList li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        padding: .5rem .7rem;
        border: 1px solid var(--ctst-line);
        border-radius: .6rem;
        background: var(--ctst-card);
        margin-bottom: .4rem;
        animation: ctst-rise .25s ease both;
    }

    /* ===== Pills / badges ===== */
    .ctst-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        color: var(--t, var(--ctst-accent));
        background: var(--t-bg, var(--ctst-accent-soft));
    }

    .ctst-hero .ctst-pill {
        background: rgba(255,255,255,.14);
        color: #fff;
    }

    /* ===== Aside: progress ring + checklist ===== */
    .ctst-card {
        border: 1px solid var(--ctst-line);
        border-radius: .9rem;
        background: var(--ctst-card);
        padding: 1.1rem 1.15rem;
    }

        .ctst-card h6 {
            margin: 0 0 .85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .45rem;
        }

            .ctst-card h6 i {
                color: var(--ctst-accent);
            }

    .ctst-progress {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .ctst-ring-wrap {
        position: relative;
        flex: 0 0 auto;
        width: 92px;
        height: 92px;
    }

    .ctst-ring {
        width: 100%;
        height: 100%;
    }

        .ctst-ring circle {
            fill: none;
            stroke-width: 9;
        }

        .ctst-ring .ctst-ring-bg {
            stroke: var(--ctst-line);
        }

        .ctst-ring .ctst-ring-fg {
            stroke: var(--ctst-progress);
            stroke-linecap: round;
            stroke-dasharray: 276.46;
            stroke-dashoffset: 276.46;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            transition: stroke-dashoffset .6s cubic-bezier(.3,.9,.3,1), stroke .3s;
        }

    .ctst-ring-wrap.is-full .ctst-ring-fg {
        stroke: var(--ctst-ok);
    }

    .ctst-ring-num {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 1.35rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--ctst-progress);
    }

        .ctst-ring-num small {
            font-size: .7rem;
            font-weight: 600;
            color: var(--ctst-muted);
            margin-left: 1px;
        }

    .ctst-ring-wrap.is-full .ctst-ring-num {
        color: var(--ctst-ok);
    }

    .ctst-progress-text strong {
        display: block;
        font-size: 1rem;
    }

    .ctst-progress-text span {
        font-size: .83rem;
        color: var(--ctst-muted);
    }

    .ctst-checklist {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        display: grid;
        gap: .45rem;
    }

        .ctst-checklist li {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-size: .88rem;
            color: var(--ctst-muted);
            transition: color .2s;
        }

            .ctst-checklist li i {
                width: 20px;
                height: 20px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                font-size: .8rem;
                border: 1.5px solid var(--ctst-line);
                color: transparent;
                transition: background .2s, border-color .2s, color .2s;
            }

            .ctst-checklist li.is-done {
                color: inherit;
            }

                .ctst-checklist li.is-done i {
                    background: var(--ctst-ok);
                    border-color: var(--ctst-ok);
                    color: #fff;
                }

    /* ===== Aside: request summary ===== */
    .ctst-kv {
        display: grid;
        grid-template-columns: 1fr;
        gap: .65rem;
        margin-top: .9rem;
        font-size: .86rem;
    }

    .ctst-kv-row {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        padding-bottom: .55rem;
        border-bottom: 1px dashed var(--ctst-line);
    }

        .ctst-kv-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .ctst-kv-label {
        color: var(--ctst-muted);
        flex: 0 0 auto;
    }

    .ctst-kv-val {
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .ctst-summary-text {
        margin-top: .9rem;
        padding-top: .85rem;
        border-top: 1px solid var(--ctst-line);
        font-size: .85rem;
        line-height: 1.55;
        color: var(--ctst-muted);
    }

        .ctst-summary-text + .ctst-summary-text {
            margin-top: .7rem;
            padding-top: .7rem;
        }

        .ctst-summary-text strong {
            display: block;
            color: inherit;
            font-weight: 700;
            margin-bottom: .3rem;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

    /* ===== Action bar ===== */
    .ctst-actions {
        position: sticky;
        bottom: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-top: 1.25rem;
        padding: .85rem 1.1rem;
        border: 1px solid var(--ctst-line);
        border-radius: .9rem;
        background: var(--ctst-card);
        box-shadow: 0 -6px 18px rgba(23,33,59,.08);
    }

        .ctst-actions .btn {
            border-radius: 999px;
            padding-left: 1.3rem;
            padding-right: 1.3rem;
            font-weight: 700;
            border: none;
        }

    #submitBtn {
        background: var(--ctst-accent);
        box-shadow: 0 10px 20px -10px var(--ctst-accent-soft);
        color: #fff;
    }

        #submitBtn:hover {
            background: #70121f;
        }

    #btn-fail {
        background: #d6384a;
        box-shadow: 0 10px 20px -10px rgba(214,56,74,.5);
        color: #fff;
    }

        #btn-fail:hover {
            background: #b92e3e;
        }

        #submitBtn:hover, #btn-fail:hover {
            transform: translateY(-2px);
        }

        #submitBtn:disabled, #btn-fail:disabled {
            opacity: .55;
            transform: none;
            cursor: not-allowed;
            box-shadow: none;
        }

    @@media (prefers-reduced-motion: reduce) {
        .ctst-sec {
            animation: none;
        }
    }
</style>

<div class="ctst-page">

    <div class="ctst-hero">
        <div class="ctst-hero-row">
            <div>
                <span class="ctst-hero-chip"><i class="ri-flask-line"></i>Section 3 · Testing</span>
                <h3>Testing — @Model.CRNumber</h3>
                <p>@Model.ChangeTitle</p>
                <div class="ctst-hero-badges">
                    <span class="ctst-pill"><i class="ri-git-commit-line"></i>@Model.Status</span>
                    <span class="ctst-pill"><i class="ri-flashlight-line"></i>@Model.Priority</span>
                </div>
            </div>
            <a class="ctst-back" href="@Url.Action("TestingQueueTable")"><i class="ri-arrow-left-line"></i>Back to testing queue</a>
        </div>
    </div>

    <form id="testingForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" id="crIdField" value="@Model.CRID" />

        <div class="ctst-grid">

            <!-- ============ Left: review + test execution ============ -->
            <div>

                <!-- 1. Tester -->
                <section class="ctst-sec">
                    <div class="ctst-sec-head">
                        <span class="ctst-step"><i class="ri-user-settings-line"></i></span>
                        <div>
                            <h5 class="ctst-sec-title">Tester</h5>
                            <p class="ctst-sec-sub">Filled in automatically from your profile</p>
                        </div>
                    </div>
                    <div class="ctst-sec-body">
                        <div class="ctst-who">
                            <span class="ctst-avatar">@Initials(username)</span>
                            <div>
                                <div class="ctst-who-name">@(string.IsNullOrWhiteSpace(username) ? "Unknown user" : username)</div>
                                <div class="ctst-who-meta">
                                    @if (!string.IsNullOrWhiteSpace(designation))
                                    {
                                        <span><i class="ri-briefcase-line"></i>@designation</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(department))
                                    {
                                        <span><i class="ri-building-line"></i>@department</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(email))
                                    {
                                        <span><i class="ri-mail-line"></i>@email</span>
                                    }
                                    <span><i class="ri-calendar-line"></i>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. Attachments -->
                <section class="ctst-sec">
                    <div class="ctst-sec-head">
                        <span class="ctst-step"><i class="ri-attachment-2"></i></span>
                        <div>
                            <h5 class="ctst-sec-title">Attachments</h5>
                            <p class="ctst-sec-sub">Documents submitted earlier in this change request</p>
                        </div>
                    </div>
                    <div class="ctst-sec-body">
                        @if (hasAnyAttachments)
                        {
                            RenderAttachmentGroup("SRS Document", srsFiles);
                            RenderAttachmentGroup("BA Document", baFiles);
                            RenderAttachmentGroup("Vendor Attachments", vendorFiles);
                            RenderAttachmentGroup("Other Attachments", otherFiles);
                        }
                        else
                        {
                            <p class="ctst-empty mb-0"><i class="ri-folder-open-line"></i>No attachments found.</p>
                        }
                    </div>
                </section>

                <!-- 3. Assigned users -->
                @if (hasAssignedUsers)
                {
                    <section class="ctst-sec">
                        <div class="ctst-sec-head">
                            <span class="ctst-step"><i class="ri-team-line"></i></span>
                            <div>
                                <h5 class="ctst-sec-title">Assigned users</h5>
                                <p class="ctst-sec-sub">Everyone involved in this change request so far</p>
                            </div>
                        </div>
                        <div class="ctst-sec-body">
                            <div class="ctst-users">
                                @{
                                    AssignedUserField("Requested By", DisplayUser(Model.RequestedBy));
                                    AssignedUserField("CR Approver", DisplayUser(Model.ApproverUserName));
                                    AssignedUserField("Developer", DisplayUser(developerUser));
                                    AssignedUserField("InfoSec Officer", DisplayUser(Model.SecurityUserName));
                                    AssignedUserField("QA Tester", DisplayUser(Model.TestingUserName));
                                    AssignedUserField("QA Assigned By", DisplayUser(Model.TesterUserName));
                                    AssignedUserField("QA Approved By", DisplayUser(Model.TestingApproverUserName));
                                    AssignedUserField("Final CR Approver", DisplayUser(Model.FinalApproverUserName));
                                }
                            </div>
                        </div>
                    </section>
                }

                <!-- 4. UAT link -->
                <section class="ctst-sec">
                    <div class="ctst-sec-head">
                        <span class="ctst-step"><i class="ri-link-m"></i></span>
                        <div>
                            <h5 class="ctst-sec-title">UAT link</h5>
                            <p class="ctst-sec-sub">Provided by the developer, read-only here</p>
                        </div>
                    </div>
                    <div class="ctst-sec-body">
                        @if (!string.IsNullOrWhiteSpace(uatLink))
                        {
                            <div class="ctst-uat-box">
                                <div class="input-group">
                                    <input type="text" id="uatLinkField" class="form-control text-truncate"
                                           value="@uatLink" title="@uatLink" readonly />
                                    <a href="@uatLink" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                                        <i class="ri-external-link-line me-1"></i>Open
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="ctst-empty mb-0"><i class="ri-link-unlink-m"></i>No UAT link has been provided yet.</p>
                        }
                    </div>
                </section>

                <!-- 5. Test execution -->
                <section class="ctst-sec">
                    <div class="ctst-sec-head">
                        <span class="ctst-step"><i class="ri-clipboard-line"></i></span>
                        <div>
                            <h5 class="ctst-sec-title">Test execution</h5>
                            <p class="ctst-sec-sub">Record the test plan, results and supporting evidence</p>
                        </div>
                    </div>
                    <div class="ctst-sec-body">
                        <div class="mb-3">
                            <label class="ctst-label" for="testPlanResults">Test plan &amp; results</label>
                            <textarea name="Test" id="testPlanResults" class="form-control" rows="8"
                                      placeholder="Describe the test plan and results (if the test failed, explain why):"></textarea>
                            <div class="ctst-counter"><span id="ctstWords">0 words</span></div>
                            <div class="ctst-field-error" id="err-plan"><i class="ri-error-warning-line"></i><span>Please describe the test plan and results.</span></div>
                        </div>

                        <div>
                            <label class="ctst-label" for="testResultFiles">Test results attachments</label>
                            <div class="ctst-dropzone">
                                <input type="file"
                                       id="testResultFiles"
                                       name="TestResultFiles"
                                       class="form-control"
                                       multiple
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.gif,.webp,.zip" />
                                <div class="form-text">
                                    <i class="ri-information-line me-1"></i>PDF, Word, Excel, CSV, text, images or ZIP. Max 10 MB per file, up to 10 files.
                                </div>
                            </div>

                            <!-- Newly selected files (not yet uploaded) -->
                            <ul id="selectedFilesList" class="list-unstyled mt-2 mb-0"></ul>

                            <!-- Files already uploaded for this CR -->
                            @if (testResultFiles.Any())
                            {
                                <div class="mt-3">
                                    @{
                                        RenderAttachmentGroup("Uploaded QA report files", testResultFiles);
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </div>

            <!-- ============ Right: progress + request summary ============ -->
            <aside class="ctst-aside">

                <div class="ctst-card">
                    <h6><i class="ri-checkbox-circle-line"></i>Your progress</h6>
                    <div class="ctst-progress">
                        <div class="ctst-ring-wrap" id="ctstRingWrap">
                            <svg class="ctst-ring" viewBox="0 0 100 100" aria-hidden="true">
                                <circle class="ctst-ring-bg" cx="50" cy="50" r="44"></circle>
                                <circle class="ctst-ring-fg" id="ctstRingFg" cx="50" cy="50" r="44"></circle>
                            </svg>
                            <div class="ctst-ring-num"><span><span id="ctstPct">0</span><small>%</small></span></div>
                        </div>
                        <div class="ctst-progress-text">
                            <strong id="ctstHeadline">Let's get started</strong>
                            <span id="ctstSubline">0 of 2 steps done</span>
                        </div>
                    </div>
                    <ul class="ctst-checklist" id="ctstChecklist">
                        <li data-key="plan"><i class="ri-check-line"></i>Test plan &amp; results</li>
                        <li data-key="attachments"><i class="ri-check-line"></i>Attachments added</li>
                    </ul>
                </div>

                <div class="ctst-card">
                    <h6><i class="ri-file-list-3-line"></i>Request summary</h6>
                    <span class="ctst-pill tone-@StatusTone(Model.Status)"><i class="ri-git-commit-line"></i>@Model.Status</span>
                    <span class="ctst-pill tone-@PriorityTone(Model.Priority)"><i class="ri-flashlight-line"></i>@Model.Priority</span>

                    <div class="ctst-kv">
                        <div class="ctst-kv-row"><span class="ctst-kv-label">CR Number</span><span class="ctst-kv-val">@Model.CRNumber</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Title</span><span class="ctst-kv-val">@Model.ChangeTitle</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Change type</span><span class="ctst-kv-val">@Model.ChangeType</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Division</span><span class="ctst-kv-val">@(string.IsNullOrEmpty(Model.Division) ? "—" : Model.Division)</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Module</span><span class="ctst-kv-val">@Model.Module</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Requested by</span><span class="ctst-kv-val">@Model.RequestedBy</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Requested date</span><span class="ctst-kv-val">@Model.RequestedDate.ToString("yyyy/MM/dd")</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Approver</span><span class="ctst-kv-val">@Model.ApproverUserName</span></div>
                        <div class="ctst-kv-row"><span class="ctst-kv-label">Due date</span><span class="ctst-kv-val">@(Model.DueDate.HasValue? Model.DueDate.Value.ToString("yyyy/MM/dd") : "—")</span></div>
                        @if (!string.IsNullOrWhiteSpace(Model.ProposalNumber))
                        {
                            <div class="ctst-kv-row"><span class="ctst-kv-label">Vendor proposal #</span><span class="ctst-kv-val">@Model.ProposalNumber</span></div>
                        }
                    </div>

                    <div class="ctst-summary-text">
                        <strong>Business justification</strong>
                        @Model.Summary
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ActivitiesTasks))
                    {
                        <div class="ctst-summary-text">
                            <strong>Activities &amp; tasks</strong>
                            @Model.ActivitiesTasks
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FixedAssets))
                    {
                        <div class="ctst-summary-text">
                            <strong>Fixed assets</strong>
                            @Model.FixedAssets
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.RiskAssessment))
                    {
                        <div class="ctst-summary-text">
                            <strong>Risk assessment</strong>
                            @Model.RiskAssessment
                        </div>
                    }
                </div>
            </aside>
        </div>

        <!-- Actions -->
        <div class="ctst-actions">
            <button type="button"
                    class="btn btn-outline-danger"
                    onclick="window.location.href='@Url.Action("TestingQueueTable")'">
                <i class="ri-arrow-left-line me-1"></i>Cancel
            </button>
            <div class="d-flex gap-2">
                <button type="button"
                        id="btn-fail"
                        class="btn"
                        data-status="3"
                        disabled>
                    <i class="ri-arrow-go-back-line me-1"></i>Test Failed
                </button>
                <button type="button"
                        id="submitBtn"
                        class="btn"
                        data-status="2"
                        disabled>
                    <i class="ri-check-line me-1"></i>Test Passed
                </button>
            </div>
        </div>
    </form>

    <!-- Image Preview Modal -->
    <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imagePreviewModalLabel">Attachment Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="imagePreviewSpinner" class="py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <img id="modalPreviewImage" src="" alt="" class="img-fluid d-none" />
                </div>
                <div class="modal-footer">
                    <a id="imagePreviewDownloadBtn" href="#" class="btn btn-outline-primary" download>
                        <i class="ri-download-2-line me-1"></i> Download
                    </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    // One "label: value" cell in the Assigned Users section. Nothing is rendered when the value is empty.
    void AssignedUserField(string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="ctst-user-row">
                <span class="ctst-avatar" style="width:36px;height:36px;font-size:.78rem;">@Initials(value)</span>
                <div>
                    <label class="ctst-label-sm mb-0">@label</label>
                    <div class="ctst-user-name">@value</div>
                </div>
            </div>
        }
    }

    // Renders one attachment group (heading + file list). Nothing is rendered when the group is empty.
    void RenderAttachmentGroup(string title, List<object> items)
    {
        if (items == null || items.Count == 0)
        {
            return;
        }

        <div class="ctst-attgroup">
            <label class="ctst-label-sm">@title</label>
            <ul class="ctst-filelist">
                @foreach (var item in items)
                {
                    dynamic attachment = item;
                    int attachmentId = attachment.AttachmentID;
                    string fileName = attachment.FileName;
                    string ext = System.IO.Path.GetExtension(fileName)?.ToLower() ?? "";
                    bool isImage = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" }.Contains(ext);
                    bool isPdf = ext == ".pdf";
                    string previewUrl = Url.Action("PreviewAttachment", "CRManagement", new { id = attachmentId });
                    string downloadUrl = Url.Action("DownloadAttachment", "CRManagement", new { id = attachmentId });
                    string iconClass = FileIconClass(fileName);

                    <li>
                        <span class="ctst-file-ico"><i class="@iconClass"></i></span>
                        <span class="ctst-file-name">
                            @if (isImage)
                            {
                                <a href="javascript:void(0);" class="attachment-link"
                                   data-type="image"
                                   data-preview-url="@previewUrl"
                                   data-download-url="@downloadUrl"
                                   data-name="@fileName">
                                    @fileName
                                </a>
                            }
                            else if (isPdf)
                            {
                                <a href="@previewUrl" target="_blank" rel="noopener">
                                    @fileName
                                </a>
                            }
                            else
                            {
                                <a href="@downloadUrl" download>
                                    @fileName
                                </a>
                            }
                        </span>
                    </li>
                }
            </ul>
        </div>
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ---- Image attachment preview modal ----
            var imagePreviewModalEl = document.getElementById('imagePreviewModal');
            var imagePreviewModal = new bootstrap.Modal(imagePreviewModalEl);
            var $modalImg = $('#modalPreviewImage');
            var $spinner = $('#imagePreviewSpinner');
            var $downloadBtn = $('#imagePreviewDownloadBtn');

            document.querySelectorAll('.attachment-link[data-type="image"]').forEach(function (link) {
                link.addEventListener('click', function () {
                    var previewUrl = this.getAttribute('data-preview-url');
                    var downloadUrl = this.getAttribute('data-download-url');
                    var fileName = this.getAttribute('data-name');

                    $modalImg.addClass('d-none').attr('src', '');
                    $spinner.removeClass('d-none');
                    $downloadBtn.attr('href', downloadUrl).attr('download', fileName);
                    document.getElementById('imagePreviewModalLabel').textContent = fileName || 'Attachment Preview';

                    imagePreviewModal.show();

                    var img = new Image();
                    img.onload = function () {
                        $spinner.addClass('d-none');
                        $modalImg.attr('src', previewUrl).removeClass('d-none');
                    };
                    img.onerror = function () {
                        $spinner.addClass('d-none');
                        $modalImg.removeClass('d-none').attr('alt', 'Failed to load image');
                    };
                    img.src = previewUrl;
                });
            });

            // ---- Progress ring + checklist + inline validation ----
            var RING_LEN = 276.46;
            var testPlanInput = document.getElementById('testPlanResults');
            var hasExistingQaFiles = @(testResultFiles.Any() ? "true" : "false");
            var submitBtn = document.getElementById('submitBtn');   // Test Passed
            var failBtn   = document.getElementById('btn-fail');    // Test Failed

            function showErr(key, isValid, $fieldEl) {
                var errEl = document.getElementById('err-' + key);
                if (errEl) { errEl.classList.toggle('is-visible', !isValid); }
                if ($fieldEl) { $fieldEl.classList.toggle('is-invalid', !isValid); }
            }

            function refreshProgress() {
                var plan = (testPlanInput.value || '').trim();
                var words = plan ? plan.split(/\s+/).length : 0;
                document.getElementById('ctstWords').textContent = words + (words === 1 ? ' word' : ' words');

                var planOk = plan.length > 0;
                var attachmentsOk = hasExistingQaFiles || selectedFiles.length > 0;

                var state = {
                    plan: planOk,
                    attachments: attachmentsOk
                };

                var done = 0, total = 0;
                document.querySelectorAll('#ctstChecklist li').forEach(function (li) {
                    total++;
                    var ok = !!state[li.getAttribute('data-key')];
                    li.classList.toggle('is-done', ok);
                    if (ok) { done++; }
                });

                var pct = total ? Math.round(done / total * 100) : 0;
                document.getElementById('ctstPct').textContent = pct;
                document.getElementById('ctstRingFg').style.strokeDashoffset = RING_LEN * (1 - done / total);
                document.getElementById('ctstRingWrap').classList.toggle('is-full', done === total);
                document.getElementById('ctstSubline').textContent = done + ' of ' + total + ' steps done';
                document.getElementById('ctstHeadline').textContent =
                    done === total ? 'Ready to submit' :
                    done === 0 ? "Let's get started" : 'Almost there';

                // ----- Inline field validation -----
                // Test plan & results is required for both Test Passed and Test Failed.
                showErr('plan', planOk, testPlanInput);

                submitBtn.disabled = !planOk;
                submitBtn.classList.toggle('disabled', !planOk);
                failBtn.disabled = !planOk;
                failBtn.classList.toggle('disabled', !planOk);
            }

            document.getElementById('testingForm').addEventListener('input', refreshProgress);
            document.getElementById('testingForm').addEventListener('change', refreshProgress);

            // ---- Test result attachments (select, validate, remove before upload) ----
            var MAX_FILE_BYTES = 10 * 1024 * 1024;   // 10 MB per file
            var MAX_FILES = 10;
            var ALLOWED_EXT = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.csv', '.txt',
                               '.png', '.jpg', '.jpeg', '.gif', '.webp', '.zip'];

            var fileInput = document.getElementById('testResultFiles');
            var selectedList = document.getElementById('selectedFilesList');
            var selectedFiles = [];   // File objects currently chosen

            function formatSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
            }

            function syncInputFiles() {
                // Push the filtered list back into the real <input> so FormData sends it
                var dt = new DataTransfer();
                selectedFiles.forEach(function (f) { dt.items.add(f); });
                fileInput.files = dt.files;
            }

            function renderSelectedFiles() {
                selectedList.innerHTML = '';
                selectedFiles.forEach(function (file, index) {
                    var li = document.createElement('li');

                    var label = document.createElement('span');
                    label.className = 'text-truncate me-2';
                    label.innerHTML = '<i class="ri-attachment-2 me-1"></i>';
                    label.appendChild(document.createTextNode(file.name + ' (' + formatSize(file.size) + ')'));

                    var removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-sm btn-link text-danger p-0';
                    removeBtn.title = 'Remove';
                    removeBtn.innerHTML = '<i class="ri-close-line fs-18"></i>';
                    removeBtn.addEventListener('click', function () {
                        selectedFiles.splice(index, 1);
                        syncInputFiles();
                        renderSelectedFiles();
                        refreshProgress();
                    });

                    li.appendChild(label);
                    li.appendChild(removeBtn);
                    selectedList.appendChild(li);
                });
            }

            fileInput.addEventListener('change', function () {
                var rejected = [];

                Array.prototype.forEach.call(fileInput.files, function (file) {
                    var dot = file.name.lastIndexOf('.');
                    var ext = dot >= 0 ? file.name.substring(dot).toLowerCase() : '';

                    if (ALLOWED_EXT.indexOf(ext) === -1) {
                        rejected.push(file.name + ' (file type not allowed)');
                    } else if (file.size > MAX_FILE_BYTES) {
                        rejected.push(file.name + ' (larger than 10 MB)');
                    } else if (selectedFiles.length >= MAX_FILES) {
                        rejected.push(file.name + ' (maximum ' + MAX_FILES + ' files)');
                    } else if (!selectedFiles.some(function (f) { return f.name === file.name && f.size === file.size; })) {
                        selectedFiles.push(file);
                    }
                });

                syncInputFiles();
                renderSelectedFiles();
                refreshProgress();

                if (rejected.length) {
                    Swal.fire({
                        title: 'Some files were not added',
                        html: rejected.map(function (r) {
                            var d = document.createElement('div');
                            d.textContent = r;
                            return d.outerHTML;
                        }).join(''),
                        icon: 'warning',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                }
            });

            refreshProgress();

            // ---- Test Passed / Test Failed ----
            // Per-button alert settings
            var modeConfig = {
                pass: {
                    confirm: {
                        title: 'Mark test as passed?',
                        text: 'The Change Request will move to the next stage.',
                        icon: 'question',
                        confirmButtonText: 'Yes, test passed',
                        confirmClass: 'btn btn-success me-2'
                    },
                    successTitle: 'Test Passed!',
                    successText: 'Testing results submitted successfully.',
                    requireTestPlan: true
                },
                fail: {
                    confirm: {
                        title: 'Mark test as failed?',
                        text: 'The Change Request will be returned to the developer.',
                        icon: 'warning',
                        confirmButtonText: 'Yes, return to developer',
                        confirmClass: 'btn btn-danger me-2'
                    },
                    successTitle: 'Returned to Developer',
                    successText: 'The Change Request has been returned to the developer.',
                    requireTestPlan: true
                }
            };

            function showAlert(title, text, icon) {
                Swal.fire({
                    title: title,
                    text: text,
                    icon: icon,
                    customClass: { confirmButton: 'btn btn-primary' },
                    buttonsStyling: false
                });
            }

            function handleTestingSubmission(btnElement, mode) {
                var cfg = modeConfig[mode];
                var crId = document.getElementById('crIdField').value;

                if (!crId) {
                    showAlert('Could not submit', 'Missing Change Request ID. Cannot submit the testing form.', 'error');
                    return;
                }

                // Safety net: both buttons are disabled while the test plan is empty,
                // but re-check here too in case they were re-enabled programmatically.
                refreshProgress();
                if (cfg.requireTestPlan && btnElement.disabled) {
                    return;
                }

                function performSubmission() {
                    var form = document.getElementById('testingForm');
                    var formData = new FormData(form);
                    var statusValue = btnElement.getAttribute('data-status');
                    if (statusValue) {
                        formData.append('Status', statusValue);
                    }

                    // Disable both buttons while processing
                    var allBtns = [submitBtn, failBtn];
                    allBtns.forEach(function (b) { b.disabled = true; });
                    var originalHtml = btnElement.innerHTML;
                    btnElement.textContent = 'Processing...';

                    $.ajax({
                        url: '@Url.Action("CreateTesting", "CRManagement")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (data) {
                            if (!data.success) {
                                showAlert('Could not save', data.message || 'Failed to update the testing form.', 'error');
                                return;
                            }

                            Swal.fire({
                                title: cfg.successTitle,
                                text: data.message || cfg.successText,
                                icon: 'success',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            }).then(function () {
                                if (data.redirectUrl) {
                                    window.location.href = data.redirectUrl;
                                }
                            });
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message) ||
                                      'Failed to update the testing form. Please try again.';
                            showAlert('Error', msg, 'error');
                        },
                        complete: function () {
                            btnElement.innerHTML = originalHtml;
                            // Re-apply the validation-driven disabled state rather than
                            // unconditionally re-enabling both buttons.
                            refreshProgress();
                        }
                    });
                }

                // Confirmation alert for every button
                Swal.fire({
                    title: cfg.confirm.title,
                    text: cfg.confirm.text,
                    icon: cfg.confirm.icon,
                    showCancelButton: true,
                    confirmButtonText: cfg.confirm.confirmButtonText,
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: cfg.confirm.confirmClass,
                        cancelButton: 'btn btn-outline-secondary'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        performSubmission();
                    }
                });
            }

            // preventDefault stops any native form post
            submitBtn.addEventListener('click', function (e) { e.preventDefault(); handleTestingSubmission(submitBtn, 'pass'); });
            failBtn.addEventListener('click',   function (e) { e.preventDefault(); handleTestingSubmission(failBtn, 'fail'); });
        });
    </script>
}
