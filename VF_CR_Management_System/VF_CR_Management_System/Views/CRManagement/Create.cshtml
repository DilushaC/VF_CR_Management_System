@{
    ViewData["Title"] = "Create CR";
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title mb-0">Section 1 : Change Request and Requirement - CR10000021212121</h4>
            </div>

            <div class="card-body">
                <form id="crForm">
                    <div class="row g-3">

                        <!-- Left Column -->
                        <div class="col-lg-6">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <p class="mb-1 fw-bold text-muted">Requester Name</p>
                                    <input type="text" class="form-control" value="@username" disabled>
@*                                     <select class="form-control select2" data-toggle="select2">
                                        <option value="" selected disabled hidden>Select Requester</option>
                                        <option value="Sobitha Weerasekara">Sobitha Weerasekara</option>
                                        <option value="Indika Edirisinghe">Indika Edirisinghe</option>
                                        <option value="Palinda Budhdhika">Palinda Budhdhika</option>
                                        <option value="Ruwan Wijesooriya">Ruwan Wijesooriya</option>
                                        <option value="Sameera Rajapaksha">Sameera Rajapaksha</option>
                                    </select> *@
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" value="@designation" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Department</label>
                                    <input type="text" class="form-control" value="@department" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="@email" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Request Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled>
                                </div>
                                <div class="col-md-6">
                                    <!-- reserved for a future field (e.g. CR Reference No.) to balance this row -->
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Change Summary &amp; Business Justification</label>
                                <textarea class="form-control" rows="6" placeholder="Write the explanation here..."></textarea>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-lg-6 d-flex flex-column">
                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Type</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio3" name="customRadio1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio3">Bug Fix</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio4" name="customRadio1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio4">Report Development</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio5" name="customRadio1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio5">Enhancement</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio6" name="customRadio1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio6">Infrastructure Changes</label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input type="radio" id="customRadio7" name="customRadio1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio7">Other</label>
                                    </div>
                                </div>
                            </div>

                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Priority</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-check-inline form-radio-success mb-0">
                                        <input type="radio" id="customRadio8" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio8">Low</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-secondary mb-0">
                                        <input type="radio" id="customRadio9" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio9">Medium</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-warning mb-0">
                                        <input type="radio" id="customRadio10" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio10">High</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-danger mb-0">
                                        <input type="radio" id="customRadio11" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio11">Emergency</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-danger">Cancel</button>
                        <div class="d-flex gap-2">
                            <button type="button" id="btn-save" class="btn btn-danger">Save</button>
                            <button type="submit" id="btn-submit" class="btn btn-primary">Submit & Approve</button>
                        </div>
                    </div>
                </form>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var form = document.getElementById('crForm');
            var saveBtn = document.getElementById('btn-save');
            var submitBtn = document.getElementById('btn-submit');

            // SAVE button — confirm before saving
            saveBtn.addEventListener('click', function () {
                Swal.fire({
                    title: 'Save this Change Request?',
                    text: "Your progress will be saved, but the CR won't be submitted yet.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-warning me-2',
                        cancelButton: 'btn btn-light'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        // TODO: hook up actual save logic here (AJAX call, partial submit, etc.)
                        Swal.fire({
                            title: 'Saved!',
                            text: 'Your Change Request has been saved.',
                            icon: 'success',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    }
                });
            });

            // SUBMIT button — confirm before submitting the form
            form.addEventListener('submit', function (event) {
                event.preventDefault(); // stop the form from submitting immediately

                Swal.fire({
                    title: 'Submit this Change Request?',
                    text: "Once submitted, you won't be able to edit this CR.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-primary me-2',
                        cancelButton: 'btn btn-light'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        // Actually submit the form now that the user confirmed
                        form.submit();
                    }
                });
            });
        });
    </script>
}