@model VF_CR_Management_System.Data.Models.ChangeRequest
@using VF_CR_Management_System.Data.Models
@{
    ViewData["Title"] = "Create CR";
    var users = ViewBag.Users as List<UserModel>;
    var divisions = ViewBag.Divisions as List<Division>;
    int crId = ViewBag.CRID != null ? (int)ViewBag.CRID : 0;
    var formAction = crId > 0
        ? Url.Action("Edit", "CRManagement", new { id = crId })
        : Url.Action("Create", "CRManagement");

    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title mb-0">Section 1 : Change Request and Requirement</h4>
            </div>

            <div class="card-body">
                <form id="crForm" action="@formAction" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Holds 1 (Save) or 2 (Submit & Approve), set by JS right before submission -->
                    <input type="hidden" id="StatusID" name="StatusID" value="">
                    <!-- Present only when editing an existing draft; used client-side to know whether to fetch/populate the form via AJAX -->
                    <input type="hidden" id="CRID" name="CRID" value="@crId">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">

                        <!-- Left Column -->
                        <div class="col-lg-6">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Requester Name</label>
                                    <input type="text" class="form-control" value="@username" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" value="@designation" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Department</label>
                                    <input type="text" class="form-control" value="@department" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="@email" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Request Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled>
                                </div>
                                <div class="col-md-6">
                                    <!-- Reserved for future field -->
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-12">
                                    <label class="form-label" for="ChangeTitle">Change Request Title</label>
                                    <input id="ChangeTitle" name="ChangeTitle" class="form-control" value="@Model?.ChangeTitle">
                                    <span asp-validation-for="ChangeTitle" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="Summary">Change Summary &amp; Business Justification</label>
                                <textarea id="Summary" name="Summary" class="form-control" rows="18"
                                          placeholder="Write the explanation here...">@Model?.Summary</textarea>
                                <span asp-validation-for="Summary" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-lg-6 d-flex flex-column">
                            <!-- Change Type Card -->
                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Type</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio3" name="ChangeTypeID" value="1" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio3">Bug Fix</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio4" name="ChangeTypeID" value="2" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio4">Report Development</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio5" name="ChangeTypeID" value="3" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio5">Enhancement</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio6" name="ChangeTypeID" value="4" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio6">Infrastructure Changes</label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input type="radio" id="customRadio7" name="ChangeTypeID" value="5" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio7">Other</label>
                                    </div>

                                    <div id="otherTextareaWrapper" class="mt-2" style="display: none;">
                                        <textarea id="otherTextarea" name="OtherChangeType" class="form-control form-control-sm" rows="2" placeholder="Please specify..."></textarea>
                                    </div>
                                    <span asp-validation-for="ChangeTypeID" class="text-danger"></span>
                                    <span asp-validation-for="OtherChangeType" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Change Priority Card -->
                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Priority</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-check-inline form-radio-success mb-0">
                                        <input type="radio" id="customRadio8" name="PriorityID" value="1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio8">Low</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-secondary mb-0">
                                        <input type="radio" id="customRadio9" name="PriorityID" value="2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio9">Medium</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-warning mb-0">
                                        <input type="radio" id="customRadio10" name="PriorityID" value="3" class="form-check-input">
                                        <label class="form-check-label" for="customRadio10">High</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-danger mb-0">
                                        <input type="radio" id="customRadio11" name="PriorityID" value="4" class="form-check-input">
                                        <label class="form-check-label" for="customRadio11">Emergency</label>
                                    </div>
                                    <span asp-validation-for="PriorityID" class="text-danger d-block mt-1"></span>
                                </div>
                            </div>

                            <!-- Division Card -->
                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Division</h6>
                                </div>
                                <div class="card-body">
                                    <label class="form-label" for="DivisionID">Select Division</label>
                                    <select id="DivisionID" name="DivisionID" class="form-control select2" data-toggle="select2">
                                        <option value="" selected disabled hidden>Select Division</option>
                                        @if (divisions != null)
                                        {
                                            foreach (var division in divisions)
                                            {
                                                <option value="@division.Id">@division.DivisionName</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="DivisionID" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Module Card -->
                            <div class="card border mb-3" id="moduleCard" style="display: none;">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Module</h6>
                                </div>
                                <div class="card-body">
                                    <label class="form-label" for="ModuleID">Select Module</label>
                                    <select id="ModuleID" name="ModuleID" class="form-control select2" data-toggle="select2">
                                        <option value="" selected disabled hidden>Select Module</option>
                                    </select>
                                    <span asp-validation-for="ModuleID" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Hidden Approver Selector Source -->
                            <div class="card border mb-3" id="approver-wrapper" style="display:none;">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Division Head Selection</h6>
                                </div>
                                <div class="card-body">
                                    <label class="form-label" for="ApproverID">Select User</label>
                                    <select id="ApproverID" name="ApproverID" class="form-control select2" data-toggle="select2">
                                        <option value="" selected disabled hidden>Select User</option>
                                        @if (users != null)
                                        {
                                            foreach (var user in users)
                                            {
                                                <option value="@user.UserName">@user.FirstName @user.LastName - @user.UserName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-danger" onclick="window.location.href='@Url.Action("DraftTable")'">Cancel</button>
                        <div class="d-flex gap-2">
                            <button type="button" id="btn-save" class="btn btn-danger" data-status="1">Save</button>
                            <button type="button" id="btn-submit" class="btn btn-primary" data-status="2">Submit</button>
                        </div>
                    </div>
                </form>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
@section Scripts {
    <script>
        function toggleOtherTextarea() {
            var selectedType = $('input[name="ChangeTypeID"]:checked').val();
            var $wrapper = $('#otherTextareaWrapper');
            if (selectedType === "5") {
                $wrapper.slideDown(200);
            } else {
                $wrapper.slideUp(200);
                $('#otherTextarea').val('');
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var form = document.getElementById('crForm');
            var saveBtn = document.getElementById('btn-save');
            var submitBtn = document.getElementById('btn-submit');
            var statusInput = document.getElementById('StatusID');

            var isNewCr = (parseInt(document.getElementById('CRID').value, 10) || 0) <= 0;

            var $division = $('#DivisionID');
            var $moduleCard = $('#moduleCard');
            var $module = $('#ModuleID');

            function loadModulesForDivision(divisionId, preselectId) {
                if (!divisionId) {
                    $module.empty().append('<option value="" selected disabled hidden>Select Module</option>').trigger('change');
                    $moduleCard.hide();
                    return;
                }

                fetch('@Url.Action("GetModulesByDivision", "CRManagement")' + '?divisionId=' + divisionId)
                    .then(function (response) {
                        if (!response.ok) { throw new Error('Failed to load modules.'); }
                        return response.json();
                    })
                    .then(function (modules) {
                        $module.empty();
                        $module.append('<option value="" selected disabled hidden>Select Module</option>');
                        modules.forEach(function (m) {
                            $module.append('<option value="' + m.id + '">' + m.name + '</option>');
                        });

                        $moduleCard.show();

                        if (preselectId) {
                            $module.val(String(preselectId)).trigger('change');
                        } else {
                            $module.trigger('change');
                        }
                    })
                    .catch(function (err) {
                        Swal.fire({
                            title: 'Could not load Modules',
                            text: err.message,
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    });
            }

            $division.on('change', function () {
                var divisionId = $(this).val();
                loadModulesForDivision(divisionId, null);
            });

            // Save (Draft) execution
            saveBtn.addEventListener('click', function () {
                Swal.fire({
                    title: 'Save this Change Request?',
                    text: "Your progress will be saved, but the CR won't be submitted yet.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-warning me-2',
                        cancelButton: 'btn btn-light'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        statusInput.value = saveBtn.dataset.status;
                        saveChangeRequest(false);
                    }
                });
            });

            // Submit execution
            submitBtn.addEventListener('click', function () {
                if (!$division.val()) {
                    Swal.fire({
                        title: 'Select a Division',
                        text: 'Please select a Division before submitting.',
                        icon: 'warning',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                    return;
                }

                var approverSelect = document.getElementById('ApproverID');
                var optionsHtml = approverSelect.innerHTML;

                Swal.fire({
                    title: 'Submit this Change Request?',
                    html:
                        '<p class="mb-3">This will send the CR forward for processing.</p>' +
                        '<div class="text-start">' +
                            '<label class="form-label fw-bold" for="swal-approver">Select Division Head</label>' +
                            '<select id="swal-approver" class="form-control select2" style="width:100%;">' + optionsHtml + '</select>' +
                            '<span id="swal-approver-error" class="text-danger d-none mt-1">Please select a Division Head.</span>' +
                        '</div>',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit it',
                    cancelButtonText: 'Cancel',
                    customClass: { confirmButton: 'btn btn-primary me-2', cancelButton: 'btn btn-outline-secondary' },
                    buttonsStyling: false,
                    focusConfirm: false,
                    didOpen: function () {
                        $('#swal-approver').select2({
                            dropdownParent: $('.swal2-popup'),
                            placeholder: 'Select User',
                            width: '100%'
                        });

                        if (approverSelect.value) {
                            $('#swal-approver').val(approverSelect.value).trigger('change');
                        }

                        $('#swal-approver').on('change', function () {
                            if (this.value) {
                                document.getElementById('swal-approver-error').classList.add('d-none');
                            }
                        });
                    },
                    willClose: function () {
                        if ($('#swal-approver').data('select2')) {
                            $('#swal-approver').select2('destroy');
                        }
                    },
                    preConfirm: function () {
                        var swalSelect = document.getElementById('swal-approver');
                        var errorSpan = document.getElementById('swal-approver-error');

                        if (!swalSelect.value) {
                            errorSpan.classList.remove('d-none');
                            return false;
                        }

                        return swalSelect.value;
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        approverSelect.value = result.value;
                        statusInput.value = submitBtn.dataset.status;
                        saveChangeRequest(!isNewCr);
                    }
                });
            });

            function saveChangeRequest(thenSubmitWorkflow) {
                var formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData
                })
                .then(function (response) {
                    if (!response.ok) {
                        return response.text().then(function (text) {
                            throw new Error('Server returned ' + response.status + ': ' + text);
                        });
                    }
                    return response.json();
                })
                .then(function (data) {
                    if (!data.success) {
                        Swal.fire({
                            title: 'Could not save',
                            text: data.message,
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                        return;
                    }

                    if (!thenSubmitWorkflow) {
                        Swal.fire({
                            title: statusInput.value === '2' ? 'Submitted!' : 'Saved!',
                            text: data.message,
                            icon: 'success',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        }).then(function () {
                            if (data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                            }
                        });
                        return;
                    }

                    var crid = data.crid || parseInt(document.getElementById('CRID').value, 10) || 0;

                    if (!crid) {
                        Swal.fire({
                            title: 'Could not submit',
                            text: 'The Change Request was saved, but its ID could not be determined for submission.',
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("Submit", "CRManagement")',
                        type: 'POST',
                        data: { id: crid },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            Swal.fire({
                                title: 'Submitted!',
                                text: 'The Change Request has been submitted.',
                                icon: 'success',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            }).then(function () {
                                window.location.href = data.redirectUrl || '@Url.Action("DraftTable")';
                            });
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to submit the CR. Please try again.';
                            Swal.fire({
                                title: 'Error',
                                text: msg,
                                icon: 'error',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            });
                        }
                    });
                })
                .catch(function (err) {
                    Swal.fire({
                        title: 'Something went wrong',
                        text: err.message,
                        icon: 'error',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                });
            }

            // Hydrate Edit Form Data
            var crId = parseInt(document.getElementById('CRID').value, 10) || 0;
            if (crId > 0) {
                fetch('@Url.Action("GetChangeRequestData", "CRManagement")' + '?id=' + crId)
                    .then(function (response) {
                        if (!response.ok) { throw new Error('Failed to load Change Request.'); }
                        return response.json();
                    })
                    .then(function (data) {
                        populateFormFromData(data);
                    })
                    .catch(function (err) {
                        Swal.fire({
                            title: 'Could not load Change Request',
                            text: err.message,
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    });
            }

            function populateFormFromData(data) {
                if (data.summary) {
                    document.getElementById('Summary').value = data.summary;
                }
                if (data.changeTitle) {
                    document.getElementById('ChangeTitle').value = data.changeTitle;
                }
                if (data.changeTypeID) {
                    $('input[name="ChangeTypeID"][value="' + data.changeTypeID + '"]').prop('checked', true).trigger('change');
                }
                if (data.otherChangeType) {
                    $('#otherTextarea').val(data.otherChangeType);
                }
                if (data.priorityID) {
                    $('input[name="PriorityID"][value="' + data.priorityID + '"]').prop('checked', true);
                }
                if (data.approverID) {
                    $('#ApproverID').val(data.approverID).trigger('change');
                }
                if (data.divisionID) {
                    $division.val(String(data.divisionID)).trigger('change');
                    loadModulesForDivision(data.divisionID, data.moduleID);
                }
            }
        });
    </script>
}