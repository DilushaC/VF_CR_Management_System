@model VF_CR_Management_System.Data.Models.ChangeRequest
@{
    ViewData["Title"] = "Create CR";
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title mb-0">Section 1 : Change Request and Requirement</h4>
            </div>

            <div class="card-body">
                <form id="crForm" asp-controller="CRManagement" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">

                        <!-- Left Column -->
                        <div class="col-lg-6">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Requester Name</label>
                                    <input type="text" class="form-control" value="@username" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" value="@designation" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Department</label>
                                    <input type="text" class="form-control" value="@department" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="@email" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Request Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled>
                                </div>
                                <div class="col-md-6">
                                    <!-- reserved for a future field (e.g. CR Reference No.) to balance this row -->
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="Summary">Change Summary &amp; Business Justification</label>
                                <textarea id="Summary" name="Summary" class="form-control" rows="6"
                                          placeholder="Write the explanation here...">@Model?.Summary</textarea>
                                <span asp-validation-for="Summary" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-lg-6 d-flex flex-column">
                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Type</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio3" name="ChangeTypeID" value="1" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio3">Bug Fix</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio4" name="ChangeTypeID" value="2" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio4">Report Development</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio5" name="ChangeTypeID" value="3" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio5">Enhancement</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="radio" id="customRadio6" name="ChangeTypeID" value="4" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio6">Infrastructure Changes</label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input type="radio" id="customRadio7" name="ChangeTypeID" value="5" class="form-check-input" onchange="toggleOtherTextarea()">
                                        <label class="form-check-label" for="customRadio7">Other</label>
                                    </div>
                                    <!-- Textarea shown only when "Other" is selected -->
                                    <div id="otherTextareaWrapper" class="mt-2" style="display: none;">
                                        <textarea id="otherTextarea" name="OtherChangeType" class="form-control form-control-sm" rows="2" placeholder="Please specify..."></textarea>
                                    </div>
                                    <span asp-validation-for="ChangeTypeID" class="text-danger"></span>
                                    <span asp-validation-for="OtherChangeType" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Priority</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-check-inline form-radio-success mb-0">
                                        <input type="radio" id="customRadio8" name="PriorityID" value="1" class="form-check-input">
                                        <label class="form-check-label" for="customRadio8">Low</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-secondary mb-0">
                                        <input type="radio" id="customRadio9" name="PriorityID" value="2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio9">Medium</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-warning mb-0">
                                        <input type="radio" id="customRadio10" name="PriorityID" value="3" class="form-check-input">
                                        <label class="form-check-label" for="customRadio10">High</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-danger mb-0">
                                        <input type="radio" id="customRadio11" name="PriorityID" value="4" class="form-check-input">
                                        <label class="form-check-label" for="customRadio11">Emergency</label>
                                    </div>
                                    <span asp-validation-for="PriorityID" class="text-danger d-block mt-1"></span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-outline-danger" onclick="window.location.href='@Url.Action("Index")'">Cancel</button>
                        <div class="d-flex gap-2">
                            <button type="button" id="btn-save" class="btn btn-danger">Save</button>
                            <button type="submit" id="btn-submit" class="btn btn-primary">Submit &amp; Approve</button>
                        </div>
                    </div>
                </form>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var form = document.getElementById('crForm');
            var saveBtn = document.getElementById('btn-save');

            // SAVE button — confirm, then submit as a draft (StatusID handled server-side if you add a Save action)
            saveBtn.addEventListener('click', function () {
                Swal.fire({
                    title: 'Save this Change Request?',
                    text: "Your progress will be saved, but the CR won't be submitted yet.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, save it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-warning me-2',
                        cancelButton: 'btn btn-light'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        // TODO: point this at a dedicated "Save draft" endpoint if the behaviour
                        // needs to differ from Submit (e.g. different StatusID, skip validation).
                        submitChangeRequest();
                    }
                });
            });

            // SUBMIT button — confirm, then post via AJAX (the controller returns JSON, not a redirect)
            form.addEventListener('submit', function (event) {
                event.preventDefault(); // stop the form from submitting immediately

                Swal.fire({
                    title: 'Submit this Change Request?',
                    text: "Once submitted, you won't be able to edit this CR.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit it',
                    cancelButtonText: 'Cancel',
                    customClass: {
                        confirmButton: 'btn btn-primary me-2',
                        cancelButton: 'btn btn-light'
                    },
                    buttonsStyling: false
                }).then(function (result) {
                    if (result.isConfirmed) {
                        submitChangeRequest();
                    }
                });
            });
        });

        function submitChangeRequest() {
            var form = document.getElementById('crForm');
            var formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (data.success) {
                        Swal.fire({
                            title: 'Submitted!',
                            text: data.message,
                            icon: 'success',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        }).then(function () {
                            if (data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Could not submit',
                            text: data.message,
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    }
                })
                .catch(function (err) {
                    Swal.fire({
                        title: 'Something went wrong',
                        text: err.message,
                        icon: 'error',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                });
        }

        function toggleOtherTextarea() {
            const otherRadio = document.getElementById('customRadio7');
            const wrapper = document.getElementById('otherTextareaWrapper');
            wrapper.style.display = otherRadio.checked ? 'block' : 'none';
        }
    </script>
}
