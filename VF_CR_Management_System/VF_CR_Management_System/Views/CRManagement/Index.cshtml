@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="header-title mb-0">Change Requests</h4>

                    <ul class="nav nav-pills mb-0 cr-filter-tabs" id="crFilterTabs">
                        <li class="nav-item">
                            <a href="#" data-filter="all" aria-expanded="@(currentFilter == "all" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "all" ? "active" : "")">
                                All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" data-filter="createdByMe" aria-expanded="@(currentFilter == "createdByMe" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "createdByMe" ? "active" : "")">
                                Created by Me
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" data-filter="assignedToMe" aria-expanded="@(currentFilter == "assignedToMe" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "assignedToMe" ? "active" : "")">
                                Assigned to Me
                            </a>
                        </li>
                    </ul>
                </div>

                <style>
                    .cr-filter-tabs {
                        gap: 0.5rem;
                    }

                        .cr-filter-tabs .nav-item .nav-link {
                            font-size: 0.8125rem !important;
                            padding: 0.3rem 0.75rem !important;
                            color: #7a3b47 !important;
                            background-color: #f7eef0 !important;
                            font-weight: 500;
                            border: none;
                            border-radius: 0.25rem;
                        }

                            .cr-filter-tabs .nav-item .nav-link:hover {
                                background-color: #e3c3ca !important;
                                color: #7a3b47 !important;
                            }

                            .cr-filter-tabs .nav-item .nav-link.active {
                                background-color: #8f3b4c !important;
                                color: #ffffff !important;
                            }
                </style>

                <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>CR Number</th>
                            <th>Change Type</th>
                            <th>Priority</th>
                            <th>Module</th>
                            <th>Status</th>
                            <th>Requested By</th>
                            <th>Requested Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var cr in Model)
                            {
                                var isDraft = cr.CRNumber != null &&
                                cr.CRNumber.StartsWith("Waiting", StringComparison.OrdinalIgnoreCase);
                                var displayCrNumber = isDraft ? "WAITING" : cr.CRNumber;
                                <tr>
                                    <td title="@cr.CRNumber">@displayCrNumber</td>
                                    <td>@cr.ChangeType</td>
                                    <td>
                                        @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">@cr.Priority</span>
                                        }
                                        else
                                        {
                                            @cr.Priority
                                        }
                                    </td>
                                    <td>@cr.Module</td>
                                    <td>@cr.Status</td>
                                    <td>@cr.RequestedBy</td>
                                    <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <!-- Eye button now opens the details modal instead of navigating to Edit -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info btn-view"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#crDetailsModal"
                                                    data-bs-crid="@cr.CRID"
                                                    data-bs-crnumber="@displayCrNumber"
                                                    data-bs-summary="@cr.Summary"
                                                    data-bs-changetype="@cr.ChangeType"
                                                    data-bs-priority="@cr.Priority"
                                                    data-bs-module="@cr.Module"
                                                    data-bs-status="@cr.Status"
                                                    data-bs-requestedby="@cr.RequestedBy"
                                                    data-bs-requesteddate="@cr.RequestedDate.ToString("yyyy/MM/dd")"
                                                    title="View">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger btn-reject"
                                                    data-id="@cr.CRID"
                                                    title="Reject">
                                                <i class="ri-close-circle-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div> <!-- end card body-->
        </div> <!-- end card -->
    </div><!-- end col-->
</div> <!-- end row-->
<!-- CR Details Modal (read-only view, populated via event.relatedTarget) -->
<div class="modal fade" id="crDetailsModal" tabindex="-1" aria-labelledby="crDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crDetailsModalLabel">Change Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">CR Number:</label>
                        <input type="text" class="form-control" id="modal-crnumber" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Status:</label>
                        <input type="text" class="form-control" id="modal-status" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Change Type:</label>
                        <input type="text" class="form-control" id="modal-changetype" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Priority:</label>
                        <input type="text" class="form-control" id="modal-priority" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Module:</label>
                        <input type="text" class="form-control" id="modal-module" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Requested By:</label>
                        <input type="text" class="form-control" id="modal-requestedby" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Requested Date:</label>
                        <input type="text" class="form-control" id="modal-requesteddate" readonly>
                    </div>
                    <div class="col-12">
                        <label class="col-form-label fw-semibold">Summary &amp; Business Justification:</label>
                        <textarea class="form-control" id="modal-summary" rows="4" readonly></textarea>
                    </div>
                </div>

                <div class="card border mt-3 mb-0">
                    <div class="card-body">
                        <label class="form-label" for="modal-approver">Select Implementer</label>
                        <select id="modal-approver" name="ApproverID" class="form-control select2" data-toggle="select2">
                            <option value="" selected disabled hidden>Select User</option>
                            @if (ViewBag.Users != null)
                            {
                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserName">@user.FirstName @user.LastName</option>
                                }
                            }
                        </select>
                        <span id="modal-approver-error" class="text-danger d-none">Please select an approver.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="modal-approve-btn" class="btn btn-success">Approve</button>
                <button type="button" id="modal-approve-btn" class="btn btn-danger">Reject</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: true
            });

            $('#crFilterTabs').on('click', 'a.nav-link', function (e) {
                e.preventDefault();
                var selected = $(this).data('filter');
                window.location.href = '@Url.Action("Index", "CRManagement")' + '?filter=' + selected;
            });

            $('#basic-datatable').on('click', '.btn-reject', function () {
                var id = $(this).data('id');
                if (confirm('Are you sure you want to reject this Change Request?')) {
                    $.ajax({
                        url: '@Url.Action("Reject", "CRManagement")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            location.reload();
                        },
                        error: function () {
                            alert('Failed to reject the CR. Please try again.');
                        }
                    });
                }
            });
        });

        // Populate the CR Details modal from the button that triggered it
        // (event.relatedTarget), same pattern as the Bootstrap "varied modal" example.
        var crDetailsModal = document.getElementById('crDetailsModal');
        crDetailsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var crid = button.getAttribute('data-bs-crid');
            var crnumber = button.getAttribute('data-bs-crnumber');
            var summary = button.getAttribute('data-bs-summary');
            var changetype = button.getAttribute('data-bs-changetype');
            var priority = button.getAttribute('data-bs-priority');
            var module = button.getAttribute('data-bs-module');
            var status = button.getAttribute('data-bs-status');
            var requestedby = button.getAttribute('data-bs-requestedby');
            var requesteddate = button.getAttribute('data-bs-requesteddate');

            crDetailsModal.querySelector('#modal-crnumber').value = crnumber || '';
            crDetailsModal.querySelector('#modal-status').value = status || '';
            crDetailsModal.querySelector('#modal-changetype').value = changetype || '';
            crDetailsModal.querySelector('#modal-priority').value = priority || '';
            crDetailsModal.querySelector('#modal-module').value = module || '';
            crDetailsModal.querySelector('#modal-requestedby').value = requestedby || '';
            crDetailsModal.querySelector('#modal-requesteddate').value = requesteddate || '';
            crDetailsModal.querySelector('#modal-summary').value = summary || '';

            // Track which CR this modal instance is currently showing, so the
            // Approve button below knows which CRID to submit.
            $(crDetailsModal).data('crid', crid);

            // Reset the approver dropdown for each new CR opened
            $('#modal-approver').val('').trigger('change');
            $('#modal-approver-error').addClass('d-none');

            var editLink = crDetailsModal.querySelector('#modal-edit-link');
            editLink.setAttribute('href', '@Url.Action("Edit", "CRManagement")' + '/' + crid);
        });

        // select2 needs to be (re)initialized after the modal is in the DOM/visible,
        // otherwise the dropdown widget can render with zero width inside a modal.
        $(crDetailsModal).on('shown.bs.modal', function () {
            $('#modal-approver').select2({
                dropdownParent: $(crDetailsModal)
            });
        });

        $('#modal-approve-btn').on('click', function () {
            var crid = $(crDetailsModal).data('crid');
            var approverId = $('#modal-approver').val();

            if (!approverId) {
                $('#modal-approver-error').removeClass('d-none');
                return;
            }
            $('#modal-approver-error').addClass('d-none');

            if (!confirm('Are you sure you want to approve this Change Request?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Approve", "CRManagement")',
                type: 'POST',
                data: { id: crid, ApproverID: approverId },
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function () {
                    location.reload();
                },
                error: function () {
                    alert('Failed to approve the CR. Please try again.');
                }
            });
        });
    </script>
}
