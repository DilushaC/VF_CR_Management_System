@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="header-title mb-0">Change Requests</h4>
                    <div>
                        <select id="crFilter" class="form-select form-select-sm">
                            <option value="all" selected="@(currentFilter == "all")">All</option>
                            <option value="createdByMe" selected="@(currentFilter == "createdByMe")">Created by Me</option>
                            <option value="assignedToMe" selected="@(currentFilter == "assignedToMe")">Assigned to Me</option>
                        </select>
                    </div>
                </div>
                <hr />
                <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>CR Number</th>
                            <th>Change Type</th>
                            <th>Priority</th>
                            <th>Module</th>
                            <th>Status</th>
                            <th>Requested By</th>
                            <th>Requested Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var cr in Model)
                            {
                                <tr>
                                    <td>@cr.CRNumber</td>
                                    <td>@cr.ChangeType</td>
                                    <td>
                                        @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">@cr.Priority</span>
                                        }
                                        else if (string.Equals(cr.Priority, "Low", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">@cr.Priority</span>
                                        }
                                        else
                                        {
                                            @cr.Priority
                                        }
                                    </td>
                                    <td>@cr.Module</td>
                                    <td>@cr.Status</td>
                                    <td>@cr.RequestedBy</td>
                                    <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@cr.CRID"
                                               class="btn btn-sm btn-info" title="Edit">
                                                <i class="ri-eye-line"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-success btn-approve"
                                                    data-id="@cr.CRID"
                                                    title="Approve">
                                                <i class="ri-check-line"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger btn-reject"
                                                    data-id="@cr.CRID"
                                                    title="Reject">
                                                <i class="ri-close-circle-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div> <!-- end card body-->
        </div> <!-- end card -->
    </div><!-- end col-->
</div> <!-- end row-->
@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: true
            });

            $('#crFilter').on('change', function () {
                var selected = $(this).val();
                window.location.href = '@Url.Action("Index", "CRManagement")' + '?filter=' + selected;
            });

            $('#basic-datatable').on('click', '.btn-approve', function () {
                var id = $(this).data('id');
                if (confirm('Are you sure you want to approve this Change Request?')) {
                    $.ajax({
                        url: '@Url.Action("Approve", "CRManagement")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            location.reload();
                        },
                        error: function () {
                            alert('Failed to approve the CR. Please try again.');
                        }
                    });
                }
            });

            $('#basic-datatable').on('click', '.btn-reject', function () {
                var id = $(this).data('id');
                if (confirm('Are you sure you want to reject this Change Request?')) {
                    $.ajax({
                        url: '@Url.Action("Reject", "CRManagement")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            location.reload();
                        },
                        error: function () {
                            alert('Failed to reject the CR. Please try again.');
                        }
                    });
                }
            });
        });
    </script>
}