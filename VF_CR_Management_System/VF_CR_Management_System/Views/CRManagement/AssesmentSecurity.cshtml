@{
    ViewData["Title"] = "CR Assesment - Security";
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title mb-0">Section 2 : Security Requirements (IS Officer) - CR10000021212121</h4>
            </div>

            <div class="card-body">
                <form>
                    <div class="row g-3">

                        <!-- Left Column -->
                        <div class="col-lg-6">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">IS Officer Name</label>
                                    <input type="text" class="form-control" value="@username" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" value="@designation" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Department</label>
                                    <input type="text" class="form-control" value="@department" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" value="@email" disabled>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Request Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Effort Estimate ( Days )</label>
                                    <input type="number" class="form-control">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Information Security Risk Assessment</label>
                                <textarea class="form-control" rows="6" placeholder="Write the explanation here..."></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Fixed Asset Information </label>
                                <textarea class="form-control" rows="6" placeholder="Write the explanation here..."></textarea>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-lg-6 d-flex flex-column">

                            <div class="card border mb-3">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Change Impact</h6>
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-check-inline form-radio-secondary mb-0">
                                        <input type="radio" id="customRadio9" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio9">Minor</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-warning mb-0">
                                        <input type="radio" id="customRadio10" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio10">Standard</label>
                                    </div>
                                    <div class="form-check form-check-inline form-radio-danger mb-0">
                                        <input type="radio" id="customRadio11" name="customRadio2" class="form-check-input">
                                        <label class="form-check-label" for="customRadio11">Major</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light">Cancel</button>
                        <button type="submit" class="btn btn-primary">Submit Change Request</button>
                    </div>
                </form>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div><!-- end col -->
</div><!-- end row -->