@model VF_CR_Management_System.Data.Models.ChangeRequest
@using VF_CR_Management_System.Data.Models
@{
    ViewData["Title"] = "CR Assessment";
    var vendors = ViewBag.Vendors as List<Vendor>;
    var effortEstimateDays = ViewBag.EffortEstimateDays as double? ?? 0;
    var approverUserName = ViewBag.ApproverUserName as string;

    // If VendorID is a non-nullable int on the model, use: int selectedVendorId = Model.VendorID;
    int selectedVendorId = Model.VendorID;
    var hasVendorSupport = selectedVendorId > 0;
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");

    string Initials(string? n)
    {
        var l = (n ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(p => char.IsLetter(p[0]))
            .Select(p => char.ToUpperInvariant(p[0]))
            .Take(2)
            .ToArray();
        return l.Length > 0 ? new string(l) : "?";
    }
}
@{
    // ---- Existing attachments, split by attachment type ----
    var allAttachments = (ViewBag.Attachments as IEnumerable<Attachment>) ?? Enumerable.Empty<Attachment>();

    var srsAttachments = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "SRS", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var baAttachments = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "BA", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Vendor Report files (also catches older uploads that have no type recorded)
    var vendorAttachments = allAttachments
        .Where(a => string.IsNullOrWhiteSpace(a.AttachmentTypeName) ||
                    string.Equals(a.AttachmentTypeName, "Vendor Report", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };

    void RenderAttachmentList(string listId, IEnumerable<Attachment> items)
    {
        if (items == null || !items.Any())
        {
            return;
        }

        <div class="mt-3">
            <label class="casm-label-sm">Previously uploaded</label>
            <ul class="casm-filelist" id="@listId">
                @foreach (var att in items)
                {
                    var ext = System.IO.Path.GetExtension(att.FileName).ToLowerInvariant();
                    var isImage = imageExtensions.Contains(ext);
                    var isPdf = ext == ".pdf";

                    <li data-attachment-id="@att.AttachmentID">
                        <span class="casm-file-ico"><i class="mdi mdi-paperclip"></i></span>

                        <span class="casm-file-name">
                            @if (isImage)
                            {
                                <a href="javascript:void(0);"
                                   class="preview-attachment-link"
                                   data-attachment-id="@att.AttachmentID"
                                   data-file-name="@att.FileName">
                                    @att.FileName
                                </a>
                            }
                            else if (isPdf)
                            {
                                <a href="@Url.Action("PreviewAttachment", "CRManagement", new { id = att.AttachmentID })"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @att.FileName
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("DownloadAttachment", "CRManagement", new { id = att.AttachmentID })">
                                    @att.FileName
                                </a>
                            }
                            <small>@att.UploadedDate.ToString("yyyy/MM/dd")</small>
                        </span>

                        <a href="javascript:void(0);"
                           class="casm-file-remove remove-attachment-btn"
                           title="Remove attachment"
                           data-attachment-id="@att.AttachmentID">
                            <i class="ri-close-line"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
}

<style>
    .casm-page {
        --casm-accent: rgb(89, 17, 32);
        --casm-accent-soft: rgba(89, 17, 32, .1);
        --casm-progress: #3b5bdb;
        --casm-progress-soft: rgba(59, 91, 219, .12);
        --casm-ok: #1f9d6b;
        --casm-line: var(--bs-border-color, #e3e6ec);
        --casm-muted: var(--bs-secondary-color, #6b7385);
        --casm-card: var(--bs-card-bg, var(--bs-body-bg, #fff));
    }
    /* ===== Effort estimate: force native up/down spinners visible ===== */
    .casm-number-spin {
        -moz-appearance: textfield;
        appearance: auto;
    }

    .casm-number-spin::-webkit-outer-spin-button,
    .casm-number-spin::-webkit-inner-spin-button {
            -webkit-appearance: auto !important;
            opacity: 1 !important;
            margin-left: 4px;
    }
    /* ===== Hero ===== */
    .casm-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 1.25rem;
        padding: 1.5rem 1.75rem;
        border-radius: .9rem;
        color: #fff;
        background: #451423;
    }

        .casm-hero::after {
            content: "";
            position: absolute;
            right: -60px;
            top: -80px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,.05);
            pointer-events: none;
        }

    .casm-hero-row {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .casm-hero-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: .5rem;
        padding: .25rem .7rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        background: rgba(255,255,255,.12);
    }

    .casm-hero h3 {
        margin: 0;
        color: #fff;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .casm-hero p {
        margin: .25rem 0 0;
        color: rgba(255,255,255,.7);
        font-size: .92rem;
    }

    .casm-back {
        color: rgba(255,255,255,.85);
        text-decoration: none;
        font-weight: 600;
        font-size: .9rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .9rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.3);
    }

        .casm-back:hover {
            background: rgba(255,255,255,.12);
            color: #fff;
        }

    /* ===== Layout ===== */
    .casm-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 1.25rem;
        align-items: start;
    }

    .casm-aside {
        position: sticky;
        top: 90px;
        display: grid;
        gap: 1rem;
    }

    @@media (max-width: 991px) {
        .casm-grid {
            grid-template-columns: 1fr;
        }

        .casm-aside {
            position: static;
        }
    }

    /* ===== Section cards ===== */
    .casm-sec {
        margin-bottom: 1.1rem;
        border: 1px solid var(--casm-line);
        border-radius: .9rem;
        background: var(--casm-card);
        animation: casm-rise .4s ease-out backwards;
    }

        .casm-sec:nth-of-type(1) {
            animation-delay: .00s;
        }

        .casm-sec:nth-of-type(2) {
            animation-delay: .06s;
        }

        .casm-sec:nth-of-type(3) {
            animation-delay: .12s;
        }

    @@keyframes casm-rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    .casm-sec-head {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--casm-line);
    }

    .casm-step {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-weight: 700;
        font-size: .9rem;
        color: var(--casm-accent);
        background: var(--casm-accent-soft);
    }

    .casm-sec-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 700;
    }

    .casm-sec-sub {
        margin: 0;
        font-size: .83rem;
        color: var(--casm-muted);
    }

    .casm-sec-body {
        padding: 1.25rem;
    }

    /* ===== Implementer strip ===== */
    .casm-who {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .casm-avatar {
        flex: 0 0 auto;
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
        background: var(--casm-accent);
    }

    .casm-who-name {
        font-weight: 700;
        font-size: 1.05rem;
    }

    .casm-who-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem 1.25rem;
        margin-top: .15rem;
        font-size: .85rem;
        color: var(--casm-muted);
    }

        .casm-who-meta span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

        .casm-who-meta i {
            color: var(--casm-accent);
        }

    /* ===== Inputs ===== */
    .casm-label {
        font-weight: 600;
        margin-bottom: .35rem;
        display: block;
    }

    .casm-label-sm {
        font-weight: 700;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--casm-muted);
        display: block;
        margin-bottom: .4rem;
    }

    .casm-page .form-control,
    .casm-page .form-select {
        border-radius: .6rem;
    }

        .casm-page .form-control:focus,
        .casm-page .form-select:focus {
            border-color: var(--casm-accent) !important;
            box-shadow: 0 0 0 3px var(--casm-accent-soft) !important;
        }

        .casm-page .form-control.is-invalid,
        .casm-page .form-select.is-invalid {
            border-color: #d6384a !important;
        }

            .casm-page .form-control.is-invalid:focus,
            .casm-page .form-select.is-invalid:focus {
                box-shadow: 0 0 0 3px rgba(214,56,74,.15) !important;
            }

    /* ===== Inline field errors ===== */
    .casm-field-error {
        display: none;
        align-items: center;
        gap: .35rem;
        margin-top: .35rem;
        font-size: .8rem;
        font-weight: 500;
        color: #d6384a;
    }

        .casm-field-error.is-visible {
            display: flex;
        }

        .casm-field-error i {
            font-size: .95rem;
        }

    /* ===== Upload dropzones ===== */
    .casm-upload {
        border: 1.5px dashed var(--casm-line);
        border-radius: .8rem;
        padding: 1rem;
        transition: border-color .15s ease, background .15s ease;
    }

        .casm-upload:hover {
            border-color: var(--casm-accent);
            background: var(--casm-accent-soft);
        }

        .casm-upload.is-invalid {
            border-color: #d6384a;
        }

    .casm-filelist {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: .5rem;
    }

        .casm-filelist li {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .5rem .7rem;
            border: 1px solid var(--casm-line);
            border-radius: .6rem;
            background: var(--casm-card);
        }

    .casm-file-ico {
        flex: 0 0 auto;
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: .5rem;
        background: var(--casm-accent-soft);
        color: var(--casm-accent);
    }

    .casm-file-name {
        flex: 1 1 auto;
        min-width: 0;
        font-size: .88rem;
    }

        .casm-file-name a {
            color: inherit;
            text-decoration: none;
            font-weight: 600;
            word-break: break-word;
        }

            .casm-file-name a:hover {
                color: var(--casm-accent);
                text-decoration: underline;
            }

        .casm-file-name small {
            display: block;
            color: var(--casm-muted);
            font-size: .76rem;
        }

    .casm-file-remove {
        flex: 0 0 auto;
        width: 26px;
        height: 26px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        color: #d6384a;
        text-decoration: none;
    }

        .casm-file-remove:hover {
            background: rgba(214,56,74,.12);
        }

    /* ===== Toggle tiles (vendor yes/no) ===== */
    .casm-toggle {
        display: flex;
        gap: .6rem;
        margin-bottom: 1rem;
    }

    .casm-toggle-opt {
        position: relative;
        flex: 1 1 0;
    }

    .casm-toggle-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .casm-toggle-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin: 0;
        padding: .6rem .5rem;
        cursor: pointer;
        border: 1.5px solid var(--casm-line);
        border-radius: .7rem;
        font-weight: 600;
        font-size: .88rem;
        color: var(--casm-muted);
        transition: border-color .15s ease, background .15s ease, color .15s ease;
    }

    .casm-toggle-input:checked + .casm-toggle-tile {
        border-color: var(--casm-accent);
        background: var(--casm-accent-soft);
        color: var(--casm-accent);
    }

    .casm-toggle-input:focus-visible + .casm-toggle-tile {
        outline: 2px solid var(--casm-accent);
        outline-offset: 2px;
    }

    /* ===== Aside: CR summary card ===== */
    .casm-card {
        border: 1px solid var(--casm-line);
        border-radius: .9rem;
        background: var(--casm-card);
        padding: 1.1rem 1.15rem;
    }

        .casm-card h6 {
            margin: 0 0 .85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .45rem;
        }

            .casm-card h6 i {
                color: var(--casm-accent);
            }

    .casm-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        color: var(--casm-accent);
        background: var(--casm-accent-soft);
    }

    .casm-kv {
        display: grid;
        grid-template-columns: 1fr;
        gap: .65rem;
        margin-top: .9rem;
        font-size: .86rem;
    }

    .casm-kv-row {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        padding-bottom: .55rem;
        border-bottom: 1px dashed var(--casm-line);
    }

        .casm-kv-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .casm-kv-label {
        color: var(--casm-muted);
        flex: 0 0 auto;
    }

    .casm-kv-val {
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .casm-summary-text {
        margin-top: .9rem;
        padding-top: .85rem;
        border-top: 1px solid var(--casm-line);
        font-size: .85rem;
        line-height: 1.55;
        color: var(--casm-muted);
    }

        .casm-summary-text strong {
            display: block;
            color: inherit;
            font-weight: 700;
            margin-bottom: .3rem;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

    /* ===== Progress ring + checklist ===== */
    .casm-progress {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .casm-ring-wrap {
        position: relative;
        flex: 0 0 auto;
        width: 92px;
        height: 92px;
    }

    .casm-ring {
        width: 100%;
        height: 100%;
    }

        .casm-ring circle {
            fill: none;
            stroke-width: 9;
        }

        .casm-ring .casm-ring-bg {
            stroke: var(--casm-line);
        }

        .casm-ring .casm-ring-fg {
            stroke: var(--casm-progress);
            stroke-linecap: round;
            stroke-dasharray: 276.46;
            stroke-dashoffset: 276.46;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            transition: stroke-dashoffset .6s cubic-bezier(.3,.9,.3,1), stroke .3s;
        }

    .casm-ring-wrap.is-full .casm-ring-fg {
        stroke: var(--casm-ok);
    }

    .casm-ring-num {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 1.35rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--casm-progress);
    }

    .casm-ring-wrap.is-full .casm-ring-num {
        color: var(--casm-ok);
    }

    .casm-ring-num small {
        font-size: .7rem;
        font-weight: 600;
        color: var(--casm-muted);
        margin-left: 1px;
    }

    .casm-progress-text strong {
        display: block;
        font-size: 1rem;
    }

    .casm-progress-text span {
        font-size: .83rem;
        color: var(--casm-muted);
    }

    .casm-checklist {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        display: grid;
        gap: .45rem;
    }

        .casm-checklist li {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-size: .88rem;
            color: var(--casm-muted);
            transition: color .2s;
        }

            .casm-checklist li i {
                width: 20px;
                height: 20px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                font-size: .8rem;
                border: 1.5px solid var(--casm-line);
                color: transparent;
                transition: background .2s, border-color .2s, color .2s;
            }

            .casm-checklist li.is-done {
                color: inherit;
            }

                .casm-checklist li.is-done i {
                    background: var(--casm-ok);
                    border-color: var(--casm-ok);
                    color: #fff;
                }

    /* ===== Action bar ===== */
    .casm-actions {
        position: sticky;
        bottom: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-top: 1.25rem;
        padding: .85rem 1.1rem;
        border: 1px solid var(--casm-line);
        border-radius: .9rem;
        background: var(--casm-card);
        box-shadow: 0 -6px 18px rgba(23,33,59,.08);
    }

        .casm-actions .btn {
            border-radius: 999px;
            padding-left: 1.3rem;
            padding-right: 1.3rem;
            font-weight: 600;
        }

            .casm-actions .btn:disabled,
            .casm-actions .btn.disabled {
                opacity: .55;
                cursor: not-allowed;
                box-shadow: none;
            }

    @@media (prefers-reduced-motion: reduce) {
        .casm-sec {
            animation: none;
        }
    }
</style>

<div class="casm-page">

    <div class="casm-hero">
        <div class="casm-hero-row">
            <div>
                <span class="casm-hero-chip"><i class="ri-tools-line"></i>Section 2 · Implementer</span>
                <h3>Change Assessment — @Model.CRNumber</h3>
                <p>Review the request, log your implementation plan, and attach the supporting documents.</p>
            </div>
            <a class="casm-back" href="@Url.Action("AssignedToMeTable")"><i class="ri-arrow-left-line"></i>Back</a>
        </div>
    </div>

    <form id="assessmentForm" novalidate>

        <input type="hidden" name="Id" id="crIdField" value="@Model.CRID" />

        <div class="casm-grid">

            <!-- ============ Left: editable assessment ============ -->
            <div>

                <!-- 1. Implementer -->
                <section class="casm-sec">
                    <div class="casm-sec-head">
                        <span class="casm-step"><i class="ri-user-settings-line"></i></span>
                        <div>
                            <h5 class="casm-sec-title">Implementer</h5>
                            <p class="casm-sec-sub">Filled in automatically from your profile</p>
                        </div>
                    </div>
                    <div class="casm-sec-body">
                        <div class="casm-who">
                            <span class="casm-avatar">@Initials(username)</span>
                            <div>
                                <div class="casm-who-name" id="implementerName">@(string.IsNullOrWhiteSpace(username) ? "Unknown user" : username)</div>
                                <div class="casm-who-meta">
                                    @if (!string.IsNullOrWhiteSpace(designation))
                                    {
                                        <span id="implementerDesignation"><i class="ri-briefcase-line"></i>@designation</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(department))
                                    {
                                        <span id="implementerDepartment"><i class="ri-building-line"></i>@department</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(email))
                                    {
                                        <span id="implementerEmail"><i class="ri-mail-line"></i>@email</span>
                                    }
                                    <span><i class="ri-calendar-line"></i><span id="requestDate">@DateTime.Now.ToString("dd/MM/yyyy")</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. Plan -->
                <section class="casm-sec">
                    <div class="casm-sec-head">
                        <span class="casm-step"><i class="ri-list-check-2"></i></span>
                        <div>
                            <h5 class="casm-sec-title">Implementation plan</h5>
                            <p class="casm-sec-sub">Effort, activities and fixed asset details</p>
                        </div>
                    </div>
                    <div class="casm-sec-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label class="casm-label" for="effortEstimateDays">Effort estimate (days)</label>
                                <input type="number" name="EffortEstimateDays" id="effortEstimateDays"
                                       class="form-control casm-number-spin" min="0" max="200"
                                       value="@effortEstimateDays">
                                <div class="casm-field-error" id="err-effort"><i class="ri-error-warning-line"></i><span>Please enter an effort estimate between 1 and 200 days.</span></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="casm-label" for="activitiesTasks">Activities &amp; tasks</label>
                            <textarea name="ActivitiesTasks" id="activitiesTasks" class="form-control" rows="6"
                                      placeholder="Write the explanation here...">@Model.ActivitiesTasks</textarea>
                            <div class="casm-field-error" id="err-activities"><i class="ri-error-warning-line"></i><span>Please describe the activities and tasks.</span></div>
                        </div>
                        <div>
                            <label class="casm-label" for="fixedAssetInfo">Fixed asset information</label>
                            <textarea name="FixedAssetInfo" id="fixedAssetInfo" class="form-control" rows="6"
                                      placeholder="Write the explanation here...">@Model.FixedAssets</textarea>
                            <div class="casm-field-error" id="err-fixedAsset"><i class="ri-error-warning-line"></i><span>Please enter fixed asset information.</span></div>
                        </div>
                    </div>
                </section>

                <!-- 3. Documents -->
                <section class="casm-sec">
                    <div class="casm-sec-head">
                        <span class="casm-step"><i class="ri-file-upload-line"></i></span>
                        <div>
                            <h5 class="casm-sec-title">Supporting documents</h5>
                            <p class="casm-sec-sub">Attach the SRS and BA documents for this change</p>
                        </div>
                    </div>
                    <div class="casm-sec-body">
                        <div class="row g-3">
                            <div class="col-md-6" id="srsSection">
                                <label class="casm-label">SRS document</label>
                                <div class="casm-upload" id="srsUploadBox">
                                    <input type="file" name="srsFile" id="srsFileInput" class="form-control" multiple>
                                    @{
                                        RenderAttachmentList("existingSrsList", srsAttachments);
                                    }
                                </div>
                                <div class="casm-field-error" id="err-srs"><i class="ri-error-warning-line"></i><span>Please attach the SRS document.</span></div>
                            </div>

                            <div class="col-md-6" id="baSection">
                                <label class="casm-label">BA document</label>
                                <div class="casm-upload" id="baUploadBox">
                                    <input type="file" name="baFile" id="baFileInput" class="form-control" multiple>
                                    @{
                                        RenderAttachmentList("existingBaList", baAttachments);
                                    }
                                </div>
                                <div class="casm-field-error" id="err-ba"><i class="ri-error-warning-line"></i><span>Please attach the BA document.</span></div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- ============ Right: CR summary + vendor support ============ -->
            <aside class="casm-aside">

                <div class="casm-card">
                    <h6><i class="ri-checkbox-circle-line"></i>Your progress</h6>
                    <div class="casm-progress">
                        <div class="casm-ring-wrap" id="casmRingWrap">
                            <svg class="casm-ring" viewBox="0 0 100 100" aria-hidden="true">
                                <circle class="casm-ring-bg" cx="50" cy="50" r="44"></circle>
                                <circle class="casm-ring-fg" id="casmRingFg" cx="50" cy="50" r="44"></circle>
                            </svg>
                            <div class="casm-ring-num"><span><span id="casmPct">0</span><small>%</small></span></div>
                        </div>
                        <div class="casm-progress-text">
                            <strong id="casmHeadline">Let's get started</strong>
                            <span id="casmSubline">0 of 6 steps done</span>
                        </div>
                    </div>
                    <ul class="casm-checklist" id="casmChecklist">
                        <li data-key="effort"><i class="ri-check-line"></i>Effort estimate</li>
                        <li data-key="activities"><i class="ri-check-line"></i>Activities &amp; tasks</li>
                        <li data-key="fixedAsset"><i class="ri-check-line"></i>Fixed asset info</li>
                        <li data-key="srs"><i class="ri-check-line"></i>SRS document</li>
                        <li data-key="ba"><i class="ri-check-line"></i>BA document</li>
                        <li data-key="vendor"><i class="ri-check-line"></i>Vendor details</li>
                    </ul>
                </div>

                <div class="casm-card">
                    <h6><i class="ri-file-list-3-line"></i>Request summary</h6>
                    <span class="casm-pill"><i class="ri-flag-2-line"></i>@Model.Priority</span>
                    <span class="casm-pill"><i class="ri-git-branch-line"></i>@Model.ChangeType</span>

                    <div class="casm-kv">
                        <div class="casm-kv-row"><span class="casm-kv-label">CR Number</span><span class="casm-kv-val">@Model.CRNumber</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Title</span><span class="casm-kv-val">@Model.ChangeTitle</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Division</span><span class="casm-kv-val">@(string.IsNullOrEmpty(Model.Division) ? "—" : Model.Division)</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Module</span><span class="casm-kv-val">@Model.Module</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Status</span><span class="casm-kv-val">@Model.Status</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Requested by</span><span class="casm-kv-val">@Model.RequestedBy</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Requested date</span><span class="casm-kv-val">@Model.RequestedDate.ToString("yyyy/MM/dd")</span></div>
                        <div class="casm-kv-row"><span class="casm-kv-label">Approver</span><span class="casm-kv-val">@Model.ApproverUserName</span></div>
                    </div>

                    <div class="casm-summary-text">
                        <strong>Business justification</strong>
                        @Model.Summary
                    </div>
                </div>

                <div class="casm-card">
                    <h6><i class="ri-handshake-line"></i>Vendor support</h6>

                    <div class="casm-toggle">
                        <div class="casm-toggle-opt">
                            <input type="radio" id="vendorSupportYes" name="vendorSupport" value="yes"
                                   class="casm-toggle-input" checked="@hasVendorSupport">
                            <label class="casm-toggle-tile" for="vendorSupportYes"><i class="ri-check-line"></i>&nbsp;Yes</label>
                        </div>
                        <div class="casm-toggle-opt">
                            <input type="radio" id="vendorSupportNo" name="vendorSupport" value="no"
                                   class="casm-toggle-input" checked="@(!hasVendorSupport)">
                            <label class="casm-toggle-tile" for="vendorSupportNo"><i class="ri-close-line"></i>&nbsp;No</label>
                        </div>
                    </div>

                    <div id="vendorSupportDetails" class="mb-3"
                         style="display: @(hasVendorSupport ? "block" : "none");">
                        <label class="casm-label" for="VendorID">Vendor name</label>
                        <select id="VendorID" name="VendorID" class="form-control select2" data-toggle="select2">
                            <option value="" disabled hidden selected="@(!hasVendorSupport)">Select Vendor</option>
                            @if (vendors != null)
                            {
                                foreach (var vendor in vendors)
                                {
                                    <option value="@vendor.Id" selected="@(vendor.Id == selectedVendorId)">@vendor.VendorName</option>
                                }
                            }
                        </select>
                        <div class="casm-field-error" id="err-vendor"><i class="ri-error-warning-line"></i><span>Please select a vendor.</span></div>
                    </div>

                    <div id="proposalNumber" class="mb-3"
                         style="display: @(hasVendorSupport ? "block" : "none");">
                        <label class="casm-label" for="proposalNumberInput">Proposal number</label>
                        <input type="text" name="ProposalNumber" id="proposalNumberInput"
                               class="form-control" value="@Model.ProposalNumber">
                    </div>

                    <!-- Vendor attachments (field name must be "vendorFiles" to match the service) -->
                    <div id="attachmentSection" class="mb-0" style="display: @(hasVendorSupport ? "block" : "none");">
                        <label class="casm-label">Vendor attachments</label>
                        <div class="casm-upload">
                            <input type="file" name="vendorFiles" id="attachmentInput" class="form-control" multiple>
                            @{
                                RenderAttachmentList("existingAttachmentsList", vendorAttachments);
                            }
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Actions -->
        <div class="casm-actions">
            <button type="button"
                    class="btn btn-outline-danger"
                    onclick="window.location.href='@Url.Action("AssignedToMeTable")'">
                Cancel
            </button>

            <div class="d-flex gap-2">
                <button type="button"
                        id="btn-save"
                        class="btn btn-danger"
                        data-status="1">
                    <i class="ri-save-3-line me-1"></i>Save
                </button>

                <button type="submit"
                        id="submitBtn"
                        class="btn btn-primary"
                        data-status="2"
                        disabled>
                    <i class="ri-send-plane-line me-1"></i>Submit
                </button>
            </div>
        </div>
    </form>

    <!-- Attachment image preview modal -->
    <div class="modal fade" id="attachmentPreviewModal" tabindex="-1" aria-labelledby="attachmentPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="attachmentPreviewModalLabel">Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="attachmentPreviewImage" src="" class="img-fluid" alt="Attachment preview" style="max-height: 70vh;" />
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var selectedVendorId = @selectedVendorId;
            var saveBtn = document.getElementById('btn-save');
            var submitBtn = document.getElementById('submitBtn');
            var vendorYes = document.getElementById('vendorSupportYes');
            var vendorNo = document.getElementById('vendorSupportNo');
            var vendorDetails = document.getElementById('vendorSupportDetails');
            var proposalNumberDetails = document.getElementById('proposalNumber');
            var attachmentSection = document.getElementById('attachmentSection');
            var attachmentInput = document.getElementById('attachmentInput');
            var vendorSelect = document.getElementById('VendorID');

            function toggleVendorDetails() {
                var show = vendorYes.checked ? 'block' : 'none';
                vendorDetails.style.display = show;
                proposalNumberDetails.style.display = show;
                attachmentSection.style.display = show;

                // Clear the vendor selection and any chosen vendor files when support is
                // switched off, so stale values aren't posted back.
                if (!vendorYes.checked) {
                    if (attachmentInput) {
                        attachmentInput.value = '';
                    }

                    if (vendorSelect) {
                        if (window.jQuery && $(vendorSelect).data('select2')) {
                            $(vendorSelect).val('').trigger('change.select2');
                        } else {
                            vendorSelect.value = '';
                        }
                    }
                }
            }

            vendorYes.addEventListener('change', function () { toggleVendorDetails(); refreshProgress(); });
            vendorNo.addEventListener('change', function () { toggleVendorDetails(); refreshProgress(); });

            // Make sure select2 reflects the pre-selected vendor after it initialises.
            if (selectedVendorId > 0 && window.jQuery && $(vendorSelect).data('select2')) {
                $(vendorSelect).val(String(selectedVendorId)).trigger('change.select2');
            }

            // Re-validate whenever select2 changes the underlying <select> (native 'change'
            // doesn't always fire the same way for select2-driven updates).
            if (window.jQuery && $(vendorSelect).length) {
                $(vendorSelect).on('change', function () { refreshProgress(); });
            }

            // ---- Progress ring + checklist + inline validation ----
            var RING_LEN = 276.46;
            var effortInput = document.getElementById('effortEstimateDays');
            var activitiesInput = document.getElementById('activitiesTasks');
            var fixedAssetInput = document.getElementById('fixedAssetInfo');
            var srsFileInput = document.getElementById('srsFileInput');
            var baFileInput = document.getElementById('baFileInput');

            function hasExistingFiles(listId) {
                var list = document.getElementById(listId);
                return !!list && list.querySelectorAll('li').length > 0;
            }

            function hasNewFiles(input) {
                return !!(input && input.files && input.files.length > 0);
            }

            function showErr(key, isValid, $fieldEl) {
                var errEl = document.getElementById('err-' + key);
                if (errEl) { errEl.classList.toggle('is-visible', !isValid); }
                if ($fieldEl) { $fieldEl.classList.toggle('is-invalid', !isValid); }
            }

                        if (effortInput) {
                effortInput.addEventListener('keydown', function (e) {
                    var allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Tab', 'Home', 'End'];
                    if (allowedKeys.indexOf(e.key) !== -1 || e.ctrlKey || e.metaKey) {
                        return;
                    }

                    var hasSelection = this.selectionStart !== this.selectionEnd;
                    if (!hasSelection && this.value.replace('-', '').length >= 3 && /^[0-9]$/.test(e.key)) {
                        e.preventDefault();
                    }
                });

                effortInput.addEventListener('input', function () {
                    if (this.value.length > 3) {
                        this.value = this.value.slice(0, 3);
                    }
                });
            }

            function refreshProgress() {
                var effortValue = effortInput ? parseFloat(effortInput.value) : NaN;
                var effortOk = !isNaN(effortValue) && effortValue > 0 && effortValue <= 200;
                var activitiesOk = !!(activitiesInput && activitiesInput.value.trim().length > 0);
                var fixedAssetOk = !!(fixedAssetInput && fixedAssetInput.value.trim().length > 0);
                var srsOk = hasExistingFiles('existingSrsList') || hasNewFiles(srsFileInput);
                var baOk = hasExistingFiles('existingBaList') || hasNewFiles(baFileInput);
                var vendorOk = vendorNo.checked || (vendorYes.checked && !!vendorSelect.value);

                var state = {
                    effort: effortOk,
                    activities: activitiesOk,
                    fixedAsset: fixedAssetOk,
                    srs: srsOk,
                    ba: baOk,
                    vendor: vendorOk
                };

                var done = 0;
                var total = 0;
                document.querySelectorAll('#casmChecklist li').forEach(function (li) {
                    total++;
                    var ok = !!state[li.getAttribute('data-key')];
                    li.classList.toggle('is-done', ok);
                    if (ok) { done++; }
                });

                var pct = total ? Math.round(done / total * 100) : 0;
                document.getElementById('casmPct').textContent = pct;
                document.getElementById('casmRingFg').style.strokeDashoffset = RING_LEN * (1 - done / total);
                document.getElementById('casmRingWrap').classList.toggle('is-full', done === total);
                document.getElementById('casmSubline').textContent = done + ' of ' + total + ' steps done';
                document.getElementById('casmHeadline').textContent =
                    done === total ? 'Ready to submit' :
                    done === 0 ? "Let's get started" :
                    done >= Math.ceil(total * 0.6) ? 'Almost there' : 'Looking good';

                // ----- Inline field validation -----
                showErr('effort', effortOk, effortInput);
                showErr('activities', activitiesOk, activitiesInput);
                showErr('fixedAsset', fixedAssetOk, fixedAssetInput);
                showErr('srs', srsOk, null);
                document.getElementById('srsUploadBox').classList.toggle('is-invalid', !srsOk);
                showErr('ba', baOk, null);
                document.getElementById('baUploadBox').classList.toggle('is-invalid', !baOk);

                // Vendor error only matters while vendor support is "Yes"
                var vendorFieldInvalid = vendorYes.checked && !vendorSelect.value;
                showErr('vendor', !vendorFieldInvalid, vendorSelect);

                var allValid = effortOk && activitiesOk && fixedAssetOk && srsOk && baOk && vendorOk;
                submitBtn.disabled = !allValid;
                submitBtn.classList.toggle('disabled', !allValid);
            }

            ['input', 'change'].forEach(function (evt) {
                document.getElementById('assessmentForm').addEventListener(evt, refreshProgress);
            });

            refreshProgress();

            // ---- Function to handle both Save and Submit actions ----
            function handleFormSubmission(btnElement, isSubmit) {
                var crId = document.getElementById('crIdField').value;

                if (!crId) {
                    Swal.fire({
                        title: 'Could not submit',
                        text: 'Missing Change Request ID. Cannot submit the assessment.',
                        icon: 'error',
                        customClass: { confirmButton: 'btn btn-primary' },
                        buttonsStyling: false
                    });
                    return;
                }

                if (isSubmit) {
                    // Safety net: Submit is disabled while invalid, but re-check here too
                    // in case it was somehow re-enabled programmatically.
                    refreshProgress();
                    if (submitBtn.disabled) {
                        return;
                    }
                }

                function performSubmission() {
                    var assessmentForm = document.getElementById('assessmentForm');
                    var formData = new FormData(assessmentForm);
                    var statusValue = btnElement.getAttribute('data-status');
                    if (statusValue) {
                        formData.append('Status', statusValue);
                    }

                    btnElement.disabled = true;
                    var originalText = btnElement.textContent;
                    btnElement.textContent = 'Processing...';

                    $.ajax({
                        url: '@Url.Action("CreateAssessment", "CRManagement")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (data) {
                            if (!data.success) {
                                Swal.fire({
                                    title: 'Could not save',
                                    text: data.message || 'Failed to update Change Request assessment.',
                                    icon: 'error',
                                    customClass: { confirmButton: 'btn btn-primary' },
                                    buttonsStyling: false
                                });
                                return;
                            }

                            Swal.fire({
                                title: isSubmit ? 'Submitted!' : 'Saved!',
                                text: isSubmit
                                    ? 'CR assessment submitted successfully.'
                                    : (data.message || 'Assessment updated successfully.'),
                                icon: 'success',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            }).then(function () {
                                if (data.redirectUrl) {
                                    window.location.href = data.redirectUrl;
                                }
                            });
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message) ||
                                      'Failed to update the assessment. Please try again.';

                            Swal.fire({
                                title: 'Error',
                                text: msg,
                                icon: 'error',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            });
                        },
                        complete: function () {
                            btnElement.disabled = (btnElement === submitBtn) ? submitBtn.disabled : false;
                            btnElement.textContent = originalText;
                        }
                    });
                }

                if (isSubmit) {
                    // Simple confirmation before submitting (no IS Officer selection).
                    Swal.fire({
                        title: 'Submit this assessment?',
                        text: 'Once submitted, the Change Request will move to Security Assessment.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, submit',
                        cancelButtonText: 'Cancel',
                        customClass: { confirmButton: 'btn btn-primary me-2', cancelButton: 'btn btn-outline-secondary' },
                        buttonsStyling: false
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            performSubmission();
                        }
                    });
                } else {
                    performSubmission();
                }
            }

            submitBtn.addEventListener('click', function (e) {
                e.preventDefault();
                handleFormSubmission(submitBtn, true);
            });

            saveBtn.addEventListener('click', function (e) {
                e.preventDefault();
                handleFormSubmission(saveBtn, false);
            });

            // ---- Delete an existing attachment (works for SRS, BA and Vendor lists) ----
            document.querySelectorAll('.remove-attachment-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var attachmentId = btn.getAttribute('data-attachment-id');
                    var listItem = btn.closest('li');

                    Swal.fire({
                        title: 'Remove this attachment?',
                        text: 'This cannot be undone.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, remove it',
                        customClass: { confirmButton: 'btn btn-danger me-2', cancelButton: 'btn btn-outline-secondary' },
                        buttonsStyling: false
                    }).then(function (result) {
                        if (!result.isConfirmed) return;

                        $.ajax({
                            url: '@Url.Action("DeleteAttachment", "CRManagement")',
                            type: 'POST',
                            data: { id: attachmentId },
                            headers: {
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (data) {
                                if (data.success) {
                                    listItem.remove();
                                    refreshProgress();

                                    Swal.fire({
                                        title: 'Deleted!',
                                        text: data.message || 'Attachment removed successfully.',
                                        icon: 'success',
                                        customClass: { confirmButton: 'btn btn-primary' },
                                        buttonsStyling: false
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Could not remove',
                                        text: data.message || 'Failed to remove attachment.',
                                        icon: 'error',
                                        customClass: { confirmButton: 'btn btn-primary' },
                                        buttonsStyling: false
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: 'Error',
                                    text: 'Failed to remove attachment. Please try again.',
                                    icon: 'error',
                                    customClass: { confirmButton: 'btn btn-primary' },
                                    buttonsStyling: false
                                });
                            }
                        });
                    });
                });
            });

            // ---- Preview an image attachment in a modal ----
            document.querySelectorAll('.preview-attachment-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    var attachmentId = link.getAttribute('data-attachment-id');
                    var fileName = link.getAttribute('data-file-name');

                    var previewUrl = '@Url.Action("PreviewAttachment", "CRManagement")' + '?id=' + attachmentId;

                    var img = document.getElementById('attachmentPreviewImage');
                    img.src = previewUrl;

                    document.getElementById('attachmentPreviewModalLabel').textContent = fileName;

                    var modalEl = document.getElementById('attachmentPreviewModal');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                });
            });
        });
    </script>
}
