@model VF_CR_Management_System.Data.Models.ChangeRequest
@using VF_CR_Management_System.Data.Models
@{
    ViewData["Title"] = "CR Assessment";
    var vendors = ViewBag.Vendors as List<Vendor>;
    var effortEstimateDays = ViewBag.EffortEstimateDays as double? ?? 0;
    var approverUserName = ViewBag.ApproverUserName as string;

    // If VendorID is a non-nullable int on the model, use: int selectedVendorId = Model.VendorID;
    int selectedVendorId = Model.VendorID;
    var hasVendorSupport = selectedVendorId > 0;
}
@{
    var username = Context.Session.GetString("UserName");
    var designation = Context.Session.GetString("Designation");
    var department = Context.Session.GetString("Department");
    var email = Context.Session.GetString("Email");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title mb-0" id="assessmentHeader">
                    Section 2 : Change Assessment (Implementer) - @Model.CRNumber
                </h4>
            </div>

            <div class="card-body">
                <form id="assessmentForm">

                    <input type="hidden" name="Id" id="crIdField" value="@Model.CRID" />

                    <!-- Change Request details, bound directly from the model -->
                    <div class="card border mb-4">
                        <div class="card-header bg-light-subtle">
                            <h6 class="fs-15 mb-0">Change Request Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">CR Number:</label>
                                    <span>@Model.CRNumber</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Title:</label>
                                    <span>@Model.ChangeTitle</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Change Type:</label>
                                    <span>@Model.ChangeType</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Priority:</label>
                                    <span>@Model.Priority</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Division:</label>
                                    <span>@(string.IsNullOrEmpty(Model.Division) ? "—" : Model.Division)</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Module:</label>
                                    <span>@Model.Module</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Status:</label>
                                    <span>@Model.Status</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Requested By:</label>
                                    <span>@Model.RequestedBy</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Requested Date:</label>
                                    <span>@Model.RequestedDate.ToString("yyyy/MM/dd")</span>
                                </div>
                                <div class="col-md-3">
                                    <label class="fw-bold text-dark d-block mb-1">Approver:</label>
                                    <span>@Model.ApproverUserName</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Summary &amp; Business Justification:</label>
                                    <span>@Model.Summary</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">

                        <!-- Left Column -->
                        <div class="col-lg-6">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Implementer Name :</label>
                                    <span id="implementerName">@username</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Designation :</label>
                                    <span id="implementerDesignation">@designation</span>
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Department :</label>
                                    <span id="implementerDepartment">@department</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Email :</label>
                                    <span id="implementerEmail">@email</span>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold text-dark d-block mb-1">Request Date :</label>
                                    <span id="requestDate">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Effort Estimate ( Days )</label>
                                    <input type="number" name="EffortEstimateDays" id="effortEstimateDays"
                                           class="form-control" min="0" step="0.5"
                                           value="@effortEstimateDays">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Activities &amp; Tasks</label>
                                <textarea name="ActivitiesTasks" id="activitiesTasks" class="form-control" rows="6"
                                          placeholder="Write the explanation here...">@Model.ActivitiesTasks</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Fixed Asset Information</label>
                                <textarea name="FixedAssetInfo" id="fixedAssetInfo" class="form-control" rows="6"
                                          placeholder="Write the explanation here...">@Model.FixedAssets</textarea>
                            </div>
                            <div class="mb-3" id="modal-isofficer-wrapper" style="display:none;">
                                <div class="card-body">
                                    <label class="form-label" for="modal-approver">Select IS Officer</label>
                                    <select id="modal-isofficer" name="ISOfficerUserName" class="form-control select2" data-toggle="select2">
                                        <option value="" selected disabled hidden>Select User</option>
                                        @if (ViewBag.Users != null)
                                        {
                                            @foreach (var user in ViewBag.Users)
                                            {
                                                <option value="@user.UserName">@user.FirstName @user.LastName - @user.UserName</option>
                                            }
                                        }
                                    </select>
                                    <span id="modal-approver-error" class="text-danger d-none">Please select an user.</span>
                                </div>
                            </div>

                        </div>

                        <!-- Right Column -->
                        <div class="col-lg-6 d-flex flex-column">
                            <div class="card border mb-3 flex-fill">
                                <div class="card-header bg-light-subtle">
                                    <h6 class="fs-15 mb-0">Vendor Support</h6>
                                </div>
                                <div class="card-body">
                                    <label class="form-label">Vendor Support Required</label>
                                    <div class="mb-3">
                                        <div class="form-check form-check-inline">
                                            <input type="radio" id="vendorSupportYes" name="vendorSupport" value="yes"
                                                   class="form-check-input" checked="@hasVendorSupport">
                                            <label class="form-check-label" for="vendorSupportYes">Yes</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input type="radio" id="vendorSupportNo" name="vendorSupport" value="no"
                                                   class="form-check-input" checked="@(!hasVendorSupport)">
                                            <label class="form-check-label" for="vendorSupportNo">No</label>
                                        </div>
                                    </div>

                                    <div id="vendorSupportDetails" class="mb-3"
                                         style="display: @(hasVendorSupport ? "block" : "none");">
                                        <label class="form-label">Vendor Name</label>
                                        <select id="VendorID" name="VendorID" class="form-control select2" data-toggle="select2">
                                            <option value="" disabled hidden selected="@(!hasVendorSupport)">Select Vendor</option>
                                            @if (vendors != null)
                                            {
                                                foreach (var vendor in vendors)
                                                {
                                                    <option value="@vendor.Id" selected="@(vendor.Id == selectedVendorId)">@vendor.VendorName</option>
                                                }
                                            }
                                        </select>
                                        <span id="vendorIdError" class="text-danger"></span>
                                    </div>

                                    <div id="proposalNumber" class="mb-3"
                                         style="display: @(hasVendorSupport ? "block" : "none");">
                                        <label class="form-label">Proposal Number</label>
                                        <input type="text" name="ProposalNumber" id="proposalNumberInput"
                                               class="form-control" value="@Model.ProposalNumber">
                                    </div>

                                    <div id="attachmentSection" class="mb-3" style="display: @(hasVendorSupport ? "block" : "none");">
                                        <label class="form-label">Attachments</label>
                                        <input type="file" name="file" id="attachmentInput" class="form-control" multiple>

                                        @{
                                            var existingAttachments = ViewBag.Attachments as IEnumerable<VF_CR_Management_System.Data.Models.Attachment>;
                                        }
                                        @if (existingAttachments != null && existingAttachments.Any())
                                        {
                                            <div class="mt-2">
                                                <label class="form-label fw-bold mb-1">Previously Uploaded Files</label>
                                                <ul class="list-unstyled mb-0" id="existingAttachmentsList">
                                                    @foreach (var att in existingAttachments)
                                                    {
                                                        var ext = System.IO.Path.GetExtension(att.FileName).ToLowerInvariant();
                                                        var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
                                                        var isImage = imageExtensions.Contains(ext);
                                                        var isPdf = ext == ".pdf";

                                                        <li class="d-flex align-items-center gap-2 mb-1" data-attachment-id="@att.AttachmentID">
                                                            <i class="mdi mdi-paperclip"></i>

                                                            @if (isImage)
                                                            {
                                                                <a href="javascript:void(0);"
                                                                   class="preview-attachment-link"
                                                                   data-attachment-id="@att.AttachmentID"
                                                                   data-file-name="@att.FileName">
                                                                    @att.FileName
                                                                </a>
                                                            }
                                                            else if (isPdf)
                                                            {
                                                                <a href="@Url.Action("PreviewAttachment", "CRManagement", new { id = att.AttachmentID })"
                                                                   target="_blank"
                                                                   rel="noopener noreferrer">
                                                                    @att.FileName
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <a href="@Url.Action("DownloadAttachment", "CRManagement", new { id = att.AttachmentID })">
                                                                    @att.FileName
                                                                </a>
                                                            }

                                                            <small class="text-muted">(@att.UploadedDate.ToString("yyyy/MM/dd"))</small>
                                                            <a href="javascript:void(0);"
                                                               class="text-danger remove-attachment-btn"
                                                               title="Remove attachment"
                                                               data-attachment-id="@att.AttachmentID">
                                                                &times;
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <button type="button"
                                class="btn btn-outline-danger"
                                onclick="window.location.href='@Url.Action("AssessmentsTable")'">
                            Cancel
                        </button>

                        <div class="d-flex gap-2">
                            <button type="button"
                                    id="btn-save"
                                    class="btn btn-danger"
                                    data-status="1">
                                Save
                            </button>

                            <button type="submit"
                                    id="submitBtn"
                                    class="btn btn-primary"
                                    data-status="2">
                                Submit
                            </button>
                        </div>
                    </div>
                </form>
            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div><!-- end col -->
    <!-- Attachment image preview modal -->
    <div class="modal fade" id="attachmentPreviewModal" tabindex="-1" aria-labelledby="attachmentPreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="attachmentPreviewModalLabel">Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="attachmentPreviewImage" src="" class="img-fluid" alt="Attachment preview" style="max-height: 70vh;" />
                </div>
            </div>
        </div>
    </div>
</div><!-- end row -->

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var selectedVendorId = @selectedVendorId;

        var saveBtn = document.getElementById('btn-save');
        var submitBtn = document.getElementById('submitBtn');
        var vendorYes = document.getElementById('vendorSupportYes');
        var vendorNo = document.getElementById('vendorSupportNo');
        var vendorDetails = document.getElementById('vendorSupportDetails');
        var proposalNumberDetails = document.getElementById('proposalNumber');
        var attachmentSection = document.getElementById('attachmentSection');
        var vendorSelect = document.getElementById('VendorID');

        function toggleVendorDetails() {
            var show = vendorYes.checked ? 'block' : 'none';
            vendorDetails.style.display = show;
            proposalNumberDetails.style.display = show;
            attachmentSection.style.display = show;

            // Clear the vendor selection when support is switched off,
            // so a stale VendorID isn't posted back.
            if (!vendorYes.checked && vendorSelect) {
                if (window.jQuery && $(vendorSelect).data('select2')) {
                    $(vendorSelect).val('').trigger('change.select2');
                } else {
                    vendorSelect.value = '';
                }
            }
        }

        vendorYes.addEventListener('change', toggleVendorDetails);
        vendorNo.addEventListener('change', toggleVendorDetails);

        // Make sure select2 reflects the pre-selected vendor after it initialises.
        if (selectedVendorId > 0 && window.jQuery && $(vendorSelect).data('select2')) {
            $(vendorSelect).val(String(selectedVendorId)).trigger('change.select2');
        }

        // ---- Function to handle both Save and Submit actions ----
        function handleFormSubmission(btnElement, isSubmit) {
            var crId = document.getElementById('crIdField').value;

            if (!crId) {
                Swal.fire({
                    title: 'Could not submit',
                    text: 'Missing Change Request ID. Cannot submit the assessment.',
                    icon: 'error',
                    customClass: { confirmButton: 'btn btn-primary' },
                    buttonsStyling: false
                });
                return;
            }

            var vendorError = document.getElementById('vendorIdError');
            if (vendorError) { vendorError.textContent = ''; }

            if (vendorYes.checked && (!vendorSelect.value || vendorSelect.value === '')) {
                if (vendorError) { vendorError.textContent = 'Please select a vendor.'; }
                return;
            }

            function performSubmission() {
                var assessmentForm = document.getElementById('assessmentForm');
                var formData = new FormData(assessmentForm);
                var statusValue = btnElement.getAttribute('data-status');
                if (statusValue) {
                    formData.append('Status', statusValue);
                }

                btnElement.disabled = true;
                var originalText = btnElement.textContent;
                btnElement.textContent = 'Processing...';

                $.ajax({
                    url: '@Url.Action("CreateAssessment", "CRManagement")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (data) {
                        if (!data.success) {
                            Swal.fire({
                                title: 'Could not save',
                                text: data.message || 'Failed to update Change Request assessment.',
                                icon: 'error',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            });
                            return;
                        }

                        Swal.fire({
                            title: isSubmit ? 'Submitted!' : 'Saved!',
                            text: isSubmit
                                ? 'CR assessment submitted successfully.'
                                : (data.message || 'Assessment updated successfully.'),
                            icon: 'success',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        }).then(function () {
                            if (data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                            }
                        });
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) ||
                                  'Failed to update the assessment. Please try again.';

                        Swal.fire({
                            title: 'Error',
                            text: msg,
                            icon: 'error',
                            customClass: { confirmButton: 'btn btn-primary' },
                            buttonsStyling: false
                        });
                    },
                    complete: function () {
                        btnElement.disabled = false;
                        btnElement.textContent = originalText;
                    }
                });
            }

            if (isSubmit) {
                var isOfficerSelect = document.getElementById('modal-isofficer');
                var optionsHtml = isOfficerSelect.innerHTML;

                Swal.fire({
                    title: 'Submit this assessment?',
                    html:
                        '<p class="mb-3">Once submitted, the Change Request will move to Security Assessment.</p>' +
                        '<div class="text-start">' +
                            '<label class="form-label fw-bold" for="swal-isofficer">Select IS Officer</label>' +
                            '<select id="swal-isofficer" class="form-control select2" style="width:100%;">' + optionsHtml + '</select>' +
                            '<span id="swal-isofficer-error" class="text-danger d-none d-block mt-1">Please select an IS Officer.</span>' +
                        '</div>',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit',
                    cancelButtonText: 'Cancel',
                    customClass: { confirmButton: 'btn btn-primary me-2', cancelButton: 'btn btn-outline-secondary' },
                    buttonsStyling: false,
                    focusConfirm: false,
                    didOpen: function () {
                        $('#swal-isofficer').select2({
                            dropdownParent: $('.swal2-popup'),
                            placeholder: 'Select User',
                            width: '100%'
                        });

                        // Clear the error message as soon as a valid selection is made.
                        $('#swal-isofficer').on('change', function () {
                            if (this.value) {
                                document.getElementById('swal-isofficer-error').classList.add('d-none');
                            }
                        });
                    },
                    willClose: function () {
                        // Clean up select2 so a stale instance doesn't linger if the alert reopens.
                        if ($('#swal-isofficer').data('select2')) {
                            $('#swal-isofficer').select2('destroy');
                        }
                    },
                    preConfirm: function () {
                        var swalSelect = document.getElementById('swal-isofficer');
                        var errorSpan = document.getElementById('swal-isofficer-error');

                        if (!swalSelect.value) {
                            errorSpan.classList.remove('d-none');
                            return false; // keeps the alert open
                        }

                        return swalSelect.value;
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        isOfficerSelect.value = result.value;
                        performSubmission();
                    }
                });
            } else {
                performSubmission();
            }
        }

        submitBtn.addEventListener('click', function (e) {
            e.preventDefault();
            handleFormSubmission(submitBtn, true);
        });

        saveBtn.addEventListener('click', function (e) {
            e.preventDefault();
            handleFormSubmission(saveBtn, false);
        });

        // ---- Delete an existing attachment ----
        document.querySelectorAll('.remove-attachment-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var attachmentId = btn.getAttribute('data-attachment-id');
                var listItem = btn.closest('li');

                Swal.fire({
                    title: 'Remove this attachment?',
                    text: 'This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, remove it',
                    customClass: { confirmButton: 'btn btn-danger me-2', cancelButton: 'btn btn-outline-secondary' },
                    buttonsStyling: false
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("DeleteAttachment", "CRManagement")',
                        type: 'POST',
                        data: { id: attachmentId },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (data) {
                            if (data.success) {
                                listItem.remove();

                                Swal.fire({
                                    title: 'Deleted!',
                                    text: data.message || 'Attachment removed successfully.',
                                    icon: 'success',
                                    customClass: { confirmButton: 'btn btn-primary' },
                                    buttonsStyling: false
                                });
                            } else {
                                Swal.fire({
                                    title: 'Could not remove',
                                    text: data.message || 'Failed to remove attachment.',
                                    icon: 'error',
                                    customClass: { confirmButton: 'btn btn-primary' },
                                    buttonsStyling: false
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                title: 'Error',
                                text: 'Failed to remove attachment. Please try again.',
                                icon: 'error',
                                customClass: { confirmButton: 'btn btn-primary' },
                                buttonsStyling: false
                            });
                        }
                    });
                });
            });
        });

        // ---- Preview an image attachment in a modal ----
        document.querySelectorAll('.preview-attachment-link').forEach(function (link) {
            link.addEventListener('click', function () {
                var attachmentId = link.getAttribute('data-attachment-id');
                var fileName = link.getAttribute('data-file-name');

                var previewUrl = '@Url.Action("PreviewAttachment", "CRManagement")' + '?id=' + attachmentId;

                var img = document.getElementById('attachmentPreviewImage');
                img.src = previewUrl;

                document.getElementById('attachmentPreviewModalLabel').textContent = fileName;

                var modalEl = document.getElementById('attachmentPreviewModal');
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });
    });
</script>