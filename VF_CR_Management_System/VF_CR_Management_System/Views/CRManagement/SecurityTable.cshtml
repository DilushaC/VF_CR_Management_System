@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
    var currentEmpNo = ViewBag.CurrentEmpNo as string ?? string.Empty;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="header-title mb-0">Change Requests - Security</h4>
                </div>

                <style>
                    #basic-datatable {
                        border-collapse: separate;
                        border-spacing: 0;
                    }

                        #basic-datatable > thead > tr > th:last-child,
                        #basic-datatable > tbody > tr > td:last-child {
                            position: sticky;
                            right: 0;
                            z-index: 2;
                        }

                        #basic-datatable > thead > tr > th:last-child {
                            z-index: 3;
                            background-color: #fff;
                        }

                        #basic-datatable > tbody > tr > td:last-child {
                            background-color: #fff;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd) > td:last-child {
                            background-color: #f2f2f2;
                        }

                        #basic-datatable > tbody > tr:hover > td:last-child {
                            background-color: #ededed;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd):hover > td:last-child {
                            background-color: #e0e0e0;
                        }

                        #basic-datatable > thead > tr > th:last-child::before,
                        #basic-datatable > tbody > tr > td:last-child::before {
                            content: "";
                            position: absolute;
                            top: 0;
                            bottom: 0;
                            left: 0;
                            width: 8px;
                            box-shadow: inset 6px 0 6px -6px rgba(0, 0, 0, 0.25);
                            pointer-events: none;
                        }

                    #crDetailsModal .swal2-container {
                        position: fixed !important;
                        z-index: 1080 !important;
                    }

                    #basic-datatable td.title-cell {
                        max-width: 220px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }
                </style>

                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped nowrap w-100">
                        <thead>
                            <tr>
                                <th>CR Number</th>
                                <th>Title</th>
                                <th>Change Type</th>
                                <th>Division</th>
                                <th>Module</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Requested By</th>
                                <th>Requested Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var cr in Model)
                                {
                                    <tr>
                                        <td title="@cr.CRNumber">@cr.CRNumber</td>
                                        <td class="title-cell" title="@cr.ChangeTitle">@cr.ChangeTitle</td>
                                        <td>@cr.ChangeType</td>
                                        <td>@(string.IsNullOrEmpty(cr.Division) ? "—" : cr.Division)</td>
                                        <td>@cr.Module</td>
                                        <td>
                                            @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger">@cr.Priority</span>
                                            }
                                            else
                                            {
                                                @cr.Priority
                                            }
                                        </td>
                                        <td>
                                            @if (string.Equals(cr.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger"><i class="ri-close-line"></i> @cr.Status</span>
                                            }
                                            else if (string.Equals(cr.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-success">@cr.Status</span>
                                            }
                                            else if (string.Equals(cr.Status, "AssessmentDraft", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-warning">Draft</span>
                                            }
                                            else
                                            {
                                                @cr.Status
                                            }
                                        </td>
                                        <td>@cr.RequestedBy</td>
                                        <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                @if (cr.Status == "Assessment")
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-info btn-view"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#crDetailsModal"
                                                            data-bs-crid="@cr.CRID"
                                                            data-bs-crnumber="@cr.CRNumber"
                                                            data-bs-title="@cr.ChangeTitle"
                                                            data-bs-summary="@cr.Summary"
                                                            data-bs-changetype="@cr.ChangeType"
                                                            data-bs-division="@cr.Division"
                                                            data-bs-module="@cr.Module"
                                                            data-bs-priority="@cr.Priority"
                                                            data-bs-status="@cr.Status"
                                                            data-bs-requestedby="@cr.RequestedBy"
                                                            data-bs-requesteddate="@cr.RequestedDate.ToString("yyyy/MM/dd")"
                                                            data-bs-currentapprover="@cr.ApproverUserName"
                                                            data-bs-activities="@cr.ActivitiesTasks"
                                                            data-bs-fixedAssets="@cr.FixedAssets"
                                                            title="View">
                                                        <i class="ri-login-box-line"></i>
                                                    </button>
                                                }
                                                @if (cr.Status == "AssessmentDraft")
                                                {
                                                    <div class="d-flex gap-1">
                                                        <a href="@Url.Action("EditSecurity", "CRManagement", new { id = cr.CRID })"
                                                           class="btn btn-sm btn-outline-primary"
                                                           title="Edit">
                                                            <i class="ri-edit-line"></i>
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CR Details Modal (read-only view, populated via event.relatedTarget) -->
<div class="modal fade" id="crDetailsModal" tabindex="-1" aria-labelledby="crDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crDetailsModalLabel">Change Request Details</h5>
                <div class="ms-auto d-flex align-items-center">
                    <label class="col-form-label fw-semibold me-2">CR Number:</label>
                    <span id="modal-crnumber" class="fw-bold"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Title:</label>
                        <span id="modal-title"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Status:</label>
                        <span id="modal-status"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Change Type:</label>
                        <span id="modal-changetype"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Priority:</label>
                        <span id="modal-priority"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Division:</label>
                        <span id="modal-division"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Module:</label>
                        <span id="modal-module"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Requested By:</label>
                        <span id="modal-requestedby"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Approver:</label>
                        <span id="modal-currentapprover"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Requested Date:</label>
                        <span id="modal-requesteddate"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Summary &amp; Business Justification:</label>
                        <span id="modal-summary"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Activities & Tasks</label>
                        <span id="modal-activities"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="fw-bold text-dark d-block mb-1">Fixed Assets</label>
                        <span id="modal-fixedAssets"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="modal-security-assessment-btn" href="#" class="btn btn-primary d-none">
                    <i class="ri-shield-check-line me-1"></i> Proceed to Security Assessment
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        var currentEmpNo = '@currentEmpNo';

        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: false,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                order: [[8, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 9 },
                    { orderable: false, targets: 1 }
                ]
            });
        });

        var crDetailsModal = document.getElementById('crDetailsModal');
        var $approveBtn = $('#modal-approve-btn');
        var $rejectBtn = $('#modal-reject-btn');
        var $approverWrapper = $('#modal-approver-wrapper');
        var $assessmentBtn = $('#modal-assessment-btn');
        var $securityAssessmentBtn = $('#modal-security-assessment-btn');

        var assessmentUrlBase = '@Url.Action("Assessment", "CRManagement")';
        var securityAssessmentUrlBase = '@Url.Action("SecurityAssessment", "CRManagement")'; // Change controller/action if needed

        function normalize(value) {
            return (value || '').trim().toLowerCase();
        }

        crDetailsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var crid = button.getAttribute('data-bs-crid');
            var crnumber = button.getAttribute('data-bs-crnumber');
            var title = button.getAttribute('data-bs-title');
            var summary = button.getAttribute('data-bs-summary');
            var changetype = button.getAttribute('data-bs-changetype');
            var priority = button.getAttribute('data-bs-priority');
            var division = button.getAttribute('data-bs-division');
            var module = button.getAttribute('data-bs-module');
            var status = button.getAttribute('data-bs-status');
            var requestedby = button.getAttribute('data-bs-requestedby');
            var requesteddate = button.getAttribute('data-bs-requesteddate');
            var currentApprover = button.getAttribute('data-bs-currentapprover');
            var activities = button.getAttribute('data-bs-activities');
            var fixedAssets = button.getAttribute('data-bs-fixedAssets');

            crDetailsModal.querySelector('#modal-crnumber').textContent = crnumber || '';
            crDetailsModal.querySelector('#modal-title').textContent = title || '';
            crDetailsModal.querySelector('#modal-status').textContent = status || '';
            crDetailsModal.querySelector('#modal-changetype').textContent = changetype || '';
            crDetailsModal.querySelector('#modal-priority').textContent = priority || '';
            crDetailsModal.querySelector('#modal-division').textContent = division || '';
            crDetailsModal.querySelector('#modal-module').textContent = module || '';
            crDetailsModal.querySelector('#modal-requestedby').textContent = requestedby || '';
            crDetailsModal.querySelector('#modal-requesteddate').textContent = requesteddate || '';
            crDetailsModal.querySelector('#modal-summary').textContent = summary || '';
            crDetailsModal.querySelector('#modal-currentapprover').textContent = currentApprover || '';
            crDetailsModal.querySelector('#modal-activities').textContent = activities || '';
            crDetailsModal.querySelector('#modal-fixedAssets').textContent = fixedAssets || '';

            $(crDetailsModal).data('crid', crid);

            var normalizedStatus = normalize(status);
            var isDecided = normalizedStatus === 'approved' || normalizedStatus === 'rejected';

            var canAct = !isDecided &&
                normalize(currentApprover) !== '' &&
                normalize(currentEmpNo) !== '' &&
                normalize(currentApprover) === normalize(currentEmpNo);

            if (canAct) {
                $approveBtn.removeClass('d-none');
                $rejectBtn.removeClass('d-none');
                $approverWrapper.removeClass('d-none');
            } else {
                $approveBtn.addClass('d-none');
                $rejectBtn.addClass('d-none');
                $approverWrapper.addClass('d-none');
            }

            // Show "Go to Assessment" if status is "approved"
            if (normalizedStatus === 'approved') {
                $assessmentBtn
                    .attr('href', assessmentUrlBase + '?id=' + encodeURIComponent(crid || ''))
                    .removeClass('d-none');
            } else {
                $assessmentBtn.addClass('d-none');
            }

            // Show "Proceed to Security Assessment" if status is "assessment"
            if (normalizedStatus === 'assessment') {
                $securityAssessmentBtn
                    .attr('href', securityAssessmentUrlBase + '?id=' + encodeURIComponent(crid || ''))
                    .removeClass('d-none');
            } else {
                $securityAssessmentBtn.addClass('d-none');
            }

            $('#modal-approver').val('').trigger('change');
            $('#modal-approver-error').addClass('d-none');
        });

        $(crDetailsModal).on('shown.bs.modal', function () {
            if ($('#modal-approver').length) {
                $('#modal-approver').select2({
                    dropdownParent: $(crDetailsModal)
                });
            }
        });
    </script>
}