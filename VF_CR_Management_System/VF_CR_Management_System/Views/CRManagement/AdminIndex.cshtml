@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="header-title mb-0">Change Requests</h4>

                    <ul class="nav nav-pills mb-0 cr-filter-tabs" id="crFilterTabs">
                        <li class="nav-item">
                            <a href="#" data-filter="all" aria-expanded="@(currentFilter == "all" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "all" ? "active" : "")">
                                All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" data-filter="createdByMe" aria-expanded="@(currentFilter == "createdByMe" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "createdByMe" ? "active" : "")">
                                Created by Me
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" data-filter="assignedToMe" aria-expanded="@(currentFilter == "assignedToMe" ? "true" : "false")"
                               class="nav-link rounded-0 @(currentFilter == "assignedToMe" ? "active" : "")">
                                Assigned to Me
                            </a>
                        </li>
                    </ul>
                </div>

                <style>
                    .cr-filter-tabs {
                        gap: 0.5rem;
                    }

                        .cr-filter-tabs .nav-item .nav-link {
                            font-size: 0.8125rem !important;
                            padding: 0.3rem 0.75rem !important;
                            color: #7a3b47 !important;
                            background-color: #f7eef0 !important;
                            font-weight: 500;
                            border: none;
                            border-radius: 0.25rem;
                        }

                            .cr-filter-tabs .nav-item .nav-link:hover {
                                background-color: #e3c3ca !important;
                                color: #7a3b47 !important;
                            }

                            .cr-filter-tabs .nav-item .nav-link.active {
                                background-color: #8f3b4c !important;
                                color: #ffffff !important;
                            }

                    /* Fix: when SweetAlert2 is targeted at a Bootstrap modal to avoid its
                                                               focus-trap (Bootstrap otherwise yanks focus back to the modal on
                                                               every keystroke, making the reject textarea untypeable), force the
                                                               swal container back to a normal fixed, full-screen overlay instead
                                                               of being confined/clipped by the modal's box. */
                    #crDetailsModal .swal2-container {
                        position: fixed !important;
                        z-index: 1080 !important; /* above Bootstrap modal (1055) and its backdrop (1050) */
                    }
                </style>

                <table id="basic-datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>CR Number</th>
                            <th>Change Type</th>
                            <th>Priority</th>
                            <th>Module</th>
                            <th>Status</th>
                            <th>Requested By</th>
                            <th>Requested Date</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var cr in Model)
                            {
                                var isDraft = cr.CRNumber != null &&
                                cr.CRNumber.StartsWith("Waiting", StringComparison.OrdinalIgnoreCase);
                                var displayCrNumber = isDraft ? "WAITING" : cr.CRNumber;
                                <tr>
                                    <td title="@cr.CRNumber">@displayCrNumber</td>
                                    <td>@cr.ChangeType</td>
                                    <td>
                                        @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">@cr.Priority</span>
                                        }
                                        else
                                        {
                                            @cr.Priority
                                        }
                                    </td>
                                    <td>@cr.Module</td>
                                    <td>
                                        @if (string.Equals(cr.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning">@cr.Status</span>
                                        }
                                        else if (string.Equals(cr.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger"><i class="ri-close-line"></i> @cr.Status</span>
                                        }
                                        else if (string.Equals(cr.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">@cr.Status</span>
                                        }
                                        else
                                        {
                                            @cr.Status
                                        }
                                    </td>
                                    <td>@cr.RequestedBy</td>
                                    <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <!-- Eye button now opens the details modal instead of navigating to Edit -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info btn-view"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#crDetailsModal"
                                                    data-bs-crid="@cr.CRID"
                                                    data-bs-crnumber="@displayCrNumber"
                                                    data-bs-summary="@cr.Summary"
                                                    data-bs-changetype="@cr.ChangeType"
                                                    data-bs-priority="@cr.Priority"
                                                    data-bs-module="@cr.Module"
                                                    data-bs-status="@cr.Status"
                                                    data-bs-requestedby="@cr.RequestedBy"
                                                    data-bs-requesteddate="@cr.RequestedDate.ToString("yyyy/MM/dd")"
                                                    title="View">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div> <!-- end card body-->
        </div> <!-- end card -->
    </div><!-- end col-->
</div> <!-- end row-->
<!-- CR Details Modal (read-only view, populated via event.relatedTarget) -->
<div class="modal fade" id="crDetailsModal" tabindex="-1" aria-labelledby="crDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crDetailsModalLabel">Change Request Details</h5>
                <div class="ms-auto d-flex align-items-center">
                    <label class="col-form-label fw-semibold me-2">CR Number:</label>
                    <span id="modal-crnumber" class="fw-bold"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Status:</label>
                        <input type="text" class="form-control" id="modal-status" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Change Type:</label>
                        <input type="text" class="form-control" id="modal-changetype" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Priority:</label>
                        <input type="text" class="form-control" id="modal-priority" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Module:</label>
                        <input type="text" class="form-control" id="modal-module" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Requested By:</label>
                        <input type="text" class="form-control" id="modal-requestedby" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Requested Date:</label>
                        <input type="text" class="form-control" id="modal-requesteddate" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label fw-semibold">Summary &amp; Business Justification:</label>
                        <textarea class="form-control" id="modal-summary" rows="4" readonly></textarea>
                    </div>
                    <div class="col-md-6" id="modal-approver-wrapper">
                        <div class="card-body">
                            <label class="form-label" for="modal-approver">Select Implementer</label>
                            <select id="modal-approver" name="ApproverID" class="form-control select2" data-toggle="select2">
                                <option value="" selected disabled hidden>Select User</option>
                                @if (ViewBag.Users != null)
                                {
                                    @foreach (var user in ViewBag.Users)
                                    {
                                        <option value="@user.UserName">@user.FirstName @user.LastName</option>
                                    }
                                }
                            </select>
                            <span id="modal-approver-error" class="text-danger d-none">Please select an user.</span>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="modal-approve-btn" class="btn btn-success" data-action="approve">Approve</button>
                <button type="button" id="modal-reject-btn" class="btn btn-danger" data-action="reject">Reject</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/vendor/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: true
            });

            $('#crFilterTabs').on('click', 'a.nav-link', function (e) {
                e.preventDefault();
                var selected = $(this).data('filter');
                window.location.href = '@Url.Action("Index", "CRManagement")' + '?filter=' + selected;
            });

            $('#basic-datatable').on('click', '.btn-reject', function () {
                var id = $(this).data('id');
                if (confirm('Are you sure you want to reject this Change Request?')) {
                    $.ajax({
                        url: '@Url.Action("Reject", "CRManagement")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            location.reload();
                        },
                        error: function () {
                            alert('Failed to reject the CR. Please try again.');
                        }
                    });
                }
            });
        });

        // Populate the CR Details modal from the button that triggered it
        // (event.relatedTarget), same pattern as the Bootstrap "varied modal" example.
        var crDetailsModal = document.getElementById('crDetailsModal');
        var $approveBtn = $('#modal-approve-btn');
        var $rejectBtn = $('#modal-reject-btn');

        // Toggle the footer buttons between Approve/Reject and Submit/Delete
        // depending on whether the CR Number being shown is "WAITING".
        // If the CR is already Approved or Rejected, hide both action buttons
        // entirely — only the Close button should remain.
        function updateCrModalButtons(crnumber, status) {
            var isFinal = status && (
                status.trim().toUpperCase() === 'APPROVED' ||
                status.trim().toUpperCase() === 'REJECTED'
            );

            if (isFinal) {
                $approveBtn.addClass('d-none');
                $rejectBtn.addClass('d-none');
                $('#modal-approver-wrapper').addClass('d-none');
                $('#modal-approver-error').addClass('d-none');
                return;
            }

            // Not a final state — show the buttons again and set their mode
            $approveBtn.removeClass('d-none');
            $rejectBtn.removeClass('d-none');

            var isWaiting = (crnumber || '').trim().toUpperCase() === 'WAITING';

            if (isWaiting) {
                $approveBtn.text('Submit').removeClass('btn-success').addClass('btn-primary').data('action', 'submit');
                $rejectBtn.text('Delete').data('action', 'delete');

                // A CR that hasn't been submitted yet doesn't need an implementer picked.
                $('#modal-approver-wrapper').addClass('d-none');
                $('#modal-approver-error').addClass('d-none');
            } else {
                $approveBtn.text('Approve').removeClass('btn-primary').addClass('btn-success').data('action', 'approve');
                $rejectBtn.text('Reject').data('action', 'reject');

                $('#modal-approver-wrapper').removeClass('d-none');
            }
        }

        crDetailsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            // Read all data attributes FIRST, then use them.
            var crid = button.getAttribute('data-bs-crid');
            var crnumber = button.getAttribute('data-bs-crnumber');
            var summary = button.getAttribute('data-bs-summary');
            var changetype = button.getAttribute('data-bs-changetype');
            var priority = button.getAttribute('data-bs-priority');
            var module = button.getAttribute('data-bs-module');
            var status = button.getAttribute('data-bs-status');
            var requestedby = button.getAttribute('data-bs-requestedby');
            var requesteddate = button.getAttribute('data-bs-requesteddate');

            // #modal-crnumber is a <span>, not an <input>, so use textContent (not .value)
            crDetailsModal.querySelector('#modal-crnumber').textContent = crnumber || '';
            crDetailsModal.querySelector('#modal-status').value = status || '';
            crDetailsModal.querySelector('#modal-changetype').value = changetype || '';
            crDetailsModal.querySelector('#modal-priority').value = priority || '';
            crDetailsModal.querySelector('#modal-module').value = module || '';
            crDetailsModal.querySelector('#modal-requestedby').value = requestedby || '';
            crDetailsModal.querySelector('#modal-requesteddate').value = requesteddate || '';
            crDetailsModal.querySelector('#modal-summary').value = summary || '';

            // Track which CR this modal instance is currently showing, so the
            // footer buttons below know which CRID to submit.
            $(crDetailsModal).data('crid', crid);

            // Reset the approver dropdown for each new CR opened
            $('#modal-approver').val('').trigger('change');
            $('#modal-approver-error').addClass('d-none');

            // Swap Approve/Reject <-> Submit/Delete based on the CR Number shown,
            // or hide both if the CR is already Approved/Rejected.
            updateCrModalButtons(crnumber, status);

            var editLink = crDetailsModal.querySelector('#modal-edit-link');
            if (editLink) {
                editLink.setAttribute('href', '@Url.Action("Edit", "CRManagement")' + '/' + crid);
            }
        });

        // select2 needs to be (re)initialized after the modal is in the DOM/visible,
        // otherwise the dropdown widget can render with zero width inside a modal.
        $(crDetailsModal).on('shown.bs.modal', function () {
            $('#modal-approver').select2({
                dropdownParent: $(crDetailsModal)
            });
        });

        // Single click handler for the left footer button; branches on data-action
        // so it works as either "Approve" or "Submit" depending on the CR state.
        $approveBtn.on('click', function () {
            var action = $(this).data('action');
            var crid = $(crDetailsModal).data('crid');

            if (action === 'submit') {
                Swal.fire({
                    target: crDetailsModal, // keeps SweetAlert inside the modal's DOM subtree so Bootstrap's focus-trap doesn't fight it
                    title: 'Submit this Change Request?',
                    text: 'This will send the draft CR forward for processing.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit it',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("Submit", "CRManagement")',
                        type: 'POST',
                        data: { id: crid },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            Swal.fire({
                                target: crDetailsModal,
                                title: 'Submitted!',
                                text: 'The Change Request has been submitted.',
                                icon: 'success'
                            }).then(function () { location.reload(); });
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to submit the CR. Please try again.';
                            Swal.fire({
                                target: crDetailsModal,
                                title: 'Error',
                                text: msg,
                                icon: 'error'
                            });
                        }
                    });
                });
                return;
            }

            // Default: Approve flow (requires an implementer to be selected)
            var approverId = $('#modal-approver').val();

            if (!approverId) {
                $('#modal-approver-error').removeClass('d-none');
                return;
            }
            $('#modal-approver-error').addClass('d-none');

            Swal.fire({
                target: crDetailsModal,
                title: 'Approve this Change Request?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, approve it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#0acf97',
                cancelButtonColor: '#6c757d'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("Approve", "CRManagement")',
                    type: 'POST',
                    data: { id: crid, ApproverID: approverId },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function () {
                        Swal.fire({
                            target: crDetailsModal,
                            title: 'Approved!',
                            text: 'The Change Request has been approved.',
                            icon: 'success'
                        }).then(function () { location.reload(); });
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to approve the CR. Please try again.';
                        Swal.fire({
                            target: crDetailsModal,
                            title: 'Error',
                            text: msg,
                            icon: 'error'
                        });
                    }
                });
            });
        });

        // Single click handler for the right footer button; branches on data-action
        // so it works as either "Reject" or "Delete" depending on the CR state.
        $rejectBtn.on('click', function () {
            var action = $(this).data('action');
            var crid = $(crDetailsModal).data('crid');

            if (action === 'delete') {
                Swal.fire({
                    target: crDetailsModal,
                    title: 'Delete this Change Request?',
                    text: 'This will permanently remove the draft CR. This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#fa5c7c',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("Delete", "CRManagement")',
                        type: 'POST',
                        data: { id: crid },
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function () {
                            Swal.fire({
                                target: crDetailsModal,
                                title: 'Deleted',
                                text: 'The Change Request has been deleted.',
                                icon: 'success'
                            }).then(function () { location.reload(); });
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to delete the CR. Please try again.';
                            Swal.fire({
                                target: crDetailsModal,
                                title: 'Error',
                                text: msg,
                                icon: 'error'
                            });
                        }
                    });
                });
                return;
            }

            // Default: Reject flow (asks for a reason)
            Swal.fire({
                target: crDetailsModal, // <-- this is the actual fix for "can't type in the textarea"
                title: 'Reject this Change Request?',
                input: 'textarea',
                inputPlaceholder: 'Enter reason for rejection...',
                inputAttributes: { 'aria-label': 'Rejection reason' },
                showCancelButton: true,
                confirmButtonText: 'Yes, reject it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#fa5c7c',
                cancelButtonColor: '#6c757d',
                inputValidator: function (value) {
                    if (!value || !value.trim()) {
                        return 'Please provide a reason for rejection.';
                    }
                }
            }).then(function (result) {
                if (!result.isConfirmed) return;
                var reason = result.value;

                $.ajax({
                    url: '@Url.Action("Reject", "CRManagement")',
                    type: 'POST',
                    data: { id: crid, RejectReason: reason },
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function () {
                        Swal.fire({
                            target: crDetailsModal,
                            title: 'Rejected',
                            text: 'The Change Request has been rejected.',
                            icon: 'success'
                        }).then(function () { location.reload(); });
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to reject the CR. Please try again.';
                        Swal.fire({
                            target: crDetailsModal,
                            title: 'Error',
                            text: msg,
                            icon: 'error'
                        });
                    }
                });
            });
        });
    </script>
}