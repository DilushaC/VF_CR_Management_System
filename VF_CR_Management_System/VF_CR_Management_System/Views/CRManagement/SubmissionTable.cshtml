@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="header-title mb-0">Pending Approvals & Approved</h4>
                </div>

                <style>
                    #basic-datatable {
                        border-collapse: separate;
                        border-spacing: 0;
                    }

                        #basic-datatable > thead > tr > th:last-child,
                        #basic-datatable > tbody > tr > td:last-child {
                            position: sticky;
                            right: 0;
                            z-index: 2;
                        }

                        #basic-datatable > thead > tr > th:last-child {
                            z-index: 3;
                            background-color: #fff;
                        }

                        #basic-datatable > tbody > tr > td:last-child {
                            background-color: #fff;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd) > td:last-child {
                            background-color: #f2f2f2;
                        }

                        #basic-datatable > tbody > tr:hover > td:last-child {
                            background-color: #ededed;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd):hover > td:last-child {
                            background-color: #e0e0e0;
                        }

                        #basic-datatable > thead > tr > th:last-child::before,
                        #basic-datatable > tbody > tr > td:last-child::before {
                            content: "";
                            position: absolute;
                            top: 0;
                            bottom: 0;
                            left: 0;
                            width: 8px;
                            box-shadow: inset 6px 0 6px -6px rgba(0, 0, 0, 0.25);
                            pointer-events: none;
                        }

                    #crDetailsModal .swal2-container {
                        position: fixed !important;
                        z-index: 1080 !important;
                    }

                    #basic-datatable td.title-cell {
                        max-width: 220px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }
                </style>

                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped nowrap w-100">
                        <thead>
                            <tr>
                                <th>CR Number</th>
                                <th>Title</th>
                                <th>Change Type</th>
                                <th>Division</th>
                                <th>Module</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Requested By</th>
                                <th>Requested Date</th>
                                <th>View</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var cr in Model)
                                {
                                    <tr>
                                        <td title="@cr.CRNumber">@cr.CRNumber</td>
                                        <td class="title-cell" title="@cr.ChangeTitle">@cr.ChangeTitle</td>
                                        <td>@cr.ChangeType</td>
                                        <td>@(string.IsNullOrEmpty(cr.Division) ? "—" : cr.Division)</td>
                                        <td>@cr.Module</td>
                                        <td>
                                            @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger">@cr.Priority</span>
                                            }
                                            else
                                            {
                                                @cr.Priority
                                            }
                                        </td>
                                        <td>
                                            @if (string.Equals(cr.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-success">@cr.Status</span>
                                            }
                                            else if (string.Equals(cr.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger">@cr.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@cr.Status</span>
                                            }
                                        </td>
                                        <td>@cr.RequestedBy</td>
                                        <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button type="button"
                                                        class="btn btn-sm btn-info btn-view"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#crDetailsModal"
                                                        data-bs-crid="@cr.CRID"
                                                        title="View">
                                                    <i class="ri-eye-line"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CR Details Modal shell — content is loaded from the partial via AJAX -->
<div class="modal fade" id="crDetailsModal" tabindex="-1" aria-labelledby="crDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="crDetailsModalContent">
            <!-- populated by AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: false,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                order: [[8, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 9 },
                    { orderable: false, targets: 1 }
                ]
            });
        });

        var crDetailsModal = document.getElementById('crDetailsModal');
        var $modalContent = $('#crDetailsModalContent');
        var partialUrlBase = '@Url.Action("CRDetailsPartial", "CRManagement")';

        // Single source of truth for the currently-open CR's id.
        var currentCrId = null;

        // Load the partial fresh every time the modal opens.
        crDetailsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) {
                console.error('crDetailsModal opened without a relatedTarget button.');
                return;
            }

            var rawCrid = button.getAttribute('data-bs-crid');
            currentCrId = parseInt(rawCrid, 10);
            if (isNaN(currentCrId) || currentCrId <= 0) {
                currentCrId = null;
            }

            $modalContent.html(
                '<div class="modal-body text-center py-5">' +
                '<div class="spinner-border text-primary" role="status"></div></div>'
            );

            if (!currentCrId) {
                $modalContent.html('<div class="modal-body text-danger">Invalid Change Request.</div>');
                return;
            }

            $.get(partialUrlBase, { id: currentCrId })
                .done(function (html) {
                    $modalContent.html(html);

                    // Initialize select2 here, now that the dropdown actually exists in the DOM.
                    var $approver = $('#modal-approver');
                    if ($approver.length) {
                        $approver.select2({
                            dropdownParent: $(crDetailsModal),
                            width: '100%'
                        });
                    }
                })
                .fail(function () {
                    $modalContent.html('<div class="modal-body text-danger">Failed to load Change Request details.</div>');
                });
        });

        $(crDetailsModal).on('hidden.bs.modal', function () {
            currentCrId = null;
            $modalContent.empty();
        });


        // Approve/Reject buttons are injected dynamically by the partial, so bind
        // via delegation on the static modal container rather than on the buttons directly.
        $modalContent.on('click', '#modal-approve-btn', function () {
            if (!currentCrId) {
                Swal.fire({ target: crDetailsModal, title: 'Could not approve', text: 'No valid Change Request ID was found. Please close this dialog and try again.', icon: 'error' });
                return;
            }

            var approverId = $('#modal-approver').val();
            if (!approverId) {
                $('#modal-approver-error').removeClass('d-none');
                return;
            }
            $('#modal-approver-error').addClass('d-none');

            Swal.fire({
                target: crDetailsModal,
                title: 'Approve this Change Request?',
                text: 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, approve it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#0acf97',
                cancelButtonColor: '#6c757d'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("Approve", "CRManagement")',
                    type: 'POST',
                    data: { id: currentCrId, ApproverID: approverId },
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function () {
                        Swal.fire({ target: crDetailsModal, title: 'Approved!', text: 'The Change Request has been approved.', icon: 'success' })
                            .then(function () { location.reload(); });
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to approve the CR. Please try again.';
                        Swal.fire({ target: crDetailsModal, title: 'Error', text: msg, icon: 'error' });
                    }
                });
            });
        });

        $modalContent.on('click', '#modal-reject-btn', function () {
            if (!currentCrId) {
                Swal.fire({ target: crDetailsModal, title: 'Could not reject', text: 'No valid Change Request ID was found. Please close this dialog and try again.', icon: 'error' });
                return;
            }

            Swal.fire({
                target: crDetailsModal,
                title: 'Reject this Change Request?',
                input: 'textarea',
                inputPlaceholder: 'Enter reason for rejection...',
                inputAttributes: { 'aria-label': 'Rejection reason' },
                showCancelButton: true,
                confirmButtonText: 'Yes, reject it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#fa5c7c',
                cancelButtonColor: '#6c757d',
                inputValidator: function (value) {
                    if (!value || !value.trim()) return 'Please provide a reason for rejection.';
                }
            }).then(function (result) {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '@Url.Action("Reject", "CRManagement")',
                    type: 'POST',
                    data: { id: currentCrId, RejectReason: result.value },
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function () {
                        Swal.fire({ target: crDetailsModal, title: 'Rejected', text: 'The Change Request has been rejected.', icon: 'success' })
                            .then(function () { location.reload(); });
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to reject the CR. Please try again.';
                        Swal.fire({ target: crDetailsModal, title: 'Error', text: msg, icon: 'error' });
                    }
                });
            });
        });
    </script>
}