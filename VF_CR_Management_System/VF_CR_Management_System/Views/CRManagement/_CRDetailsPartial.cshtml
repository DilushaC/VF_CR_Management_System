                title: false,
                html: `
                    <div class="uat-swal">
                        <div class="uat-swal-icon uat-swal-icon-security">
                            <i class="ri-shield-user-line"></i>
                        </div>
                        <h3 class="uat-swal-title">Accept Assessment</h3>
                        <p class="uat-swal-sub">Choose the IS Officer who should receive this Change Request next.</p>

                        <div class="uat-swal-group">
                            <label class="uat-swal-label" for="swal-security-select">
                                <i class="ri-shield-check-line"></i> IS Officer
                            </label>
                            <select id="swal-security-select" class="uat-swal-select"></select>
                            <div id="swal-security-error" class="uat-swal-error" style="display:none;">
                                <i class="ri-error-warning-line"></i><span>Please select an IS Officer.</span>
                            </div>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                showConfirmButton: true,
                confirmButtonText: '<i class="ri-check-line"></i> Accept',
                cancelButtonText: 'Cancel',
                buttonsStyling: false,
                focusConfirm: false,
                customClass: {
                    popup: 'uat-swal-popup',
                    confirmButton: 'uat-swal-confirm uat-swal-confirm-security',
                    cancelButton: 'uat-swal-cancel',
                    actions: 'uat-swal-actions'
                },
                didOpen: () => {
                    if (!document.getElementById('uat-swal-style')) {
                        var style = document.createElement('style');
                        style.id = 'uat-swal-style';
                        style.textContent = `
                            .uat-swal-popup { border-radius: 1.1rem; padding: 1.75rem 1.75rem 1.5rem; }
                            .uat-swal { text-align: center; }
                            .uat-swal-icon {
                                width: 60px; height: 60px; margin: 0 auto .9rem;
                                border-radius: 50%; display: grid; place-items: center;
                                font-size: 1.7rem; color: #fff;
                                background: linear-gradient(135deg, #3b5bdb, #6a3bdb);
                                box-shadow: 0 8px 20px -6px rgba(59,91,219,.55);
                            }
                            .uat-swal-icon-live {
                                background: linear-gradient(135deg, #0ca678, #1f9d6b);
                                box-shadow: 0 8px 20px -6px rgba(12,166,120,.55);
                            }
                            .uat-swal-icon-approve {
                                background: linear-gradient(135deg, #198754, #11603b);
                                box-shadow: 0 8px 20px -6px rgba(25,135,84,.55);
                            }
                            .uat-swal-icon-security {
                                background: linear-gradient(135deg, #0dcaf0, #0a95b3);
                                box-shadow: 0 8px 20px -6px rgba(13,202,240,.55);
                            }
                            .uat-swal-title { margin: 0 0 .35rem; font-size: 1.25rem; font-weight: 700; color: #1c2030; }
                            .uat-swal-sub { margin: 0 0 1.4rem; font-size: .88rem; color: #6b7385; line-height: 1.5; }
                            .uat-swal-field {
                                position: relative; display: flex; align-items: center;
                                border: 1.5px solid #e3e6ec; border-radius: .65rem;
                                background: #f8f9fc; transition: border-color .15s, box-shadow .15s;
                            }
                            .uat-swal-field:focus-within {
                                border-color: #3b5bdb; box-shadow: 0 0 0 4px rgba(59,91,219,.12); background: #fff;
                            }
                            .uat-swal-field-ico { padding: 0 .3rem 0 .85rem; color: #8891a5; font-size: 1.1rem; }
                            .uat-swal-input {
                                flex: 1; border: 0; background: transparent; outline: none;
                                padding: .75rem .9rem .75rem .4rem; font-size: .92rem; color: #1c2030;
                            }
                            .uat-swal-input::placeholder { color: #aab0c0; }
                            .uat-swal-group { text-align: left; margin-bottom: 1.1rem; }
                            .uat-swal-group:last-of-type { margin-bottom: 0; }
                            .uat-swal-label {
                                display: flex; align-items: center; gap: .4rem;
                                font-size: .82rem; font-weight: 600; color: #4a4f5e; margin-bottom: .4rem;
                            }
                            .uat-swal-label i { color: #3b5bdb; font-size: 1rem; }
                            .uat-swal-select { width: 100%; }
                            .uat-swal-error {
                                display: flex; align-items: center; gap: .4rem; justify-content: flex-start;
                                margin-top: .4rem; font-size: .8rem; color: #d6384a; font-weight: 500;
                            }
                            .uat-swal-actions { margin-top: 1.4rem !important; gap: .6rem; }
                            .uat-swal-confirm, .uat-swal-cancel {
                                padding: .6rem 1.3rem; border-radius: .6rem; font-weight: 600; font-size: .88rem;
                                border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: .4rem;
                                transition: transform .1s, box-shadow .15s;
                            }
                            .uat-swal-confirm {
                                color: #fff; background: linear-gradient(135deg, #3b5bdb, #2f49b8);
                                box-shadow: 0 6px 16px -6px rgba(59,91,219,.6);
                            }
                            .uat-swal-confirm-live {
                                background: linear-gradient(135deg, #0ca678, #0b8c64);
                                box-shadow: 0 6px 16px -6px rgba(12,166,120,.6);
                            }
                            .uat-swal-confirm-approve {
                                background: linear-gradient(135deg, #198754, #11603b);
                                box-shadow: 0 6px 16px -6px rgba(25,135,84,.6);
                            }
                            .uat-swal-confirm-security {
                                background: linear-gradient(135deg, #0dcaf0, #0a95b3);
                                box-shadow: 0 6px 16px -6px rgba(13,202,240,.6);
                            }
                            .uat-swal-confirm:hover { transform: translateY(-1px); }
                            .uat-swal-cancel { background: #f1f2f6; color: #4a4f5e; }
                            .uat-swal-cancel:hover { background: #e7e9ef; }

                            /* Select2 styled to match the field look above */
                            .uat-swal-popup .select2-container .select2-selection--single {
                                height: auto; border: 1.5px solid #e3e6ec; border-radius: .65rem;
                                background: #f8f9fc; padding: .6rem .9rem; transition: border-color .15s, box-shadow .15s;
                            }
                            .uat-swal-popup .select2-container--open .select2-selection--single,
                            .uat-swal-popup .select2-container .select2-selection--single:focus {
                                border-color: #3b5bdb; box-shadow: 0 0 0 4px rgba(59,91,219,.12); background: #fff;
                            }
                            .uat-swal-popup .select2-selection__rendered { padding: 0; line-height: 1.3; font-size: .92rem; color: #1c2030; }
                            .uat-swal-popup .select2-selection__placeholder { color: #aab0c0; }
                            .uat-swal-popup .select2-selection__arrow { height: 100%; top: 0; right: 10px; }
                        `;
                        document.head.appendChild(style);
                    }

                    $('#swal-security-select').select2({
                        dropdownParent: $('.swal2-popup'),
                        placeholder: 'Select User',
                        width: '100%',
                        data: [{ id: '', text: '' }].concat(userOptions)
                    });

                    $('#swal-security-select').on('change', function () {
                        if (this.value) { $('#swal-security-error').hide(); }
                    });
                },
                preConfirm: () => {
                    var selected = $('#swal-security-select').val();
                    if (!selected) {
                        $('#swal-security-error').show();
                        return false;
                    }
                    return selected;
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@(Url.Action("AcceptDevAssessment", "CRManagement"))',
                    type: 'POST',
                    data: { id: crId, securityOfficerId: result.value },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to approve.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Assessment accepted and assigned to the IS Officer.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'An error occurred processing the server request.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== DEVELOPER DOCUMENTATION: RETURN (reason required) =====
        $(document).off('click', '#modal-devdoc-return-btn')
                   .on('click', '#modal-devdoc-return-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Return Change Request?',
                text: 'This Change Request will be returned to the developer.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, return',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@(Url.Action("ReturnDevAssessment", "CRManagement"))',
                    type: 'POST',
                    data: { id: crId },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to return.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request returned.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to return the Change Request. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== REJECT: RETURN TO QA (status = TestingApproved): reason required =====
        $(document).off('click', '#modal-return-qa-btn')
                   .on('click', '#modal-return-qa-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Return to QA?',
                input: 'textarea',
                inputLabel: 'Reason for returning to QA',
                inputPlaceholder: 'Explain what QA needs to re-test or fix...',
                inputAttributes: { 'aria-label': 'Reason for returning to QA', maxlength: 1000 },
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, return to QA',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter a reason.';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@(Url.Action("ReturnToQA", "CRManagement"))',
                    type: 'POST',
                    data: { id: crId, reason: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to return the CR to QA.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request returned to QA.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to return the Change Request to QA. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });
    });
</script>
