    <button type="button" class="cr-action-btn is-secondary" data-bs-dismiss="modal">Close</button>
    <a class="cr-close-form-btn"
       href="@Url.Action("DownloadCRForm", "CRManagement", new { id = Model.CRID })"
       target="_blank"
       title="Download CR Form (PDF)">
        <i class="ri-download-2-line"></i>
    </a>
</div>

<script>
    $(document).ready(function () {

        var userOptions = [
            @if (ViewBag.Users != null)
            {
                            foreach (var user in ViewBag.Users)
                            {
