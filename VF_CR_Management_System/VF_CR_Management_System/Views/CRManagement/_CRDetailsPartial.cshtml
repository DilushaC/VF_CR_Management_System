        align-items: center;
        gap: .6rem;
        margin-bottom: .5rem;
    }

    .cr-crnum {
        font-size: 1.05rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .7rem;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
    }

    .cr-hero-title {
        margin: 0 0 .85rem;
        color: #fff;
        font-size: 1.45rem;
        font-weight: 650;
        line-height: 1.3;
        max-width: 60ch;
    }

    .cr-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem 1.25rem;
        font-size: .85rem;
        color: rgba(255,255,255,.75);
    }

        .cr-hero-meta .cr-meta-item {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .cr-hero-meta .cr-overdue {
            color: var(--cr-bad);
            font-weight: 600;
        }

    .cr-status, .cr-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }

        .cr-status.ok, .cr-chip.ok {
            background: rgba(61,220,151,.18);
            color: #1f9d6b;
        }

        .cr-status.warn, .cr-chip.warn {
            background: rgba(255,176,32,.2);
            color: #b57600;
        }

        .cr-status.bad, .cr-chip.bad {
            background: rgba(255,93,108,.18);
            color: #d6384a;
        }

        .cr-status.info, .cr-chip.info {
            background: rgba(120,150,255,.2);
            color: #4a63d6;
        }

    .cr-hero .cr-status.ok, .cr-hero .cr-chip.ok {
        color: var(--cr-ok);
    }

    .cr-hero .cr-status.warn, .cr-hero .cr-chip.warn {
        color: var(--cr-warn);
    }

    .cr-hero .cr-status.bad, .cr-hero .cr-chip.bad {
        color: var(--cr-bad);
    }

    .cr-hero .cr-status.info, .cr-hero .cr-chip.info {
        color: #b4c3ff;
    }

    .cr-stepper {
        list-style: none;
        margin: 0;
        padding: 1.3rem 1.25rem 1.4rem;
        display: flex;
        overflow-x: auto;
    }

    .cr-step {
        flex: 1 0 84px;
        position: relative;
        text-align: center;
        font-size: .78rem;
        color: rgba(255,255,255,.55);
    }

        .cr-step::before {
            content: "";
            position: absolute;
            top: 16px;
            right: 50%;
            width: 100%;
            height: 3px;
            border-radius: 2px;
            background-color: rgba(255,255,255,.16);
        }

        .cr-step:first-child::before {
            display: none;
        }

        .cr-step.is-done::before,
        .cr-step.is-current::before {
            background-image: linear-gradient(var(--cr-ok), var(--cr-ok));
            background-repeat: no-repeat;
            background-size: 0 100%;
            animation: cr-fill .45s ease-out forwards;
            animation-delay: calc(var(--i) * 110ms);
        }

    @@keyframes cr-fill {
        to {
            background-size: 100% 100%;
        }
    }

    .cr-dot {
        position: relative;
        z-index: 1;
        width: 34px;
        height: 34px;
        margin: 0 auto .45rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 1rem;
        background: #26304f;
        border: 2px solid rgba(255,255,255,.22);
    }

    .cr-retry-badge {
        position: absolute;
        top: -6px;
        right: -6px;
        min-width: 16px;
        height: 16px;
        padding: 0 3px;
        border-radius: 999px;
        background: var(--cr-warn);
        color: #3a2600;
        font-size: .65rem;
        font-weight: 800;
        line-height: 16px;
        text-align: center;
        box-shadow: 0 0 0 2px var(--cr-ink);
    }

    .cr-step.is-done .cr-dot {
        background: var(--cr-ok);
        border-color: var(--cr-ok);
        color: #0c2a1e;
    }

    .cr-step.is-current .cr-dot {
        background: #fff;
        border-color: #fff;
        color: var(--cr-ink);
        box-shadow: 0 0 0 5px rgba(255,255,255,.18);
    }

    .cr-step.is-current.is-returned .cr-dot {
        background: var(--cr-warn);
        border-color: var(--cr-warn);
    }

    .cr-step.is-current.is-rejected .cr-dot {
        background: var(--cr-bad);
        border-color: var(--cr-bad);
        color: #fff;
    }

    .cr-step.is-done, .cr-step.is-current {
        color: rgba(255,255,255,.85);
    }

    .cr-step.is-current {
        color: #fff;
        font-weight: 600;
    }

    .cr-body {
        padding: 0;
    }

    .cr-tabs {
        display: flex;
        flex-wrap: nowrap;
        gap: .25rem;
