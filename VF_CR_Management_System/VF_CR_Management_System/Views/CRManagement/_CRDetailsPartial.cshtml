        function initSwalUrlInput(options) {
            var URL_REGEX = /^https?:\/\/(localhost|(\d{1,3}\.){3}\d{1,3}|[a-z0-9-]+(\.[a-z0-9-]+)+)(:\d+)?(\/[^\s]*)?$/i;

            var $input = $(options.inputId);
            var $err = $(options.errorId);
            var $field = $(options.fieldId);
            var $validIco = $(options.validIcoId);
            var $confirmBtn = Swal.getConfirmButton();

            $confirmBtn.disabled = true;
            $confirmBtn.classList.add('uat-swal-confirm-disabled');
            $input.trigger('focus');

            function validate() {
                var val = $input.val().trim();

                if (!val) {
                    $err.hide();
                    $field.removeClass('is-invalid is-valid');
                    $validIco.hide();
                    $confirmBtn.disabled = true;
                    $confirmBtn.classList.add('uat-swal-confirm-disabled');
                    return;
                }

                if (URL_REGEX.test(val)) {
                    $err.hide();
                    $field.removeClass('is-invalid').addClass('is-valid');
                    $validIco.show();
                    $confirmBtn.disabled = false;
                    $confirmBtn.classList.remove('uat-swal-confirm-disabled');
                } else {
                    $err.find('span').text(options.invalidMessage);
                    $err.show();
                    $field.removeClass('is-valid').addClass('is-invalid');
                    $validIco.hide();
                    $confirmBtn.disabled = true;
                    $confirmBtn.classList.add('uat-swal-confirm-disabled');
                }
            }

            $input.on('input paste keyup', function () {
                setTimeout(validate, 0);
            });

            return { urlRegex: URL_REGEX };
        }

