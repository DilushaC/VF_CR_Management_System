@using VF_CR_Management_System.Data.Models
@model VF_CR_Management_System.Data.Models.ChangeRequest
@{
    var currentEmpNo = ViewBag.CurrentEmpNo as string ?? string.Empty;
    var isApproved = string.Equals(Model.Status, "Approved", StringComparison.OrdinalIgnoreCase);
    var isAssessment = string.Equals(Model.Status, "Assessment", StringComparison.OrdinalIgnoreCase);
    var isSecurityStatus = string.Equals(Model.Status, "Security", StringComparison.OrdinalIgnoreCase);
    var imageExt = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };

    var hasAssignedUsers = new[]
    {
        Model.ApproverUserName,
        Model.AssessmentUserName,
        Model.SecurityUserName,
        Model.TestingUserName,
        Model.FinalApproverUserName,
        Model.TesterUserName,
        Model.TestingApproverUserName
    }.Any(u => !string.IsNullOrWhiteSpace(u));

    // Strips a DOMAIN\ prefix and whitespace so both sides compare cleanly.
    string Normalize(string? u)
    {
        u = (u ?? string.Empty).Trim();
        var slash = u.LastIndexOf('\\');
        return slash >= 0 ? u.Substring(slash + 1) : u;
    }

    // Identifiers that may identify the logged-in user in Approval.AssignedTo
    var currentIds = new[]
    {
        Normalize(ViewBag.CurrentEmpNo as string),
        Normalize(ViewBag.CurrentUserName as string),
        Normalize(User.Identity?.Name)
    }
    .Where(x => x.Length > 0)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

    // Compares against the RAW value in StepAssignments[..].AssignedTo
    bool IsAssignedTo(int stepId)
    {
        var assignee = Normalize(Model.StepAssignments?
            .FirstOrDefault(s => s.StepID == stepId)?.AssignedTo);

        return assignee.Length > 0
            && currentIds.Any(id => string.Equals(id, assignee, StringComparison.OrdinalIgnoreCase));
    }

    // A step is pending while it is not approved and has no real decision
    // (a default "Pending" value in Decision counts as no decision)
    bool IsPending(WorkflowStepAssignment? step) =>
        step != null
        && step.IsApproved != true
        && (string.IsNullOrWhiteSpace(step.Decision)
            || string.Equals(step.Decision.Trim(), "Pending", StringComparison.OrdinalIgnoreCase));

    var deptHeadStep = Model.StepAssignments?.FirstOrDefault(s => s.StepID == 1);
    var securityStep = Model.StepAssignments?.FirstOrDefault(s => s.StepID == 3);
    var testingStep = Model.StepAssignments?.FirstOrDefault(s => s.StepID == 4);

    // Dynamic lookup for the TesterAssignment step
    var testerAssignmentStep = Model.StepAssignments?
        .FirstOrDefault(s => string.Equals(s.StepName, "TesterAssignment", StringComparison.OrdinalIgnoreCase));

    var isTesterAssignmentAssigned = testerAssignmentStep != null
        && !string.IsNullOrWhiteSpace(testerAssignmentStep.AssignedTo)
        && currentIds.Any(id => string.Equals(id, Normalize(testerAssignmentStep.AssignedTo), StringComparison.OrdinalIgnoreCase));

    // Once a tester has been assigned to the Testing step, the handover is done
    var testerAlreadyAssigned = testingStep != null && !string.IsNullOrWhiteSpace(testingStep.AssignedTo);

    var canHandoverToTester = isTesterAssignmentAssigned
        && IsPending(testerAssignmentStep)
        && !testerAlreadyAssigned;

    var canApprove = IsAssignedTo(1) && IsPending(deptHeadStep);
    var canGoAssessment = isApproved && IsAssignedTo(2);
    var canGoSecurity = (isAssessment || isSecurityStatus) && IsAssignedTo(3) && IsPending(securityStep);
    var isTestingStatus = string.Equals(Model.Status, "Testing", StringComparison.OrdinalIgnoreCase);
    var canGoQA = !isTestingStatus && IsAssignedTo(4) && IsPending(testingStep);

    // Security saved as draft: the InfoSec officer can go back and edit it
    var isSecurityDraft = string.Equals(Model.Status, "SecurityDraft", StringComparison.OrdinalIgnoreCase);
    var canEditSecurityDraft = isSecurityDraft && IsAssignedTo(3);

    // "6407 - Uthpala Ekanayake" / "DOMAIN\\6407" -> "6407"
    string EmpNoOf(string? v)
    {
        var x = Normalize(v);
        var i = x.IndexOf(" - ", StringComparison.Ordinal);
        return (i >= 0 ? x.Substring(0, i) : x).Trim();
    }

    bool IsCurrentUser(string? v)
    {
        var id = EmpNoOf(v);
        return id.Length > 0 && currentIds.Any(c => string.Equals(EmpNoOf(c), id, StringComparison.OrdinalIgnoreCase));
    }

    // Testing status: the assigned approver hands the CR over to the Final Approver
    // Any still-pending step assigned to me (excluding the tester's own QA step and the tester handover)
    var hasMyPendingStep = Model.StepAssignments != null && Model.StepAssignments.Any(s =>
        s.StepID != 4
        && !string.Equals(s.StepName, "TesterAssignment", StringComparison.OrdinalIgnoreCase)
        && IsPending(s)
        && IsCurrentUser(s.AssignedTo));

    var dbgMe = string.Join(",", currentIds);
    var dbgSteps = Model.StepAssignments == null
        ? "none"
        : string.Join(" | ", Model.StepAssignments.Select(x => $"{x.StepID}:{x.StepName}:{x.AssignedTo}:{x.Decision}:{x.IsApproved}"));

    var canHandoverToFinalApprover = isTestingStatus
        && string.IsNullOrWhiteSpace(Model.FinalApproverUserName)
        && (hasMyPendingStep
            || IsCurrentUser(Model.ApproverUserName)
            || IsCurrentUser(Model.TestingApproverUserName));

    // Status "TestingApproved" (also matches "Testing Approved"): the Final Approver can give final approval
    var isTestingApprovedStatus = string.Equals(
        (Model.Status ?? string.Empty).Replace(" ", string.Empty),
        "TestingApproved",
        StringComparison.OrdinalIgnoreCase);

    var canFinalApprove = isTestingApprovedStatus
        && (IsCurrentUser(Model.FinalApproverUserName) || hasMyPendingStep);
}

<style>
    .cr-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem 1.5rem;
        align-items: start;
    }

        .cr-detail-grid .cr-field-wide {
            grid-column: 1 / -1;
        }

        .cr-detail-grid .cr-field-half {
            grid-column: span 2;
        }

        .cr-detail-grid label {
            margin-bottom: 0.15rem;
        }

        .cr-detail-grid span {
            word-break: break-word;
        }

        .cr-detail-grid .cr-section-title {
            grid-column: 1 / -1;
            border-top: 1px solid #dee2e6;
            padding-top: 0.75rem;
            margin-top: 0.25rem;
            font-weight: 700;
        }

    /* Fix overlay layer ordering for Select2 inside Modals and SweetAlert */
    .select2-container--open {
        z-index: 20000 !important;
    }
</style>

@{
    void DetailField(string label, string? value, bool wide = false)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="@(wide ? "cr-field-wide" : "")">
                <label class="fw-bold text-dark d-block mb-1">@label:</label>
                <span>@value</span>
            </div>
        }
    }
}

@* DEBUG (remove later): view in DevTools > Network > CRDetailsPartial > Response *@
<!-- FINAL-HANDOVER DEBUG status=[@Model.Status] isTesting=[@isTestingStatus] finalApprover=[@Model.FinalApproverUserName] approver=[@Model.ApproverUserName] testingApprover=[@Model.TestingApproverUserName] me=[@dbgMe] hasMyPendingStep=[@hasMyPendingStep] canFinal=[@canHandoverToFinalApprover] steps=[@dbgSteps] -->
<div class="modal-header">
    <h5 class="modal-title">Change Request Details</h5>
    <div class="ms-auto d-flex align-items-center">
        <label class="col-form-label fw-semibold me-2">CR Number:</label>
        <span class="fw-bold">@Model.CRNumber</span>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <div class="cr-detail-grid">

        @{
            DetailField("Title", Model.ChangeTitle, wide: true);
        }
        @{
            DetailField("Status", Model.Status);
        }
        @{
            DetailField("Change Type", Model.ChangeType);
        }
        @{
            DetailField("Other Change Type", Model.OtherChangeType);
        }
        @{
            DetailField("Priority", Model.Priority);
        }
        @{
            DetailField("Division", Model.Division);
        }
        @{
            DetailField("Module", Model.Module);
        }
        @{
            DetailField("Change Impact", Model.ChangeImpact);
        }
        @{
            DetailField("Vendor", Model.Vendor);
        }
        @{
            DetailField("Proposal Number", Model.ProposalNumber);
        }
        @{
            DetailField("Requested By", Model.RequestedBy);
        }
        @{
            DetailField("Requested Date", Model.RequestedDate.ToString("yyyy/MM/dd"));
        }
        @{
            DetailField("Due Date", Model.DueDate?.ToString("yyyy/MM/dd"));
        }
        @{
            DetailField("Completed Date", Model.CompletedDate?.ToString("yyyy/MM/dd"));
        }

        @{
            DetailField("Summary & Business Justification", Model.Summary, wide: true);
        }
        @{
            DetailField("Business Impact", Model.BusinessImpact, wide: true);
        }
        @{
            DetailField("Reason", Model.Reason, wide: true);
        }
        @{
            DetailField("Expected Benefit", Model.ExpectedBenefit, wide: true);
        }
        @{
            DetailField("Rollback Plan", Model.RollbackPlan, wide: true);
        }
        @{
            DetailField("Risk Assessment", Model.RiskAssessment, wide: true);
        }
        @{
            DetailField("Activities & Tasks", Model.ActivitiesTasks, wide: true);
        }
        @{
            DetailField("Fixed Assets", Model.FixedAssets, wide: true);
        }

        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            <div class="cr-field-wide">
                <label class="fw-bold text-dark d-block mb-1">Attachments:</label>
                <ul class="list-unstyled mb-0">
                    @foreach (var a in Model.Attachments)
                    {
                        var ext = System.IO.Path.GetExtension(a.FileName)?.ToLowerInvariant() ?? "";
                        var isImage = imageExt.Contains(ext);
                        var isPdf = ext == ".pdf";
                        <li class="mb-1">
                            @if (isImage)
                            {
                                <a href="#" class="preview-image-link"
                                   data-attachment-id="@a.AttachmentID"
                                   data-file-name="@a.FileName">
                                    <i class="ri-image-line me-1"></i>@a.FileName
                                </a>
                            }
                            else if (isPdf)
                            {
                                <a href="@Url.Action("PreviewAttachment", "CRManagement", new { id = a.AttachmentID })"
                                   target="_blank" rel="noopener">
                                    <i class="ri-file-pdf-line me-1"></i>@a.FileName
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("DownloadAttachment", "CRManagement", new { id = a.AttachmentID })" download>
                                    <i class="ri-download-2-line me-1"></i>@a.FileName
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.UploadedBy) || a.UploadedDate != default)
                            {
                                <small class="text-muted">
                                    (@a.UploadedBy — @a.UploadedDate.ToString("yyyy/MM/dd"))
                                </small>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @* ===== Assigned users (workflow steps) ===== *@
        @if (hasAssignedUsers)
        {
            <div class="cr-section-title">Assigned Users</div>

            DetailField("CR Approver", Model.ApproverUserName);
            DetailField("Developed By", Model.AssessmentUserName);
            DetailField("InfoSec Officer", Model.SecurityUserName);
            DetailField("QA Done By", Model.TestingUserName);
            DetailField("QA Assigned By", Model.TesterUserName);
            DetailField("QA Approved By", Model.TestingApproverUserName);
            DetailField("Final Approver", Model.FinalApproverUserName);
        }
    </div>
</div>

<div class="modal-footer">
    @if (canApprove)
    {
        <button type="button" id="modal-approve-btn" class="btn btn-success" data-id="@Model.CRID">Approve</button>
        <button type="button" id="modal-reject-btn" class="btn btn-danger" data-id="@Model.CRID">Reject</button>
    }
    @if (canGoAssessment)
    {
        <a href="@Url.Action("Assessment", "CRManagement", new { id = Model.CRID })" class="btn btn-warning">Go to Assessment</a>
    }
    @if (canGoSecurity)
    {
        <a href="@Url.Action("AssesmentSecurity", "CRManagement", new { id = Model.CRID })" class="btn btn-info">
            <i class="ri-shield-check-line me-1"></i>Proceed to Security Assessment
        </a>
    }
    @if (canEditSecurityDraft)
    {
        <a href="@Url.Action("AssesmentSecurity", "CRManagement", new { id = Model.CRID })"
           class="btn btn-outline-info" title="Edit Security Assessment">
            <i class="ri-pencil-line me-1"></i>Edit Security Assessment
        </a>
    }
    @if (canHandoverToTester)
    {
        <button type="button" id="modal-handover-tester-btn" class="btn btn-primary" data-id="@Model.CRID">
            <i class="ri-user-shared-line me-1"></i>Handover to Tester
        </button>
    }
    @if (canHandoverToFinalApprover)
    {
        <button type="button" id="modal-handover-final-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-user-shared-line me-1"></i>Handover to Final Approver
        </button>
    }
    @if (canFinalApprove)
    {
        <a href="@Url.Action("FinalApproval", "CRManagement", new { id = Model.CRID })" class="btn btn-success">
            <i class="ri-check-double-line me-1"></i>Final Approval
        </a>
    }
    @if (canGoQA)
    {
        <a href="@Url.Action("Testing", "CRManagement", new { id = Model.CRID })" class="btn btn-primary">
            <i class="ri-test-tube-line me-1"></i>Proceed to QA Test
        </a>
    }
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

<script>
    $(document).ready(function () {

        // User list built from the server. id = UserName (e.g. 6407)
        var userOptions = [
            @if (ViewBag.Users != null)
            {
                    foreach (var user in ViewBag.Users)
                    {
                            string uId = user.UserName;
                            string label = user.FirstName + " " + user.LastName + " - " + user.UserName;
                            if (string.IsNullOrEmpty(uId)) { continue; }
                            <text>{ id: @Html.Raw(Json.Serialize(uId)), text: @Html.Raw(Json.Serialize(label)) },</text>
                    }
            }
        ];

        // Stop Bootstrap's modal focus trap from stealing focus from SweetAlert / Select2
        if (!window.__swalFocusFixApplied) {
            window.__swalFocusFixApplied = true;
            document.addEventListener('focusin', function (e) {
                if (e.target.closest('.swal2-container, .select2-container, .select2-search__field')) {
                    e.stopImmediatePropagation();
                }
            }, true);
        }

        // Shows the success message with an OK button. After OK: close the modal(s) and refresh the list
        function successAndClose(message) {
            Swal.fire({ icon: 'success', title: 'Success', text: message, confirmButtonText: 'OK' })
                .then(() => {
                    document.querySelectorAll('.modal.show').forEach(function (el) {
                        var inst = window.bootstrap && bootstrap.Modal.getInstance(el);
                        if (inst) { inst.hide(); } else { $(el).modal('hide'); }
                    });
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open').css({ overflow: '', paddingRight: '' });
                    location.reload();
                });
        }

        // Reusable: SweetAlert with a searchable user dropdown. Resolves with the selected UserName.
        function pickUser(title, labelText, confirmText, confirmColor) {
            return Swal.fire({
                title: title,
                html: `
                    <div class="text-start">
                        <label for="swal-user-select" class="form-label fw-semibold">${labelText}</label>
                        <select id="swal-user-select" class="form-select" style="width:100%;"></select>
                        <span id="swal-user-error" class="text-danger d-none small">Please select a user before proceeding.</span>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: confirmText,
                confirmButtonColor: confirmColor,
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                didOpen: () => {
                    $('#swal-user-select').select2({
                        dropdownParent: $('.swal2-popup'),
                        placeholder: 'Select User',
                        width: '100%',
                        data: [{ id: '', text: '' }].concat(userOptions)
                    });
                },
                preConfirm: () => {
                    var selected = $('#swal-user-select').val();
                    if (!selected) {
                        $('#swal-user-error').removeClass('d-none');
                        return false;
                    }
                    return selected;
                }
            });
        }

        // ===== APPROVE: pick the implementer inside the SweetAlert, then approve =====
        $(document).off('click', '#modal-approve-btn')
                   .on('click', '#modal-approve-btn', function () {

            var crId = $(this).data('id');

            pickUser('Approve Change Request', 'Select Implementer:', 'Approve', '#198754')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("Approve", "CRManagement")',
                        type: 'POST',
                        data: { id: crId, approverID: result.value },
                        success: function (response) {
                            if (response.success) {
                                successAndClose(response.message || 'Change Request approved.');
                            } else {
                                Swal.fire('Error', response.message || 'Failed to approve.', 'error');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'An error occurred processing the server request.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });

        // ===== HANDOVER TO TESTER =====
        $(document).off('click', '#modal-handover-tester-btn')
                   .on('click', '#modal-handover-tester-btn', function () {

            var crId = $(this).data('id');

            pickUser('Handover to Tester', 'Select Tester:', 'Confirm Handover', '#0d6efd')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("AssignTester", "CRManagement")',
                        type: 'POST',
                        data: { id: crId, testerID: result.value },
                        success: function (response) {
                            if (response.success) {
                                successAndClose(response.message || 'Handover successfully created.');
                            } else {
                                Swal.fire('Error', response.message || 'Failed to assign tester.', 'error');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'An error occurred processing the server request.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });

        // ===== HANDOVER TO FINAL APPROVER (Testing status) =====
        $(document).off('click', '#modal-handover-final-btn')
                   .on('click', '#modal-handover-final-btn', function () {

            var crId = $(this).data('id');

            pickUser('Hand over to Final Approver?', 'Select Final Approver:', 'Yes, hand over', '#0acf97')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("AssignFinalApprover", "CRManagement")',
                        type: 'POST',
                        data: { id: crId, finalApproverId: result.value },
                        headers: token ? { "RequestVerificationToken": token } : {},
                        success: function (response) {
                            // Treat any 2xx as success unless the server says success:false
                            if (response && response.success === false) {
                                Swal.fire('Error', response.message || 'Failed to hand over the CR.', 'error');
                            } else {
                                successAndClose((response && response.message) || 'The Final Approver has been assigned to this Change Request.');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'Failed to hand over the CR. Please try again.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });
    });
</script>
