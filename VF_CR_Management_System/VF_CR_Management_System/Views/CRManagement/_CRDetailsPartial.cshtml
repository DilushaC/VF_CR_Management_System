@using VF_CR_Management_System.Data.Models
@model VF_CR_Management_System.Data.Models.ChangeRequest
@{
    var currentEmpNo = ViewBag.CurrentEmpNo as string ?? string.Empty;
    var imageExt = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };

    // ===== Attachments split by type =====
    var allAttachments = Model.Attachments ?? new List<Attachment>();

    var srsFiles = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "SRS", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var baFiles = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "BA", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // QA / Testing attachments (add any other type names your QA upload uses)
    var qaTypeNames = new[] { "QA", "QA Report", "Testing" };

    var qaFiles = allAttachments
        .Where(a => !string.IsNullOrWhiteSpace(a.AttachmentTypeName)
                    && qaTypeNames.Contains(a.AttachmentTypeName.Trim(), StringComparer.OrdinalIgnoreCase))
        .ToList();

    // Vendor Report files (also catches older uploads that have no type recorded)
    var vendorFiles = allAttachments
        .Where(a => string.IsNullOrWhiteSpace(a.AttachmentTypeName)
                    || string.Equals(a.AttachmentTypeName, "Vendor Report", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var hasAnyAttachments = srsFiles.Any() || baFiles.Any() || qaFiles.Any() || vendorFiles.Any();

    // Strips a DOMAIN\ prefix and whitespace so both sides compare cleanly.
    string Normalize(string? u)
    {
        u = (u ?? string.Empty).Trim();
        var slash = u.LastIndexOf('\\');
        return slash >= 0 ? u.Substring(slash + 1) : u;
    }

    // Identifiers that may identify the logged-in user in Approval.AssignedTo
    var currentIds = new[]
    {
        Normalize(ViewBag.CurrentEmpNo as string),
        Normalize(ViewBag.CurrentUserName as string),
        Normalize(User.Identity?.Name)
    }
    .Where(x => x.Length > 0)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

    // "6407 - John Smith" -> "6407"
    string EmpNoOf(string? v)
    {
        var x = Normalize(v);
        var i = x.IndexOf(" - ", StringComparison.Ordinal);
        return (i >= 0 ? x.Substring(0, i) : x).Trim();
    }

    // SECURITY FIX: this used to compare EmpNoOf(v) against EmpNoOf(currentId) unconditionally.
    // EmpNoOf falls back to returning the WHOLE normalized string when there is no " - " separator,
    // so a bare username on one side (e.g. the logged-in user's raw AD name) could collide with an
    // unrelated employee number or username on the other side and make the UI think the request was
    // "assigned to you" (and expose the action buttons) when it was not.
    //
    // Fixed matching rules, safest first:
    //   1. Exact match on the full normalized identifier (covers username == username, or
    //      "empNo - name" == "empNo - name").
    //   2. Only fall back to comparing employee numbers when BOTH sides are actually in the
    //      "<empNo> - <name>" form, so a bare username can never be confused with someone else's
    //      parsed employee number.
    bool IsCurrentUser(string? v)
    {
        var raw = Normalize(v);
        if (raw.Length == 0) { return false; }

        if (currentIds.Any(c => string.Equals(c, raw, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        var vHasEmpNo = raw.IndexOf(" - ", StringComparison.Ordinal) > 0;
        if (!vHasEmpNo) { return false; }

        var id = EmpNoOf(raw);
        return id.Length > 0 && currentIds.Any(c =>
            c.IndexOf(" - ", StringComparison.Ordinal) > 0 &&
            string.Equals(EmpNoOf(c), id, StringComparison.OrdinalIgnoreCase));
    }

    bool IsPending(WorkflowStepAssignment? step) =>
        step != null
        && step.IsApproved != true
        && (string.IsNullOrWhiteSpace(step.Decision)
            || string.Equals(step.Decision.Trim(), "Pending", StringComparison.OrdinalIgnoreCase));

    string StepKey(string? s) => (s ?? string.Empty).Replace(" ", string.Empty);

    // BUG FIX: a step name (e.g. "Division Head Approval", "Testing") can have more than one
    // Approval row when the CR goes through a step more than once (returned, reassigned,
    // re-approved). Model.StepAssignments is ordered ASC by ApprovalID, so FirstOrDefault was
    // grabbing the OLDEST, already-closed row instead of the current one - which made CanActOn
    // see an already-decided row (IsPending == false) and hide the action buttons, or attribute
    // the step to the wrong (previous) assignee. LastOrDefault picks the most recent row, i.e.
    // the live cycle, which is what every canApprove/canGoXxx flag below actually needs.
    WorkflowStepAssignment? StepByName(string stepName) =>
        Model.StepAssignments?.LastOrDefault(s =>
            string.Equals(StepKey(s.StepName), StepKey(stepName), StringComparison.OrdinalIgnoreCase));

    bool CanActOn(WorkflowStepAssignment? step) =>
        step != null && IsPending(step) && IsCurrentUser(step.AssignedTo);

    var deptHeadStep = StepByName("Division Head Approval");
    var assessmentStep = StepByName("Assessment");
    var securityStep = StepByName("Security");
    var testingStep = StepByName("Testing");
    var finalApprovalStep = StepByName("Final Approval");
    var releaseClosureStep = StepByName("Release Closure");
    var testerAssignmentStep = StepByName("TesterAssignment");
    var testingApprovalStep = StepByName("TestingApproval");

    // ===== Division Head Approval — second (or later) cycle =====
    // Row 919-style data: a step name (e.g. Division Head Approval) can get a SECOND pending row
    // later in the CR's life (e.g. handed back to the approver after the developer finished their
    // documentation). deptHeadStep above already resolves to the LATEST row by name. This block
    // figures out whether that latest row is a first-ever decision (-> Approve/Reject) or a
    // reopened cycle (-> Accept/Return), so the two button sets are mutually exclusive.
    var deptHeadRows = (Model.StepAssignments ?? new List<WorkflowStepAssignment>())
        .Where(s => string.Equals(StepKey(s.StepName), StepKey("Division Head Approval"), StringComparison.OrdinalIgnoreCase))
        .ToList();

    var deptHeadHasPriorCycle = deptHeadRows.Count(r => r.IsApproved == true) > 0;
    var pendingDeptHeadStep = deptHeadRows.LastOrDefault(r => IsPending(r));

    // ===== Developer Documentation step =====
    // This step can have TWO (or more) rows for one CR, always matched by NAME (never by a hard-coded StepID):
    //   1st row  -> AssignedTo = the DEVELOPER (approver assigned the work)
    //   later row(s) -> the step goes back to the approver to Accept / Return after the developer submits
    // NOTE: WorkflowStepAssignment has no ApprovalID property, so rows are used in the order they arrive in
    // Model.StepAssignments. Make sure the controller/repository loads them ORDER BY ApprovalID ASC.
    var devDocRows = (Model.StepAssignments ?? new List<WorkflowStepAssignment>())
        .Where(s => string.Equals(StepKey(s.StepName), StepKey("Developer Documentation"), StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Display only: the developer is the AssignedTo of the FIRST row
    var developerUser = devDocRows.FirstOrDefault()?.AssignedTo;
    if (string.IsNullOrWhiteSpace(developerUser))
    {
        developerUser = Model.AssessmentUserName;
    }

    // Latest row for the step (kept for reference / debug)
    var developerDocStep = devDocRows.LastOrDefault();

    // The row that is waiting for a decision right now (the Accept / Return row)
    var pendingDevDocStep = devDocRows.LastOrDefault(r => IsPending(r));

    var hasAssignedUsers = new[]
    {
        Model.RequestedBy,
        Model.ApproverUserName,
        developerUser,
        Model.SecurityUserName,
        Model.TestingUserName,
        Model.FinalApproverUserName,
        Model.TesterUserName,
        Model.TestingApproverUserName
    }.Any(u => !string.IsNullOrWhiteSpace(u));

    var statusKey = StepKey(Model.Status);

    bool StatusIs(params string[] names) =>
        names.Any(n => string.Equals(statusKey, StepKey(n), StringComparison.OrdinalIgnoreCase));

    var isApproved = StatusIs("Approved");
    var isAssessmentReturned = StatusIs("AssessmentReturned");
    var isRejected = StatusIs("Rejected");
    var isAssessment = StatusIs("Assessment", "AssessmentSubmitted", "AssessmentAccepted");
    var isSecurityStatus = StatusIs("SecuritySubmitted");
    var isSecurityDraft = StatusIs("SecurityDraft");
    var isSecurityApproved = StatusIs("SecurityApproved");
    var isTestingStatus = StatusIs("TestingSubmitted");
    var isTestingApprovedStatus = StatusIs("TestingApproved");
    var isPastQaStatus = isTestingStatus || isTestingApprovedStatus;

    var testerAlreadyAssigned = testingStep != null && !string.IsNullOrWhiteSpace(testingStep.AssignedTo);

    // FIXED: excludes reopened Division Head Approval cycles so Approve/Reject and Accept/Return
    // never both show for the same underlying row.
    var canApprove = !isApproved && !isRejected && !isTestingApprovedStatus
        && !deptHeadHasPriorCycle
        && CanActOn(deptHeadStep);

    var canDeptHeadDecideAgain = deptHeadHasPriorCycle
        && CanActOn(pendingDeptHeadStep)
        && !StatusIs("TestingApproved", "FinalApproved", "Closed", "Released", "Completed", "ReleaseClosed", "LiveLinkSubmitted");

    // Developer = current user owns a still-open Developer Documentation row, or the Assessment step
    var isAssignedDeveloper = CanActOn(assessmentStep)
        || devDocRows.Any(r => r.IsApproved == null && IsCurrentUser(r.AssignedTo));

    // The original developer (AssignedTo of the FIRST Developer Documentation row).
    // Used for QAReturn, where the developer's old rows may already be closed.
    var isOriginalDeveloper = IsCurrentUser(developerUser);

    // "Go to Assessment": CR approved or returned from assessment, to the assigned developer
    var canGoAssessment = (isApproved && isAssignedDeveloper) || (isAssessmentReturned && isAssignedDeveloper);

    var canGoSecurity = (isAssessment || isSecurityStatus) && CanActOn(securityStep);
    var canEditSecurityDraft = isSecurityDraft && IsCurrentUser(securityStep?.AssignedTo);

    // "Proceed to Development" (opens the UAT link popup) is shown to the developer when the status is
    //   - DevelopmentApproved, or
    //   - QAReturn (QA sent it back, so the developer fixes it and uploads a new UAT link)
    var isDevelopmentApproved = StatusIs("DevelopmentApproved");
    var isQaReturned = StatusIs("QAReturn", "QAReturned", "ReturnedToQA");

    // Security must be closed (approved) before Development can proceed - this previously didn't
    // check security state at all, only developer identity, so it could appear while Security was
    // still pending.
    var isSecurityResolved = securityStep != null && securityStep.IsApproved == true;

    var canProceedToDevelopment =
        (isDevelopmentApproved || isQaReturned)
        && (isAssignedDeveloper || isOriginalDeveloper)
        && isSecurityResolved;

    // "Approve to Development" is shown only when the status is SecurityApproved AND the logged-in
    // user owns the pending Security row (the approver's follow-up row created once the InfoSec
    // officer approved it back to them) - not just anyone while the CR sits in SecurityApproved.
    var canApproveToDevelopment = isSecurityApproved && CanActOn(securityStep);

    // "Proceed to QA Test" is shown when the status is DevReturn (developer has uploaded the UAT link),
    // to the QA user whose Testing step is still pending.
    var isDevReturn = StatusIs("DevReturn");
    var canGoQA = isDevReturn && CanActOn(testingStep);
    var canHandoverToTester = CanActOn(testerAssignmentStep) && !testerAlreadyAssigned;
    // "Send to Final Approval": CR status is TestingApproved, and the logged-in user is the AssignedTo of the
    // pending "Division Head Approval" approval row (created when QA passed), and no Final Approver is picked yet.
    var canHandoverToFinalApprover = isTestingApprovedStatus
        && string.IsNullOrWhiteSpace(Model.FinalApproverUserName)
        && CanActOn(deptHeadStep);

    // "Final Approval" button (SweetAlert confirm): status TestingApproved and the logged-in user
    // owns the pending "Final Approval" row.
    var canFinalApprove = isTestingApprovedStatus && CanActOn(finalApprovalStep);
    var isAssessmentSubmitted = StatusIs("Assessment", "AssessmentSubmitted");

    // "Add Live Link" (popup): status FinalApproved and the logged-in user owns the pending "Release Closure" row.
    var isFinalApproved = StatusIs("FinalApproved");
    var canSubmitLiveLink = isFinalApproved && CanActOn(releaseClosureStep);

    // Accept / Return must act on the PENDING Developer Documentation row (assigned back to the approver)
    var canDevDocDecide = isAssessmentSubmitted && CanActOn(pendingDevDocStep);
    var isAssignedFinalApprover = IsCurrentUser(Model.FinalApproverUserName);

    var userLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var nameLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    if (ViewBag.Users != null)
    {
        foreach (var u in ViewBag.Users)
        {
            string un = u.UserName;
            if (string.IsNullOrWhiteSpace(un)) { continue; }
            un = un.Trim();
            string fullName = ((string)u.FirstName + " " + (string)u.LastName).Trim();
            var display = fullName.Length > 0 ? $"{fullName} - {un}" : un;
            userLookup[un] = display;
            if (fullName.Length > 0) { nameLookup[fullName] = display; }
        }
    }

    string DisplayUser(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return string.Empty; }
        var raw = Normalize(v);

        if (userLookup.TryGetValue(EmpNoOf(raw), out var d)) { return d; }

        if (nameLookup.TryGetValue(raw, out d)) { return d; }

        var i = raw.IndexOf(" - ", StringComparison.Ordinal);
        if (i > 0 && raw.Substring(0, i).Trim().All(char.IsDigit))
        {
            return $"{raw.Substring(i + 3).Trim()} - {raw.Substring(0, i).Trim()}";
        }

        return raw;
    }

    var dbgMe = string.Join(",", currentIds);
    var dbgSteps = Model.StepAssignments == null
        ? "none"
        : string.Join(" | ", Model.StepAssignments.Select(x => $"{x.StepID}:{x.StepName}:{x.AssignedTo}:{x.Decision}:{x.IsApproved}"));
    var dbgDevDoc = string.Join(" | ", devDocRows.Select(x => $"{x.StepID}:{x.AssignedTo}:{x.Decision}:{x.IsApproved}"));

    var showDebug = false;
}

@{
    // ---------- Workflow stepper (derived from the existing status flags) ----------
    var stageNames = new[] { "Requested", "Approval", "Assessment", "Security", "Development", "QA", "Final approval", "Release" };
    var stageIcons = new[] { "ri-file-add-line", "ri-user-follow-line", "ri-file-search-line", "ri-shield-check-line",
                             "ri-code-s-slash-line", "ri-test-tube-line", "ri-check-double-line", "ri-rocket-line" };

    var isReleased = Model.CompletedDate.HasValue
        || StatusIs("Closed", "Released", "Completed", "ReleaseClosed", "LiveLinkSubmitted");
    var isReturned = isAssessmentReturned || isQaReturned;

    int activeStage =
        isReleased ? stageNames.Length :
        isFinalApproved ? 7 :
        isTestingApprovedStatus ? 6 :
        (isTestingStatus || isDevReturn) ? 5 :
        (isDevelopmentApproved || isQaReturned || isSecurityApproved) ? 4 :
        (isSecurityDraft || isSecurityStatus) ? 3 :
        (isApproved || isAssessmentReturned || isAssessment) ? 2 :
        1;

    // Is anything waiting on the logged-in user? (same flags that drive the footer buttons)
    var hasAction = canApprove || canDeptHeadDecideAgain || canGoAssessment || canProceedToDevelopment || canGoSecurity
        || canEditSecurityDraft || canHandoverToTester || canHandoverToFinalApprover || canFinalApprove
        || canGoQA || canApproveToDevelopment || canDevDocDecide || canSubmitLiveLink;

    var attachmentCount = srsFiles.Count + baFiles.Count + qaFiles.Count + vendorFiles.Count;
    var stepRows = Model.StepAssignments ?? new List<WorkflowStepAssignment>();

    // ===== Workflow tab rows =====
    // FIX: this used to re-sort by StepID and then dedupe to just the LAST row per step name
    // (except Developer Documentation, which was special-cased to keep every row). That broke the
    // tab two ways on real data:
    //   1. Re-sorting by StepID scrambles chronology the moment a step is revisited later in the
    //      flow - e.g. Division Head Approval (StepID 1) gets a second row near the END of the
    //      process (QA sending it back up for the final handover), but StepID-sort shoves that
    //      second row to the very TOP of the list as if it happened first.
    //   2. The "last row per step" dedupe silently dropped the earlier cycle of any step other than
    //      Developer Documentation - e.g. the original Division Head approval, or the Security
    //      officer's row before it bounced back to the approver - even though those are real,
    //      distinct events the user should see.
    // Model.StepAssignments arrives ordered by ApprovalID ASC (chronological - see the repository
    // note above devDocRows), and ANY step can be revisited more than once (Division Head, Security
    // and Developer Documentation all do it on real data), so the fix is simply: don't re-sort, and
    // don't dedupe. Show every row, in arrival order, so the tab reads top-to-bottom as
    // "initial stage -> latest" accurately.
    var displayStepRows = stepRows
        .Where(s => !string.IsNullOrEmpty(StepKey(s.StepName))) // drop rows with no step name
        .ToList();

    var hasAssessmentData = new[]
    {
        Model.ChangeImpact, Model.Vendor, Model.ProposalNumber, Model.BusinessImpact, Model.Reason,
        Model.ExpectedBenefit, Model.RollbackPlan, Model.RiskAssessment, Model.ActivitiesTasks, Model.FixedAssets
    }.Any(v => !string.IsNullOrWhiteSpace(v));


    var hasSecurityData = new[]
    {
        Model.SecurityUserName, Model.ChangeImpact, Model.RiskAssessment
    }.Any(v => !string.IsNullOrWhiteSpace(v)) || securityStep != null;

    var testingRecords = Model.Tests ?? new List<Testing>();
    var activeTestingRecords = testingRecords
        .Where(t => t.Active)
        .OrderBy(t => t.TestCycleNumber)
        .ToList();

    var hasTestingData = new[]
    {
        Model.TestingUserName, Model.TesterUserName, Model.TestingApproverUserName
    }.Any(v => !string.IsNullOrWhiteSpace(v)) || testingStep != null || activeTestingRecords.Any();

    var isOverdue = Model.DueDate.HasValue && Model.DueDate.Value.Date < DateTime.Today && !isReleased && !isRejected;

    // ---------- Small helpers ----------
    string Pretty(string? s) =>
        string.IsNullOrWhiteSpace(s)
            ? string.Empty
            : System.Text.RegularExpressions.Regex.Replace(s.Trim(), "(?<=[a-z])(?=[A-Z])", " ");

    string PriorityCss(string? p)
    {
        var x = (p ?? string.Empty).ToLowerInvariant();
        if (x.Contains("critical") || x.Contains("urgent") || x.Contains("high")) { return "bad"; }
        if (x.Contains("medium") || x.Contains("normal")) { return "warn"; }
        if (x.Contains("low")) { return "ok"; }
        return "info";
    }

    string StatusCss() =>
        isRejected ? "bad" :
        isReturned ? "warn" :
        isReleased ? "ok" :
        "info";

    string Initials(string? name)
    {
        var letters = (name ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(p => char.IsLetter(p[0]))
            .Select(p => char.ToUpperInvariant(p[0]))
            .Take(2)
            .ToArray();
        return letters.Length > 0 ? new string(letters) : "?";
    }

    (string Label, string Css) StepState(WorkflowStepAssignment s)
    {
        if (isRejected) { return ("Rejected", "bad"); }
        if (s.IsApproved == true) { return ("Approved", "ok"); }
        if (IsPending(s)) { return ("Pending", "wait"); }
        var d = (s.Decision ?? string.Empty).Trim();
        return (d, d.IndexOf("reject", StringComparison.OrdinalIgnoreCase) >= 0 ? "bad" : "warn");
    }

    // ===== Workflow timeline timestamps =====
    // Picks the most meaningful timestamp for a timeline entry:
    //   - If the step has been decided (approved/returned/rejected), show WHEN that decision
    //     happened (ApprovalDate) - that's the moment that actually matters once it's closed.
    //   - If it's still pending, show WHEN it was handed to the current assignee (AssignedDate) -
    //     there's no decision timestamp yet, so the handoff time is the only time there is.
    // Assumes WorkflowStepAssignment exposes AssignedDate (DateTime) and ApprovalDate (DateTime?),
    // matching the Approval table's column names 1:1.
    DateTime? StepTimestamp(WorkflowStepAssignment s) =>
        s.ApprovalDate ?? (DateTime?)s.AssignedDate;

    string FormatStepTime(WorkflowStepAssignment s)
    {
        var dt = StepTimestamp(s);
        if (!dt.HasValue) { return string.Empty; }

        // Readable absolute timestamp: "16 Oct 2026, 11:09 AM"
        return dt.Value.ToString("dd MMM yyyy, hh:mm tt");
    }

    // ---------- Markup helpers ----------
    void Fact(string icon, string label, string? value, string valueCss = "")
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }
        <div class="cr-fact">
            <span class="cr-fact-ico"><i class="@icon"></i></span>
            <div class="cr-fact-text">
                <div class="cr-fact-label">@label</div>
                <div class="cr-fact-value @valueCss">@value</div>
            </div>
        </div>
    }

    void TextBlock(string icon, string title, string? value, bool highlight = false)
    {
        if (string.IsNullOrWhiteSpace(value)) { return; }
        <section class="cr-block @(highlight ? "cr-block-hl" : "")">
            <h6 class="cr-block-title"><i class="@icon"></i>@title</h6>
            <p class="cr-block-text">@value</p>
        </section>
    }

    void Person(string role, string icon, string? value)
    {
        var display = DisplayUser(value);
        if (string.IsNullOrWhiteSpace(display)) { return; }
        var sep = display.LastIndexOf(" - ", StringComparison.Ordinal);
        var pName = sep > 0 ? display.Substring(0, sep).Trim() : display;
        var pId = sep > 0 ? display.Substring(sep + 3).Trim() : string.Empty;
        var hue = Math.Abs(pName.Sum(c => (int)c)) % 6;
        var isMe = IsCurrentUser(value) || IsCurrentUser(display) || (pId.Length > 0 && IsCurrentUser(pId));

        <div class="cr-person">
            <span class="cr-avatar cr-hue-@hue">@Initials(pName)</span>
            <div class="cr-person-text">
                <div class="cr-person-name">
                    @pName @if (isMe) {
                    <span class="cr-you">You</span>
                }
            </div>
            <div class="cr-person-role"><i class="@icon"></i>@role</div>
        </div>
        @if (pId.Length > 0)
        {
            <span class="cr-person-id">@pId</span>
        }
    </div>
}

void FileGroup(string title, string icon, List<Attachment> items)
{
    if (items == null || !items.Any()) { return; }

    <div class="cr-file-group">
        <h6 class="cr-block-title"><i class="@icon"></i>@title <span class="cr-count">@items.Count</span></h6>
        <div class="cr-file-list">
            @foreach (var a in items)
            {
                var ext = System.IO.Path.GetExtension(a.FileName)?.ToLowerInvariant() ?? "";
                var isImage = imageExt.Contains(ext);
                var isPdf = ext == ".pdf";
                var href = isImage ? "#"
                : isPdf ? Url.Action("PreviewAttachment", "CRManagement", new { id = a.AttachmentID })
                : Url.Action("DownloadAttachment", "CRManagement", new { id = a.AttachmentID });
                var kind = isImage ? "img" : isPdf ? "pdf" : "file";
                var fileIcon = isImage ? "ri-image-2-line" : isPdf ? "ri-file-pdf-2-line" : "ri-file-download-line";
                var actIcon = isImage ? "ri-eye-line" : isPdf ? "ri-external-link-line" : "ri-download-2-line";

                <a class="cr-file @(isImage ? "preview-image-link" : "")"
                   href="@href"
                   target="@(isPdf ? "_blank" : null)"
                   rel="@(isPdf ? "noopener" : null)"
                   download="@(kind == "file" ? "" : null)"
                   data-attachment-id="@(isImage? a.AttachmentID.ToString() : null)"
                   data-file-name="@(isImage? a.FileName: null)">
                    <span class="cr-file-ico cr-file-@kind"><i class="@fileIcon"></i></span>
                    <span class="cr-file-main">
                        <span class="cr-file-name">@a.FileName</span>
                        @if (!string.IsNullOrWhiteSpace(a.UploadedBy) || a.UploadedDate != default)
                        {
                            <span class="cr-file-sub">@a.UploadedBy &middot; @a.UploadedDate.ToString("yyyy/MM/dd")</span>
                        }
                    </span>
                    <i class="cr-file-act @actIcon"></i>
                </a>
            }
        </div>
    </div>
}
}

<style>
    /* ===== Footer action buttons (same look as the SweetAlert confirm buttons) ===== */
    .cr-action-btn {
        padding: .6rem 1.2rem;
        border-radius: .6rem;
        font-weight: 600;
        font-size: .88rem;
        border: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: #fff;
        text-decoration: none;
        transition: transform .1s, box-shadow .15s;
    }

        .cr-action-btn i {
            font-size: 1rem;
        }

        .cr-action-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

        .cr-action-btn.is-approve {
            background: linear-gradient(135deg, #198754, #11603b);
            box-shadow: 0 6px 16px -6px rgba(25,135,84,.6);
        }

        .cr-action-btn.is-danger {
            background: linear-gradient(135deg, #dc3545, #a52834);
            box-shadow: 0 6px 16px -6px rgba(220,53,69,.6);
        }

        .cr-action-btn.is-primary {
            background: linear-gradient(135deg, #3b5bdb, #2f49b8);
            box-shadow: 0 6px 16px -6px rgba(59,91,219,.6);
        }

        .cr-action-btn.is-warning {
            background: linear-gradient(135deg, #ffb020, #d9900a);
            box-shadow: 0 6px 16px -6px rgba(255,176,32,.6);
            color: #3a2600;
        }

            .cr-action-btn.is-warning:hover {
                color: #3a2600;
            }

        .cr-action-btn.is-info {
            background: linear-gradient(135deg, #0dcaf0, #0a95b3);
            box-shadow: 0 6px 16px -6px rgba(13,202,240,.6);
        }

        .cr-action-btn.is-final {
            background: linear-gradient(135deg, #0acf97, #089b73);
            box-shadow: 0 6px 16px -6px rgba(10,207,151,.6);
        }

        .cr-action-btn.is-live {
            background: linear-gradient(135deg, #0ca678, #0b8c64);
            box-shadow: 0 6px 16px -6px rgba(12,166,120,.6);
        }

        .cr-action-btn.is-outline {
            background: #fff;
            color: #0a95b3;
            box-shadow: none;
            border: 1.5px solid rgba(13,202,240,.5);
        }

            .cr-action-btn.is-outline:hover {
                color: #0a95b3;
                background: rgba(13,202,240,.08);
            }

        .cr-action-btn.is-secondary {
            background: #f1f2f6;
            color: #4a4f5e;
            box-shadow: none;
        }

            .cr-action-btn.is-secondary:hover {
                background: #e7e9ef;
                color: #4a4f5e;
            }

    .cr-hero, .cr-body {
        --cr-ink: #451423;
        --cr-accent: #3b5bdb;
        --cr-ok: #3ddc97;
        --cr-warn: #ffb020;
        --cr-bad: #ff5d6c;
        --cr-line: var(--bs-border-color, #e3e6ec);
        --cr-muted: var(--bs-secondary-color, #6b7385);
        --cr-surface: var(--bs-tertiary-bg, #f5f7fb);
    }

    /* ===== Hero header ===== */
    .modal-header.cr-hero {
        display: block;
        padding: 0;
        border: 0;
        position: relative;
        color: #fff;
        background: var(--cr-ink);
        border-top-left-radius: calc(var(--bs-modal-border-radius, .5rem) - 1px);
        border-top-right-radius: calc(var(--bs-modal-border-radius, .5rem) - 1px);
    }

    .cr-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        z-index: 3;
        filter: invert(1) grayscale(1) brightness(2);
        opacity: .8;
    }

    .cr-close-form-btn {
        position: absolute;
        top: 1rem;
        right: 3.2rem;
        z-index: 3;
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: 1.1rem;
        text-decoration: none;
    }

        .cr-close-form-btn:hover {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

    .cr-hero-top {
        padding: 1.4rem 3.2rem 0 1.5rem;
    }

    .cr-hero-id {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .6rem;
        margin-bottom: .5rem;
    }

    .cr-crnum {
        font-size: 1.05rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .7rem;
        border-radius: 999px;
        background: rgba(255,255,255,.12);
    }

    .cr-hero-title {
        margin: 0 0 .85rem;
        color: #fff;
        font-size: 1.45rem;
        font-weight: 650;
        line-height: 1.3;
        max-width: 60ch;
    }

    .cr-hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem 1.25rem;
        font-size: .85rem;
        color: rgba(255,255,255,.75);
    }

        .cr-hero-meta .cr-meta-item {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .cr-hero-meta .cr-overdue {
            color: var(--cr-bad);
            font-weight: 600;
        }

    /* Status + priority chips */
    .cr-status, .cr-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }

        .cr-status.ok, .cr-chip.ok {
            background: rgba(61,220,151,.18);
            color: #1f9d6b;
        }

        .cr-status.warn, .cr-chip.warn {
            background: rgba(255,176,32,.2);
            color: #b57600;
        }

        .cr-status.bad, .cr-chip.bad {
            background: rgba(255,93,108,.18);
            color: #d6384a;
        }

        .cr-status.info, .cr-chip.info {
            background: rgba(120,150,255,.2);
            color: #4a63d6;
        }

    .cr-hero .cr-status.ok, .cr-hero .cr-chip.ok {
        color: var(--cr-ok);
    }

    .cr-hero .cr-status.warn, .cr-hero .cr-chip.warn {
        color: var(--cr-warn);
    }

    .cr-hero .cr-status.bad, .cr-hero .cr-chip.bad {
        color: var(--cr-bad);
    }

    .cr-hero .cr-status.info, .cr-hero .cr-chip.info {
        color: #b4c3ff;
    }

    /* ===== Stepper (the one expressive element) ===== */
    .cr-stepper {
        list-style: none;
        margin: 0;
        padding: 1.3rem 1.25rem 1.4rem;
        display: flex;
        overflow-x: auto;
    }

    .cr-step {
        flex: 1 0 84px;
        position: relative;
        text-align: center;
        font-size: .78rem;
        color: rgba(255,255,255,.55);
    }

        .cr-step::before {
            content: "";
            position: absolute;
            top: 16px;
            right: 50%;
            width: 100%;
            height: 3px;
            border-radius: 2px;
            background-color: rgba(255,255,255,.16);
        }

        .cr-step:first-child::before {
            display: none;
        }

        .cr-step.is-done::before,
        .cr-step.is-current::before {
            background-image: linear-gradient(var(--cr-ok), var(--cr-ok));
            background-repeat: no-repeat;
            background-size: 0 100%;
            animation: cr-fill .45s ease-out forwards;
            animation-delay: calc(var(--i) * 110ms);
        }

    @@keyframes cr-fill {
        to {
            background-size: 100% 100%;
        }
    }

    .cr-dot {
        position: relative;
        z-index: 1;
        width: 34px;
        height: 34px;
        margin: 0 auto .45rem;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 1rem;
        background: #26304f;
        border: 2px solid rgba(255,255,255,.22);
    }

    .cr-step.is-done .cr-dot {
        background: var(--cr-ok);
        border-color: var(--cr-ok);
        color: #0c2a1e;
    }

    .cr-step.is-current .cr-dot {
        background: #fff;
        border-color: #fff;
        color: var(--cr-ink);
        box-shadow: 0 0 0 5px rgba(255,255,255,.18);
    }

    .cr-step.is-current.is-returned .cr-dot {
        background: var(--cr-warn);
        border-color: var(--cr-warn);
    }

    .cr-step.is-current.is-rejected .cr-dot {
        background: var(--cr-bad);
        border-color: var(--cr-bad);
        color: #fff;
    }

    .cr-step.is-done, .cr-step.is-current {
        color: rgba(255,255,255,.85);
    }

    .cr-step.is-current {
        color: #fff;
        font-weight: 600;
    }

    /* ===== Body, tabs ===== */
    .cr-body {
        padding: 0;
    }

    .cr-tabs {
        display: flex;
        flex-wrap: nowrap;
        gap: .25rem;
        padding: 0 1.1rem;
