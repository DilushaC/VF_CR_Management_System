@using VF_CR_Management_System.Data.Models
@model VF_CR_Management_System.Data.Models.ChangeRequest
@{
    var currentEmpNo = ViewBag.CurrentEmpNo as string ?? string.Empty;
    var imageExt = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };

    // ===== Attachments split by type =====
    var allAttachments = Model.Attachments ?? new List<Attachment>();

    var srsFiles = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "SRS", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var baFiles = allAttachments
        .Where(a => string.Equals(a.AttachmentTypeName, "BA", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Vendor Report files (also catches older uploads that have no type recorded)
    var vendorFiles = allAttachments
        .Where(a => string.IsNullOrWhiteSpace(a.AttachmentTypeName)
                    || string.Equals(a.AttachmentTypeName, "Vendor Report", StringComparison.OrdinalIgnoreCase))
        .ToList();

    var hasAnyAttachments = srsFiles.Any() || baFiles.Any() || vendorFiles.Any();

    // Strips a DOMAIN\ prefix and whitespace so both sides compare cleanly.
    string Normalize(string? u)
    {
        u = (u ?? string.Empty).Trim();
        var slash = u.LastIndexOf('\\');
        return slash >= 0 ? u.Substring(slash + 1) : u;
    }

    // Identifiers that may identify the logged-in user in Approval.AssignedTo
    var currentIds = new[]
    {
        Normalize(ViewBag.CurrentEmpNo as string),
        Normalize(ViewBag.CurrentUserName as string),
        Normalize(User.Identity?.Name)
    }
    .Where(x => x.Length > 0)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();

    // "6407 - John Smith" -> "6407"
    string EmpNoOf(string? v)
    {
        var x = Normalize(v);
        var i = x.IndexOf(" - ", StringComparison.Ordinal);
        return (i >= 0 ? x.Substring(0, i) : x).Trim();
    }

    bool IsCurrentUser(string? v)
    {
        var id = EmpNoOf(v);
        return id.Length > 0 && currentIds.Any(c => string.Equals(EmpNoOf(c), id, StringComparison.OrdinalIgnoreCase));
    }

    bool IsPending(WorkflowStepAssignment? step) =>
        step != null
        && step.IsApproved != true
        && (string.IsNullOrWhiteSpace(step.Decision)
            || string.Equals(step.Decision.Trim(), "Pending", StringComparison.OrdinalIgnoreCase));

    string StepKey(string? s) => (s ?? string.Empty).Replace(" ", string.Empty);

    WorkflowStepAssignment? StepByName(string stepName) =>
        Model.StepAssignments?.FirstOrDefault(s =>
            string.Equals(StepKey(s.StepName), StepKey(stepName), StringComparison.OrdinalIgnoreCase));

    bool CanActOn(WorkflowStepAssignment? step) =>
        step != null && IsPending(step) && IsCurrentUser(step.AssignedTo);

    var deptHeadStep = StepByName("Division Head Approval");
    var assessmentStep = StepByName("Assessment");
    var securityStep = StepByName("Security");
    var testingStep = StepByName("Testing");
    var finalApprovalStep = StepByName("Final Approval");
    var releaseClosureStep = StepByName("Release Closure");
    var testerAssignmentStep = StepByName("TesterAssignment");
    var testingApprovalStep = StepByName("TestingApproval");

    // ===== Developer Documentation step =====
    // This step can have TWO (or more) rows for one CR, always matched by NAME (never by a hard-coded StepID):
    //   1st row  -> AssignedTo = the DEVELOPER (approver assigned the work)
    //   later row(s) -> the step goes back to the approver to Accept / Return after the developer submits
    // NOTE: WorkflowStepAssignment has no ApprovalID property, so rows are used in the order they arrive in
    // Model.StepAssignments. Make sure the controller/repository loads them ORDER BY ApprovalID ASC.
    var devDocRows = (Model.StepAssignments ?? new List<WorkflowStepAssignment>())
        .Where(s => string.Equals(StepKey(s.StepName), StepKey("Developer Documentation"), StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Display only: the developer is the AssignedTo of the FIRST row
    var developerUser = devDocRows.FirstOrDefault()?.AssignedTo;
    if (string.IsNullOrWhiteSpace(developerUser))
    {
        developerUser = Model.AssessmentUserName;
    }

    // Latest row for the step (kept for reference / debug)
    var developerDocStep = devDocRows.LastOrDefault();

    // The row that is waiting for a decision right now (the Accept / Return row)
    var pendingDevDocStep = devDocRows.LastOrDefault(r => IsPending(r));

    var hasAssignedUsers = new[]
    {
        Model.RequestedBy,
        Model.ApproverUserName,
        developerUser,
        Model.SecurityUserName,
        Model.TestingUserName,
        Model.FinalApproverUserName,
        Model.TesterUserName,
        Model.TestingApproverUserName
    }.Any(u => !string.IsNullOrWhiteSpace(u));

    var statusKey = StepKey(Model.Status);

    bool StatusIs(params string[] names) =>
        names.Any(n => string.Equals(statusKey, StepKey(n), StringComparison.OrdinalIgnoreCase));

    var isApproved = StatusIs("Approved");
    var isAssessmentReturned = StatusIs("AssessmentReturned");
    var isRejected = StatusIs("Rejected");
    var isAssessment = StatusIs("Assessment", "AssessmentSubmitted", "AssessmentAccepted");
    var isSecurityStatus = StatusIs("SecuritySubmitted");
    var isSecurityDraft = StatusIs("SecurityDraft");
    var isSecurityApproved = StatusIs("SecurityApproved");
    var isTestingStatus = StatusIs("TestingSubmitted");
    var isTestingApprovedStatus = StatusIs("TestingApproved");
    var isPastQaStatus = isTestingStatus || isTestingApprovedStatus;

    var testerAlreadyAssigned = testingStep != null && !string.IsNullOrWhiteSpace(testingStep.AssignedTo);
    var canApprove = !isApproved && !isRejected && !isTestingApprovedStatus && CanActOn(deptHeadStep);

    // Developer = current user owns a still-open Developer Documentation row, or the Assessment step
    var isAssignedDeveloper = CanActOn(assessmentStep)
        || devDocRows.Any(r => r.IsApproved == null && IsCurrentUser(r.AssignedTo));

    // The original developer (AssignedTo of the FIRST Developer Documentation row).
    // Used for QAReturn, where the developer's old rows may already be closed.
    var isOriginalDeveloper = IsCurrentUser(developerUser);

    // "Go to Assessment": CR approved or returned from assessment, to the assigned developer
    var canGoAssessment = (isApproved && isAssignedDeveloper) || (isAssessmentReturned && isAssignedDeveloper);

    var canGoSecurity = (isAssessment || isSecurityStatus) && CanActOn(securityStep);
    var canEditSecurityDraft = isSecurityDraft && IsCurrentUser(securityStep?.AssignedTo);

    // "Proceed to Development" (opens the UAT link popup) is shown to the developer when the status is
    //   - DevelopmentApproved, or
    //   - QAReturn (QA sent it back, so the developer fixes it and uploads a new UAT link)
    var isDevelopmentApproved = StatusIs("DevelopmentApproved");
    var isQaReturned = StatusIs("QAReturn", "QAReturned", "ReturnedToQA");
    var canProceedToDevelopment =
        (isDevelopmentApproved || isQaReturned)
        && (isAssignedDeveloper || isOriginalDeveloper);

    // "Approve to Development" is shown only when the status is SecurityApproved
    var canApproveToDevelopment = isSecurityApproved;

    // "Proceed to QA Test" is shown when the status is DevReturn (developer has uploaded the UAT link),
    // to the QA user whose Testing step is still pending.
    var isDevReturn = StatusIs("DevReturn");
    var canGoQA = isDevReturn && CanActOn(testingStep);
    var canHandoverToTester = CanActOn(testerAssignmentStep) && !testerAlreadyAssigned;
    // "Send to Final Approval": CR status is TestingApproved, and the logged-in user is the AssignedTo of the
    // pending "Division Head Approval" approval row (created when QA passed), and no Final Approver is picked yet.
    var canHandoverToFinalApprover = isTestingApprovedStatus
        && string.IsNullOrWhiteSpace(Model.FinalApproverUserName)
        && CanActOn(deptHeadStep);

    // "Final Approval" button (SweetAlert confirm): status TestingApproved and the logged-in user
    // owns the pending "Final Approval" row.
    var canFinalApprove = isTestingApprovedStatus && CanActOn(finalApprovalStep);
    var isAssessmentSubmitted = StatusIs("Assessment", "AssessmentSubmitted");

    // "Add Live Link" (popup): status FinalApproved and the logged-in user owns the pending "Release Closure" row.
    var isFinalApproved = StatusIs("FinalApproved");
    var canSubmitLiveLink = isFinalApproved && CanActOn(releaseClosureStep);

    // Accept / Return must act on the PENDING Developer Documentation row (assigned back to the approver)
    var canDevDocDecide = isAssessmentSubmitted && CanActOn(pendingDevDocStep);
    var isAssignedFinalApprover = IsCurrentUser(Model.FinalApproverUserName);

    var userLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var nameLookup = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    if (ViewBag.Users != null)
    {
        foreach (var u in ViewBag.Users)
        {
            string un = u.UserName;
            if (string.IsNullOrWhiteSpace(un)) { continue; }
            un = un.Trim();
            string fullName = ((string)u.FirstName + " " + (string)u.LastName).Trim();
            var display = fullName.Length > 0 ? $"{fullName} - {un}" : un;
            userLookup[un] = display;
            if (fullName.Length > 0) { nameLookup[fullName] = display; }
        }
    }

    string DisplayUser(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) { return string.Empty; }
        var raw = Normalize(v);

        if (userLookup.TryGetValue(EmpNoOf(raw), out var d)) { return d; }

        if (nameLookup.TryGetValue(raw, out d)) { return d; }

        var i = raw.IndexOf(" - ", StringComparison.Ordinal);
        if (i > 0 && raw.Substring(0, i).Trim().All(char.IsDigit))
        {
            return $"{raw.Substring(i + 3).Trim()} - {raw.Substring(0, i).Trim()}";
        }

        return raw;
    }

    var dbgMe = string.Join(",", currentIds);
    var dbgSteps = Model.StepAssignments == null
        ? "none"
        : string.Join(" | ", Model.StepAssignments.Select(x => $"{x.StepID}:{x.StepName}:{x.AssignedTo}:{x.Decision}:{x.IsApproved}"));
    var dbgDevDoc = string.Join(" | ", devDocRows.Select(x => $"{x.StepID}:{x.AssignedTo}:{x.Decision}:{x.IsApproved}"));

    var showDebug = false;
}

<style>
    .cr-detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem 1.5rem;
        align-items: start;
    }

        .cr-detail-grid .cr-field-wide {
            grid-column: 1 / -1;
        }

        .cr-detail-grid .cr-field-half {
            grid-column: span 2;
        }

        .cr-detail-grid label {
            margin-bottom: 0.15rem;
        }

        .cr-detail-grid span {
            word-break: break-word;
        }

        .cr-detail-grid .cr-section-title {
            grid-column: 1 / -1;
            border-top: 1px solid #dee2e6;
            padding-top: 0.75rem;
            margin-top: 0.25rem;
            font-weight: 700;
        }

    /* Attachment groups (SRS / BA / Vendor) */
    .cr-attachment-group {
        grid-column: 1 / -1;
    }

        .cr-attachment-group .cr-attachment-title {
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

    /* Fix overlay layer ordering for Select2 inside Modals and SweetAlert */
    .select2-container--open {
        z-index: 20000 !important;
    }
</style>

@{
    void DetailField(string label, string? value, bool wide = false)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="@(wide ? "cr-field-wide" : "")">
                <label class="fw-bold text-dark d-block mb-1">@label:</label>
                <span>@value</span>
            </div>
        }
    }

    // Renders one attachment group (heading + file list). Nothing is rendered when the group is empty.
    void RenderAttachmentGroup(string title, IEnumerable<Attachment> items)
    {
        if (items == null || !items.Any())
        {
            return;
        }

        <div class="cr-attachment-group">
            <label class="fw-bold text-dark d-block cr-attachment-title">@title:</label>
            <ul class="list-unstyled mb-0">
                @foreach (var a in items)
                {
                    var ext = System.IO.Path.GetExtension(a.FileName)?.ToLowerInvariant() ?? "";
                    var isImage = imageExt.Contains(ext);
                    var isPdf = ext == ".pdf";
                    <li class="mb-1">
                        @if (isImage)
                        {
                            <a href="#" class="preview-image-link"
                               data-attachment-id="@a.AttachmentID"
                               data-file-name="@a.FileName">
                                <i class="ri-image-line me-1"></i>@a.FileName
                            </a>
                        }
                        else if (isPdf)
                        {
                            <a href="@Url.Action("PreviewAttachment", "CRManagement", new { id = a.AttachmentID })"
                               target="_blank" rel="noopener">
                                <i class="ri-file-pdf-line me-1"></i>@a.FileName
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("DownloadAttachment", "CRManagement", new { id = a.AttachmentID })" download>
                                <i class="ri-download-2-line me-1"></i>@a.FileName
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(a.UploadedBy) || a.UploadedDate != default)
                        {
                            <small class="text-muted">
                                (@a.UploadedBy — @a.UploadedDate.ToString("yyyy/MM/dd"))
                            </small>
                        }
                    </li>
                }
            </ul>
        </div>
    }
}

<div class="modal-header">
    <h5 class="modal-title">Change Request Details</h5>
    <div class="ms-auto d-flex align-items-center">
        <label class="col-form-label fw-semibold me-2">CR Number:</label>
        <span class="fw-bold">@Model.CRNumber</span>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <div class="cr-detail-grid">

        @{
            DetailField("Title", Model.ChangeTitle, wide: true);
        }
        @{
            DetailField("Status", Model.Status);
        }
        @{
            DetailField("Change Type", Model.ChangeType);
        }
        @{
            DetailField("Other Change Type", Model.OtherChangeType);
        }
        @{
            DetailField("Priority", Model.Priority);
        }
        @{
            DetailField("Division", Model.Division);
        }
        @{
            DetailField("Module", Model.Module);
        }
        @{
            DetailField("Change Impact", Model.ChangeImpact);
        }
        @{
            DetailField("Vendor", Model.Vendor);
        }
        @{
            DetailField("Proposal Number", Model.ProposalNumber);
        }
        @{
            DetailField("Requested Date", Model.RequestedDate.ToString("yyyy/MM/dd"));
        }
        @{
            DetailField("Due Date", Model.DueDate?.ToString("yyyy/MM/dd"));
        }
        @{
            DetailField("Completed Date", Model.CompletedDate?.ToString("yyyy/MM/dd"));
        }

        @{
            DetailField("Summary & Business Justification", Model.Summary, wide: true);
        }
        @{
            DetailField("Business Impact", Model.BusinessImpact, wide: true);
        }
        @{
            DetailField("Reason", Model.Reason, wide: true);
        }
        @{
            DetailField("Expected Benefit", Model.ExpectedBenefit, wide: true);
        }
        @{
            DetailField("Rollback Plan", Model.RollbackPlan, wide: true);
        }
        @{
            DetailField("Risk Assessment", Model.RiskAssessment, wide: true);
        }
        @{
            DetailField("Activities & Tasks", Model.ActivitiesTasks, wide: true);
        }
        @{
            DetailField("Fixed Assets", Model.FixedAssets, wide: true);
        }

        @* ===== Attachments, grouped by type ===== *@
        @if (hasAnyAttachments)
        {
            <div class="cr-section-title">Attachments</div>

            RenderAttachmentGroup("SRS Document", srsFiles);
            RenderAttachmentGroup("BA Document", baFiles);
            RenderAttachmentGroup("Vendor Attachments", vendorFiles);
        }

        @* ===== Assigned users (workflow steps) ===== *@
        @if (hasAssignedUsers)
        {
            <div class="cr-section-title">Assigned Users</div>

            DetailField("Requested By", DisplayUser(Model.RequestedBy));
            DetailField("CR Approver", DisplayUser(Model.ApproverUserName));
            DetailField("Developer", DisplayUser(developerUser));
            DetailField("InfoSec Officer", DisplayUser(Model.SecurityUserName));
            DetailField("QA Tester", DisplayUser(Model.TestingUserName));
            DetailField("QA Assigned By", DisplayUser(Model.TesterUserName));
            DetailField("QA Approved By", DisplayUser(Model.TestingApproverUserName));
            DetailField("Final CR Approver", DisplayUser(Model.FinalApproverUserName));
        }
    </div>
</div>

@if (showDebug)
{
    <div class="px-3 pb-2">
        <small class="text-muted d-block" style="font-size:11px; word-break:break-all;">
            DEBUG | status=[@Model.Status] | qaReturned=[@isQaReturned] | testingApproved=[@isTestingApprovedStatus] | finalApprover=[@Model.FinalApproverUserName] |
            me=[@dbgMe] | isFinalApprover=[@isAssignedFinalApprover] |
            developer=[@developerUser] | isAssignedDev=[@isAssignedDeveloper] | isOriginalDev=[@isOriginalDeveloper] | devDocRows=[@dbgDevDoc] |
            canApprove=[@canApprove] | canGoAssessment=[@canGoAssessment] | canProceedToDevelopment=[@canProceedToDevelopment] | canDevDocDecide=[@canDevDocDecide] | canFinalApprove=[@canFinalApprove] | canSubmitLiveLink=[@canSubmitLiveLink] | steps=[@dbgSteps]
        </small>
    </div>
}

<div class="modal-footer">
    @if (canApprove)
    {
        <button type="button" id="modal-approve-btn" class="btn btn-success" data-id="@Model.CRID">Approve</button>
        <button type="button" id="modal-reject-btn" class="btn btn-danger" data-id="@Model.CRID">Reject</button>
    }
    @if (canGoAssessment)
    {
        <a href="@Url.Action("Assessment", "CRManagement", new { id = Model.CRID })" class="btn btn-warning">Go to Assessment</a>
    }
    @if (canProceedToDevelopment)
    {
        <button type="button" id="modal-proceed-dev-btn" class="btn btn-warning" data-id="@Model.CRID">
            <i class="ri-code-s-slash-line me-1"></i>Proceed to Development
        </button>
    }
    @if (canGoSecurity)
    {
        <a href="@Url.Action("AssesmentSecurity", "CRManagement", new { id = Model.CRID })" class="btn btn-info">
            <i class="ri-shield-check-line me-1"></i>Proceed to Security Assessment
        </a>
    }
    @if (canEditSecurityDraft)
    {
        <a href="@Url.Action("AssesmentSecurity", "CRManagement", new { id = Model.CRID })"
           class="btn btn-outline-info" title="Edit Security Assessment">
            <i class="ri-pencil-line me-1"></i>Edit Security Assessment
        </a>
    }
    @if (canHandoverToTester)
    {
        <button type="button" id="modal-handover-tester-btn" class="btn btn-primary" data-id="@Model.CRID">
            <i class="ri-user-shared-line me-1"></i>Handover to Tester
        </button>
    }
    @if (canHandoverToFinalApprover)
    {
        <button type="button" id="modal-handover-final-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-send-plane-line me-1"></i>Send to Final Approval
        </button>
        <button type="button" id="modal-return-qa-btn" class="btn btn-danger" data-id="@Model.CRID">
            <i class="ri-arrow-go-back-line me-1"></i>Reject - Return to QA
        </button>
    }
    @if (canFinalApprove)
    {
        <button type="button" id="modal-final-approve-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-check-double-line me-1"></i>Final Approval
        </button>
    }
    @if (canGoQA)
    {
        <a href="@Url.Action("Testing", "CRManagement", new { id = Model.CRID })" class="btn btn-primary">
            <i class="ri-test-tube-line me-1"></i>Proceed to QA Test
        </a>
    }
    @if (canApproveToDevelopment)
    {
        <button type="button" id="modal-approve-dev-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-check-double-line me-1"></i>Approve to Development
        </button>
    }
    @if (canDevDocDecide)
    {
        <button type="button" id="modal-devdoc-approve-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-check-line me-1"></i>Accept
        </button>
        <button type="button" id="modal-devdoc-return-btn" class="btn btn-danger" data-id="@Model.CRID">
            <i class="ri-arrow-go-back-line me-1"></i>Return
        </button>
    }
    @if (canSubmitLiveLink)
    {
        <button type="button" id="modal-live-link-btn" class="btn btn-success" data-id="@Model.CRID">
            <i class="ri-links-line me-1"></i>Add Live Link
        </button>
    }
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

<script>
    $(document).ready(function () {

        // User list built from the server. id = UserName (e.g. 6407)
        var userOptions = [
            @if (ViewBag.Users != null)
            {
                    foreach (var user in ViewBag.Users)
                    {
                            string uId = user.UserName;
                            string label = user.FirstName + " " + user.LastName + " - " + user.UserName;
                            if (string.IsNullOrEmpty(uId)) { continue; }
                            <text>{ id: @Html.Raw(Json.Serialize(uId)), text: @Html.Raw(Json.Serialize(label)) },</text>
                    }
            }
        ];

        // Stop Bootstrap's modal focus trap from stealing focus from SweetAlert / Select2
        if (!window.__swalFocusFixApplied) {
            window.__swalFocusFixApplied = true;
            document.addEventListener('focusin', function (e) {
                if (e.target.closest('.swal2-container, .select2-container, .select2-search__field')) {
                    e.stopImmediatePropagation();
                }
            }, true);
        }

        // Shows the success message with an OK button. After OK: close the modal(s) and refresh the list
        function successAndClose(message) {
            Swal.fire({ icon: 'success', title: 'Success', text: message, confirmButtonText: 'OK' })
                .then(() => {
                    document.querySelectorAll('.modal.show').forEach(function (el) {
                        var inst = window.bootstrap && bootstrap.Modal.getInstance(el);
                        if (inst) { inst.hide(); } else { $(el).modal('hide'); }
                    });
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open').css({ overflow: '', paddingRight: '' });
                    location.reload();
                });
        }

        // Reusable: SweetAlert with a searchable user dropdown. Resolves with the selected UserName.
        function pickUser(title, labelText, confirmText, confirmColor) {
            return Swal.fire({
                title: title,
                html: `
                    <div class="text-start">
                        <label for="swal-user-select" class="form-label fw-semibold">${labelText}</label>
                        <select id="swal-user-select" class="form-select" style="width:100%;"></select>
                        <span id="swal-user-error" class="text-danger d-none small">Please select a user before proceeding.</span>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: confirmText,
                confirmButtonColor: confirmColor,
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                didOpen: () => {
                    $('#swal-user-select').select2({
                        dropdownParent: $('.swal2-popup'),
                        placeholder: 'Select User',
                        width: '100%',
                        data: [{ id: '', text: '' }].concat(userOptions)
                    });
                },
                preConfirm: () => {
                    var selected = $('#swal-user-select').val();
                    if (!selected) {
                        $('#swal-user-error').removeClass('d-none');
                        return false;
                    }
                    return selected;
                }
            });
        }

        // Reusable: SweetAlert with TWO searchable user dropdowns (Implementer + QA user).
        // Resolves with { implementerId, qaId } in result.value.
        function pickImplementerAndQa(title, confirmText, confirmColor) {
            return Swal.fire({
                title: title,
                html: `
                    <div class="text-start">
                        <div class="mb-3">
                            <label for="swal-implementer-select" class="form-label fw-semibold">Select Implementer:</label>
                            <select id="swal-implementer-select" class="form-select" style="width:100%;"></select>
                            <span id="swal-implementer-error" class="text-danger d-none small">Please select an Implementer.</span>
                        </div>
                        <div>
                            <label for="swal-qa-select" class="form-label fw-semibold">Select QA User:</label>
                            <select id="swal-qa-select" class="form-select" style="width:100%;"></select>
                            <span id="swal-qa-error" class="text-danger d-none small">Please select a QA user.</span>
                        </div>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: confirmText,
                confirmButtonColor: confirmColor,
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                didOpen: () => {
                    ['#swal-implementer-select', '#swal-qa-select'].forEach(function (sel) {
                        $(sel).select2({
                            dropdownParent: $('.swal2-popup'),
                            placeholder: 'Select User',
                            width: '100%',
                            data: [{ id: '', text: '' }].concat(userOptions)
                        });
                    });

                    // Hide each error as soon as a value is chosen
                    $('#swal-implementer-select').on('change', function () {
                        if (this.value) { $('#swal-implementer-error').addClass('d-none'); }
                    });
                    $('#swal-qa-select').on('change', function () {
                        if (this.value) { $('#swal-qa-error').addClass('d-none'); }
                    });
                },
                preConfirm: () => {
                    var implementerId = $('#swal-implementer-select').val();
                    var qaId = $('#swal-qa-select').val();
                    var valid = true;

                    if (!implementerId) {
                        $('#swal-implementer-error').removeClass('d-none');
                        valid = false;
                    }
                    if (!qaId) {
                        $('#swal-qa-error').removeClass('d-none');
                        valid = false;
                    }

                    return valid ? { implementerId: implementerId, qaId: qaId } : false;
                }
            });
        }

        // ===== APPROVE: pick the Implementer and the QA user, then approve =====
        $(document).off('click', '#modal-approve-btn')
                   .on('click', '#modal-approve-btn', function () {

            var crId = $(this).data('id');

            pickImplementerAndQa('Approve Change Request', 'Approve', '#198754')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("Approve", "CRManagement")',
                        type: 'POST',
                        data: {
                            id: crId,
                            approverID: result.value.implementerId,
                            qaUserId: result.value.qaId
                        },
                        success: function (response) {
                            if (response.success) {
                                successAndClose(response.message || 'Change Request approved.');
                            } else {
                                Swal.fire('Error', response.message || 'Failed to approve.', 'error');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'An error occurred processing the server request.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });

        // ===== REJECT: ask for a reason in the SweetAlert, then reject =====
        $(document).off('click', '#modal-reject-btn')
                   .on('click', '#modal-reject-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Reject Change Request',
                input: 'textarea',
                inputLabel: 'Reason for rejection',
                inputPlaceholder: 'Enter the reason for rejecting this Change Request...',
                inputAttributes: { 'aria-label': 'Reason for rejection', maxlength: 1000 },
                showCancelButton: true,
                confirmButtonText: 'Reject',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter a reason for rejection.';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Reject", "CRManagement")',
                    type: 'POST',
                    data: { id: crId, RejectReason: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        // The controller returns 200 with { message } on success
                        successAndClose((response && response.message) || 'Change Request rejected.');
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to reject the Change Request. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== HANDOVER TO TESTER =====
        $(document).off('click', '#modal-handover-tester-btn')
                   .on('click', '#modal-handover-tester-btn', function () {

            var crId = $(this).data('id');

            pickUser('Handover to Tester', 'Select Tester:', 'Confirm Handover', '#0d6efd')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: '@Url.Action("AssignTester", "CRManagement")',
                        type: 'POST',
                        data: { id: crId, testerID: result.value },
                        success: function (response) {
                            if (response.success) {
                                successAndClose(response.message || 'Handover successfully created.');
                            } else {
                                Swal.fire('Error', response.message || 'Failed to assign tester.', 'error');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'An error occurred processing the server request.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });

        // ===== HANDOVER TO FINAL APPROVER (TestingApproved status) =====
        $(document).off('click', '#modal-handover-final-btn')
                   .on('click', '#modal-handover-final-btn', function () {

            var crId = $(this).data('id');

            pickUser('Hand over to Final Approver?', 'Select Final Approver:', 'Yes, hand over', '#0acf97')
                .then((result) => {
                    if (!result.isConfirmed) return;

                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("AssignFinalApprover", "CRManagement")',
                        type: 'POST',
                        data: { id: crId, finalApproverId: result.value },
                        headers: token ? { "RequestVerificationToken": token } : {},
                        success: function (response) {
                            // Treat any 2xx as success unless the server says success:false
                            if (response && response.success === false) {
                                Swal.fire('Error', response.message || 'Failed to hand over the CR.', 'error');
                            } else {
                                successAndClose((response && response.message) || 'The Final Approver has been assigned to this Change Request.');
                            }
                        },
                        error: function (xhr) {
                            var msg = (xhr.responseJSON && xhr.responseJSON.message)
                                || 'Failed to hand over the CR. Please try again.';
                            Swal.fire('Error', msg, 'error');
                        }
                    });
                });
        });

        // ===== FINAL APPROVAL (status = TestingApproved): confirm first =====
        $(document).off('click', '#modal-final-approve-btn')
                   .on('click', '#modal-final-approve-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Final Approval?',
                text: 'Are you sure you want to give the final approval for this Change Request?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, approve',
                confirmButtonColor: '#198754',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("FinalApproval", "CRManagement")',
                    type: 'POST',
                    data: { id: crId },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to give the final approval.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Final approval completed.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to give the final approval. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== APPROVE TO DEVELOPMENT (status = SecurityApproved): confirm first =====
        $(document).off('click', '#modal-approve-dev-btn')
                   .on('click', '#modal-approve-dev-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Approve to Development?',
                text: 'Are you sure you want to approve this Change Request to Development?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, approve',
                confirmButtonColor: '#198754',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("ApproveToDevelopment", "CRManagement")',
                    type: 'POST',
                    data: { id: crId },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to approve to Development.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request approved to Development.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to approve to Development. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== PROCEED TO DEVELOPMENT (status = DevelopmentApproved or QAReturn): ask for the UAT link =====
        $(document).off('click', '#modal-proceed-dev-btn')
                   .on('click', '#modal-proceed-dev-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Proceed to Development',
                input: 'url',
                inputLabel: 'UAT Link',
                inputPlaceholder: 'https://uat.example.com/...',
                inputAttributes: { 'aria-label': 'UAT Link', maxlength: 500 },
                showCancelButton: true,
                confirmButtonText: 'Submit',
                confirmButtonColor: '#198754',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter the UAT link.';
                    }
                    if (!/^https?:\/\/\S+$/i.test(value.trim())) {
                        return 'Please enter a valid link starting with http:// or https://';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("ProceedToDevelopment", "CRManagement")',
                    type: 'POST',
                    data: { id: crId, uatLink: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to save the UAT link.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'UAT link saved.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to save the UAT link. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== RELEASE CLOSURE (status = FinalApproved): ask for the live link =====
        $(document).off('click', '#modal-live-link-btn')
                   .on('click', '#modal-live-link-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Add Live Link',
                input: 'url',
                inputLabel: 'Live Link',
                inputPlaceholder: 'https://live.example.com/...',
                inputAttributes: { 'aria-label': 'Live Link', maxlength: 500 },
                showCancelButton: true,
                confirmButtonText: 'Submit',
                confirmButtonColor: '#198754',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter the live link.';
                    }
                    if (!/^https?:\/\/\S+$/i.test(value.trim())) {
                        return 'Please enter a valid link starting with http:// or https://';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("SubmitLiveLink", "CRManagement")',
                    type: 'POST',
                    data: { id: crId, liveLink: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to save the live link.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Live link saved.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to save the live link. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== DEVELOPER DOCUMENTATION: APPROVE =====
        $(document).off('click', '#modal-devdoc-approve-btn')
                   .on('click', '#modal-devdoc-approve-btn', function () {

            var crId = $(this).data('id');

            // Accept: pick the IS Officer who receives the CR next
            pickUser('Accept Assessment', 'Select IS Officer:', 'Accept', '#198754').then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("AcceptDevAssessment", "CRManagement")',
                    type: 'POST',
                    data: { id: crId, securityOfficerId: result.value },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to approve.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Assessment accepted and assigned to the IS Officer.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'An error occurred processing the server request.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== DEVELOPER DOCUMENTATION: RETURN (reason required) =====
        $(document).off('click', '#modal-devdoc-return-btn')
                   .on('click', '#modal-devdoc-return-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Return Change Request?',
                text: 'This Change Request will be returned to the developer.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, return',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("ReturnDevAssessment", "CRManagement")',
                    type: 'POST',
                    data: { id: crId },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to return.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request returned.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to return the Change Request. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        // ===== REJECT: RETURN TO QA (status = TestingApproved): reason required =====
        $(document).off('click', '#modal-return-qa-btn')
                   .on('click', '#modal-return-qa-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Return to QA?',
                input: 'textarea',
                inputLabel: 'Reason for returning to QA',
                inputPlaceholder: 'Explain what QA needs to re-test or fix...',
                inputAttributes: { 'aria-label': 'Reason for returning to QA', maxlength: 1000 },
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, return to QA',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter a reason.';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("ReturnToQA", "CRManagement")',
                    type: 'POST',
                    data: { id: crId, reason: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to return the CR to QA.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request returned to QA.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to return the Change Request to QA. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });
    });
</script>
