                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to save the UAT link. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        $(document).off('click', '#modal-live-link-btn')
                   .on('click', '#modal-live-link-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: false,
                html: `
                    <div class="uat-swal">
                        <div class="uat-swal-icon uat-swal-icon-live">
                            <i class="ri-flashlight-fill"></i>
                        </div>
                        <h3 class="uat-swal-title">Add Live Link</h3>
                        <p class="uat-swal-sub">Paste the production link now that this change has gone live.</p>

                        <div class="uat-swal-field" id="live-link-field">
                            <i class="ri-link-m uat-swal-field-ico"></i>
                            <input id="live-link-input" type="url" class="uat-swal-input"
                                   placeholder="https://live.example.com/..." autocomplete="off" spellcheck="false">
                            <i class="ri-checkbox-circle-fill uat-swal-field-valid-ico" id="live-link-valid-ico" style="display:none;"></i>
                        </div>
                        <div id="live-link-error" class="uat-swal-error" style="display:none;">
                            <i class="ri-error-warning-line"></i><span></span>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                showConfirmButton: true,
                confirmButtonText: '<i class="ri-check-line"></i> Submit',
                cancelButtonText: 'Cancel',
                buttonsStyling: false,
                focusConfirm: false,
                customClass: {
                    popup: 'uat-swal-popup',
                    confirmButton: 'uat-swal-confirm uat-swal-confirm-live uat-swal-confirm-disabled',
                    cancelButton: 'uat-swal-cancel',
                    actions: 'uat-swal-actions'
                },
                didOpen: () => {
                    initSwalUrlInput({
                        inputId: '#live-link-input',
                        errorId: '#live-link-error',
                        fieldId: '#live-link-field',
                        validIcoId: '#live-link-valid-ico',
                        invalidMessage: 'Enter a valid link, e.g. https://live.example.com'
                    });
                },
                preConfirm: () => {
                    var URL_REGEX = /^https?:\/\/(localhost|(\d{1,3}\.){3}\d{1,3}|[a-z0-9-]+(\.[a-z0-9-]+)+)(:\d+)?(\/[^\s]*)?$/i;
                    var val = ($('#live-link-input').val() || '').trim();
                    var $err = $('#live-link-error');

                    if (!val) {
                        $err.find('span').text('Please enter the live link.');
                        $err.show();
                        return false;
                    }
                    if (!URL_REGEX.test(val)) {
                        $err.find('span').text('Enter a valid link, e.g. https://live.example.com');
                        $err.show();
                        return false;
                    }
                    return val;
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@(Url.Action("SubmitLiveLink", "CRManagement"))',
                    type: 'POST',
                    data: { id: crId, liveLink: result.value },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to save the live link.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Live link saved.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to save the live link. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });

        $(document).off('click', '#modal-return-qa-btn')
                   .on('click', '#modal-return-qa-btn', function () {

            var crId = $(this).data('id');

            Swal.fire({
                title: 'Return to QA?',
                input: 'textarea',
                inputLabel: 'Reason for returning to QA',
                inputPlaceholder: 'Explain what QA needs to re-test or fix...',
                inputAttributes: { 'aria-label': 'Reason for returning to QA', maxlength: 1000 },
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, return to QA',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Please enter a reason.';
                    }
                }
            }).then((result) => {
                if (!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@(Url.Action("ReturnToQA", "CRManagement"))',
                    type: 'POST',
                    data: { id: crId, reason: result.value.trim() },
                    headers: token ? { "RequestVerificationToken": token } : {},
                    success: function (response) {
                        if (response && response.success === false) {
                            Swal.fire('Error', response.message || 'Failed to return the CR to QA.', 'error');
                        } else {
                            successAndClose((response && response.message) || 'Change Request returned to QA.');
                        }
                    },
                    error: function (xhr) {
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            || 'Failed to return the Change Request to QA. Please try again.';
                        Swal.fire('Error', msg, 'error');
                    }
                });
            });
        });
    });
</script>