    .uat-swal-actions {
        margin-top: 1.4rem !important;
        gap: .6rem;
    }

    .uat-swal-confirm, .uat-swal-cancel {
        padding: .6rem 1.3rem;
        border-radius: .6rem;
        font-weight: 600;
        font-size: .88rem;
        border: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: transform .1s, box-shadow .15s, opacity .15s;
    }

    .uat-swal-confirm {
        color: #fff;
        background: linear-gradient(135deg, #3b5bdb, #2f49b8);
        box-shadow: 0 6px 16px -6px rgba(59,91,219,.6);
    }

    .uat-swal-confirm-live {
        background: linear-gradient(135deg, #0ca678, #0b8c64);
        box-shadow: 0 6px 16px -6px rgba(12,166,120,.6);
    }

    .uat-swal-confirm-approve {
        background: linear-gradient(135deg, #198754, #11603b);
        box-shadow: 0 6px 16px -6px rgba(25,135,84,.6);
    }

    .uat-swal-confirm-security {
        background: linear-gradient(135deg, #0dcaf0, #0a95b3);
        box-shadow: 0 6px 16px -6px rgba(13,202,240,.6);
    }

    .uat-swal-confirm-final {
        background: linear-gradient(135deg, #0acf97, #089b73);
        box-shadow: 0 6px 16px -6px rgba(10,207,151,.6);
    }

    .uat-swal-confirm:hover {
        transform: translateY(-1px);
    }

    .uat-swal-confirm-disabled {
        opacity: .5;
        cursor: not-allowed;
        box-shadow: none;
        pointer-events: none;
    }

    .uat-swal-cancel {
        background: #f1f2f6;
        color: #4a4f5e;
    }

        .uat-swal-cancel:hover {
            background: #e7e9ef;
        }

    .uat-swal-popup .select2-container .select2-selection--single {
        height: auto;
        border: 1.5px solid #e3e6ec;
        border-radius: .65rem;
        background: #f8f9fc;
        padding: .6rem .9rem;
        transition: border-color .15s, box-shadow .15s;
    }

        .uat-swal-popup .select2-container--open .select2-selection--single,
        .uat-swal-popup .select2-container .select2-selection--single:focus {
            border-color: #3b5bdb;
            box-shadow: 0 0 0 4px rgba(59,91,219,.12);
            background: #fff;
        }

    .uat-swal-popup .select2-selection__rendered {
        padding: 0;
        line-height: 1.3;
        font-size: .92rem;
        color: #1c2030;
    }

    .uat-swal-popup .select2-selection__placeholder {
        color: #aab0c0;
    }

    .uat-swal-popup .select2-selection__arrow {
        height: 100%;
        top: 0;
        right: 10px;
    }

    @@media (prefers-reduced-motion: reduce) {
        .cr-step.is-done::before, .cr-step.is-current::before {
            animation: none;
            background-size: 100% 100%;
        }

        .cr-tabs .nav-link::after, .cr-file {
            transition: none;
        }
    }
</style>

<div class="modal-header cr-hero">
    <button type="button" class="btn-close cr-close" data-bs-dismiss="modal" aria-label="Close"></button>

    <div class="cr-hero-top">
        <div class="cr-hero-id">
            <span class="cr-crnum"><i class="ri-git-pull-request-line"></i>@Model.CRNumber</span>
            @if (!string.IsNullOrWhiteSpace(Model.Status))
            {
                <span class="cr-status @StatusCss()">
                    <i class="@(isRejected ? "ri-close-circle-line" : isReturned ? "ri-arrow-go-back-line" : isReleased ? "ri-checkbox-circle-line" : "ri-loader-4-line")"></i>@Pretty(Model.Status)
                </span>
            }
        </div>

        <h3 class="cr-hero-title">@(string.IsNullOrWhiteSpace(Model.ChangeTitle) ? "Untitled change request" : Model.ChangeTitle)</h3>

        <div class="cr-hero-meta">
            @if (!string.IsNullOrWhiteSpace(Model.Priority))
            {
                <span class="cr-chip @PriorityCss(Model.Priority)"><i class="ri-flag-2-line"></i>@Model.Priority priority</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Division))
            {
                <span class="cr-meta-item"><i class="ri-building-line"></i>@Model.Division</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Module))
            {
                <span class="cr-meta-item"><i class="ri-apps-line"></i>@Model.Module</span>
            }
            <span class="cr-meta-item"><i class="ri-calendar-line"></i>Requested @Model.RequestedDate.ToString("yyyy/MM/dd")</span>
            @if (Model.DueDate.HasValue)
            {
                <span class="cr-meta-item @(isOverdue ? "cr-overdue" : "")">
                    <i class="ri-time-line"></i>Due @Model.DueDate.Value.ToString("yyyy/MM/dd")@(isOverdue ? " (overdue)" : "")
                </span>
            }
        </div>
    </div>

    <ol class="cr-stepper" aria-label="Workflow progress">
        @{
            var effectiveStage = Math.Max(activeStage, furthestStageReached);
        }
        @for (var si = 0; si < stageNames.Length; si++)
        {
            var isDone = si < effectiveStage;
            var isCurrent = si == effectiveStage;
            var stateCss = isDone ? "is-done" : isCurrent ? "is-current" : "";
            if (isCurrent && isRejected) { stateCss += " is-rejected"; }
            else if (isCurrent && isReturned) { stateCss += " is-returned"; }

            var retries = RetryCountFor(si);

            <li class="cr-step @stateCss" style="--i:@(si)" aria-current="@(isCurrent ? "step" : null)">
                <div class="cr-dot">
                    <i class="@(isDone ? "ri-check-line" : stageIcons[si])"></i>
                    @if (isCurrent && retries > 0)
                    {
                        <span class="cr-retry-badge" title="Returned to this stage @retries time(s)">@retries</span>
                    }
                </div>
                <div>@stageNames[si]</div>
            </li>
        }
    </ol>
</div>

<div class="modal-body cr-body">

    @if (hasAction)
    {
        <div class="cr-action-banner">
            <i class="ri-notification-3-line"></i>
            <span>This request is waiting on you. Use the buttons at the bottom to continue.</span>
        </div>
    }

    <ul class="nav cr-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#cr-tab-overview" role="tab">
                <i class="ri-file-list-3-line"></i>Request Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-assessment" role="tab">
                <i class="ri-file-search-line"></i>Assessment
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-files" role="tab">
                <i class="ri-attachment-2"></i>Attachments
                @if (attachmentCount > 0)
                {
                    <span class="cr-tab-badge">@attachmentCount</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-security" role="tab">
                <i class="ri-shield-check-line"></i>Security
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-testing" role="tab">
                <i class="ri-test-tube-line"></i>Testing
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-people" role="tab">
                <i class="ri-team-line"></i>People
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#cr-tab-workflow" role="tab">
                <i class="ri-route-line"></i>Workflow
                @if (displayStepRows.Any())
                {
                    <span class="cr-tab-badge">@displayStepRows.Count</span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content cr-panes">

        <div class="tab-pane fade show active" id="cr-tab-overview" role="tabpanel">
            <div class="cr-facts">
                @{
                    Fact("ri-swap-box-line", "Change type", Model.ChangeType);
                    Fact("ri-edit-2-line", "Other change type", Model.OtherChangeType);
                    Fact("ri-flag-2-line", "Priority", Model.Priority);
                    Fact("ri-building-line", "Division", Model.Division);
                    Fact("ri-apps-line", "Module", Model.Module);
                    Fact("ri-calendar-line", "Requested", Model.RequestedDate.ToString("yyyy/MM/dd"));
                    Fact("ri-time-line", "Due", Model.DueDate?.ToString("yyyy/MM/dd"), isOverdue ? "is-overdue" : "");
                    Fact("ri-calendar-check-line", "Completed", Model.CompletedDate?.ToString("yyyy/MM/dd"));
                }
            </div>

            @{
                TextBlock("ri-lightbulb-flash-line", "Change summary and business justification", Model.Summary, highlight: true);
            }

            @if (string.IsNullOrWhiteSpace(Model.Summary))
            {
                <div class="cr-empty"><i class="ri-draft-line"></i>No summary was provided for this request.</div>
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-assessment" role="tabpanel">
            @if (!hasAssessmentData)
            {
                <div class="cr-empty"><i class="ri-file-search-line"></i>The developer assessment hasn't been submitted yet.</div>
            }
            else
            {
                <div class="cr-facts">
                    @{
                        Fact("ri-pulse-line", "Change impact", Model.ChangeImpact);
                        Fact("ri-store-2-line", "Vendor", Model.Vendor);
                        Fact("ri-hashtag", "Proposal number", Model.ProposalNumber);
                    }
                </div>
                <div>
                    @{
                        TextBlock("ri-briefcase-line", "Business impact", Model.BusinessImpact);
                        TextBlock("ri-question-line", "Reason", Model.Reason);
                        TextBlock("ri-medal-line", "Expected benefit", Model.ExpectedBenefit);
                        TextBlock("ri-alert-line", "Risk assessment", Model.RiskAssessment);
                        TextBlock("ri-arrow-go-back-line", "Rollback plan", Model.RollbackPlan);
                        TextBlock("ri-task-line", "Activities and tasks", Model.ActivitiesTasks);
                        TextBlock("ri-computer-line", "Fixed assets", Model.FixedAssets);
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-files" role="tabpanel">
            @if (!hasAnyAttachments)
            {
                <div class="cr-empty"><i class="ri-folder-open-line"></i>No files have been attached yet.</div>
            }
            else
            {
                FileGroup("SRS documents", "ri-file-text-line", srsFiles);
                FileGroup("BA documents", "ri-file-list-line", baFiles);
                FileGroup("QA attachments", "ri-test-tube-line", qaFiles);
                FileGroup("Vendor attachments", "ri-store-2-line", vendorFiles);
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-people" role="tabpanel">
            @if (!hasAssignedUsers)
            {
                <div class="cr-empty"><i class="ri-user-unfollow-line"></i>No one has been assigned yet.</div>
            }
            else
            {
                <div class="cr-people">
                    @{
                        Person("Requested by", "ri-user-line", Model.RequestedBy);
                        Person("CR approver", "ri-user-follow-line", Model.ApproverUserName);
                        Person("Developer", "ri-code-s-slash-line", developerUser);
                        Person("InfoSec officer", "ri-shield-user-line", Model.SecurityUserName);
                        Person("QA tester", "ri-test-tube-line", Model.TestingUserName);
                        Person("QA assigned by", "ri-user-shared-line", Model.TesterUserName);
                        Person("QA approved by", "ri-user-star-line", Model.TestingApproverUserName);
                        Person("Final CR approver", "ri-medal-line", Model.FinalApproverUserName);
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-security" role="tabpanel">
            @if (!hasSecurityData)
            {
                <div class="cr-empty"><i class="ri-shield-check-line"></i>No security assessment has been submitted yet.</div>
            }
            else
            {
                <div class="cr-facts">
                    @{
                        Fact("ri-shield-user-line", "InfoSec officer", DisplayUser(Model.SecurityUserName));
                        Fact("ri-pulse-line", "Change impact", Model.ChangeImpact);
                        if (securityStep != null)
                        {
                            var secState = StepState(securityStep);
                            Fact("ri-flag-2-line", "Security status", secState.Label, secState.Css == "bad" ? "is-overdue" : "");
                            Fact("ri-time-line", "Last updated", FormatStepTime(securityStep));
                        }
                    }
                </div>

                TextBlock("ri-alert-line", "Information security risk assessment", Model.RiskAssessment, highlight: true);
                TextBlock("ri-alert-line", "Security Requirements", Model.SecurityRequirements, highlight: true);
                TextBlock("ri-alert-line", "Security Risks Identified", Model.SecurityRisksIdentified, highlight: true);
                TextBlock("ri-alert-line", "Risk Treatment Controls", Model.RiskTreatmentControls, highlight: true);
                TextBlock("ri-alert-line", "Dependencies Impact", Model.DependenciesImpact, highlight: true);

                @if (string.IsNullOrWhiteSpace(Model.RiskAssessment))
                {
                    <div class="cr-empty"><i class="ri-file-search-line"></i>No risk assessment has been submitted yet.</div>
                }
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-testing" role="tabpanel">
            @if (!hasTestingData)
            {
                <div class="cr-empty"><i class="ri-test-tube-line"></i>No testing / QA results have been submitted yet.</div>
            }
            else
            {
                <div class="cr-facts">
                    @{
                        Fact("ri-test-tube-line", "QA tester", DisplayUser(Model.TestingUserName));
                        Fact("ri-user-shared-line", "QA assigned by", DisplayUser(Model.TesterUserName));
                        Fact("ri-user-star-line", "QA approved by", DisplayUser(Model.TestingApproverUserName));
                        if (testingStep != null)
                        {
                            var testState = StepState(testingStep);
                            Fact("ri-flag-2-line", "Testing status", testState.Label, testState.Css == "bad" ? "is-overdue" : "");
                            Fact("ri-time-line", "Last updated", FormatStepTime(testingStep));
                        }
                    }
                </div>

                @if (activeTestingRecords.Any())
                {
                    @foreach (var t in activeTestingRecords)
                    {
                        <section class="cr-block">
                            <h6 class="cr-block-title"><i class="ri-repeat-line"></i>Test cycle @t.TestCycleNumber</h6>
                            <div class="cr-facts" style="margin-bottom:.75rem;">
                                @{
                                    Fact("ri-calendar-line", "Tested on", t.TestingDate?.ToString("yyyy/MM/dd"));
                                    Fact("ri-checkbox-circle-line", "Result",
                                    t.IsPassed == true ? "Passed" : t.IsPassed == false ? "Failed" : "Pending",
                                    t.IsPassed == true ? "" : t.IsPassed == false ? "is-overdue" : "");
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(t.TestResult))
                            {
                                <div class="cr-test-result-label"><i class="ri-file-list-3-line"></i>Test Results</div>
                                <div class="cr-test-result">@t.TestResult</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(t.UATLink))
                            {
                                <a href="@t.UATLink" target="_blank" rel="noopener" class="cr-test-link">
                                    <i class="ri-link-m"></i>@t.UATLink
                                </a>
                            }
                        </section>
                    }
                }
            }
        </div>

        <div class="tab-pane fade" id="cr-tab-workflow" role="tabpanel">
            @if (!displayStepRows.Any())
            {
                <div class="cr-empty"><i class="ri-route-line"></i>No workflow steps have been created yet.</div>
            }
            else
            {
                <ol class="cr-timeline">
                    @if (!string.IsNullOrWhiteSpace(creatorUser))
                    {
                        <li class="cr-tl-item">
                            <span class="cr-tl-dot ok"><i class="ri-user-add-line"></i></span>
                            <div class="cr-tl-body">
                                <div class="cr-tl-head">
                                    Created
                                    <span class="cr-chip ok">Requested</span>
                                </div>
                                <div class="cr-tl-time"><i class="ri-time-line"></i>@Model.RequestedDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                                <div class="cr-tl-who">@DisplayUser(creatorUser)</div>
                            </div>
                        </li>
                    }
                    @for (var i = 0; i < displayStepRows.Count; i++)
                    {
                        var step = displayStepRows[i];
                        var state = StepState(step);
                        var waitingOnMe = IsPending(step) && IsCurrentUser(step.AssignedTo);
                        var dotIcon = state.Css == "ok" ? "ri-check-line"
                        : state.Css == "bad" ? "ri-close-line"
                        : state.Css == "warn" ? "ri-arrow-go-back-line"
                        : "ri-time-line";
                        var stepTime = FormatStepTime(step);
                        var fromCaption = FromCaption(i);
                        var toCaption = ToCaption(i);
                        var bounceToNext = IsBounceBackToNext(i);

                        <li class="cr-tl-item @(bounceToNext ? "cr-tl-bounce" : "")">
                            <span class="cr-tl-dot @state.Css"><i class="@dotIcon"></i></span>
                            <div class="cr-tl-body">
                                <div class="cr-tl-head">
                                    @Pretty(step.StepName)
                                    <span class="cr-chip @(state.Css == "wait" ? "info" : state.Css)">@state.Label</span>
                                    @if (waitingOnMe)
                                    {
                                        <span class="cr-you">Waiting on you</span>
                                    }
                                </div>
                                @if (stepTime.Length > 0)
                                {
                                    <div class="cr-tl-time"><i class="ri-time-line"></i>@stepTime</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(step.AssignedTo))
                                {
                                    <div class="cr-tl-who">@DisplayUser(step.AssignedTo)</div>
                                }
                                @if (fromCaption != null)
                                {
                                    <div class="cr-tl-flow cr-tl-flow-from"><i class="ri-corner-left-up-line"></i>@fromCaption</div>
                                }
                                @if (toCaption != null)
                                {
                                    <div class="cr-tl-flow cr-tl-flow-to @(bounceToNext ? "is-bounce" : "")">
                                        <i class="@(bounceToNext ? "ri-arrow-go-back-line" : "ri-corner-right-down-line")"></i>@toCaption
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        </div>

    </div>
</div>

@if (showDebug)
{
    <div class="px-3 pb-2">
        <small class="text-muted d-block" style="font-size:11px; word-break:break-all;">
            DEBUG | status=[@Model.Status] | qaReturn=[@isQaReturn] | testingApproved=[@isTestingApproved] | finalApprover=[@Model.FinalApproverUserName] |
            me=[@dbgMe] | isFinalApprover=[@isAssignedFinalApprover] |
            developer=[@developerUser] | isAssignedDev=[@isAssignedDeveloper] | isOriginalDev=[@isOriginalDeveloper] | devDocRows=[@dbgDevDoc] |
            canApprove=[@canApprove] | canDevDocDecide=[@canDevDocDecide] | canGoAssessment=[@canGoAssessment] | canGoSecurity=[@canGoSecurity] |
            canApproveToDevelopment=[@canApproveToDevelopment] | canProceedToDevelopment=[@canProceedToDevelopment] |
            canHandoverToTester=[@canHandoverToTester] | canHandoverToFinalApprover=[@canHandoverToFinalApprover] |
            canReturnToQA=[@canReturnToQA] | canFinalApprove=[@canFinalApprove] | canSubmitLiveLink=[@canSubmitLiveLink] | steps=[@dbgSteps]
        </small>
    </div>
}

