@model IEnumerable<VF_CR_Management_System.Data.Models.ChangeRequest>
@{
    ViewData["Title"] = "CR Management";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="header-title mb-0">Change Requests - Assesments</h4>
                </div>

                <style>
                    #basic-datatable {
                        border-collapse: separate;
                        border-spacing: 0;
                    }

                        #basic-datatable > thead > tr > th:last-child,
                        #basic-datatable > tbody > tr > td:last-child {
                            position: sticky;
                            right: 0;
                            z-index: 2;
                        }

                        #basic-datatable > thead > tr > th:last-child {
                            z-index: 3;
                            background-color: #fff;
                        }

                        #basic-datatable > tbody > tr > td:last-child {
                            background-color: #fff;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd) > td:last-child {
                            background-color: #f2f2f2;
                        }

                        #basic-datatable > tbody > tr:hover > td:last-child {
                            background-color: #ededed;
                        }

                        #basic-datatable.table-striped > tbody > tr:nth-of-type(odd):hover > td:last-child {
                            background-color: #e0e0e0;
                        }

                        #basic-datatable > thead > tr > th:last-child::before,
                        #basic-datatable > tbody > tr > td:last-child::before {
                            content: "";
                            position: absolute;
                            top: 0;
                            bottom: 0;
                            left: 0;
                            width: 8px;
                            box-shadow: inset 6px 0 6px -6px rgba(0, 0, 0, 0.25);
                            pointer-events: none;
                        }

                    #crDetailsModal .swal2-container {
                        position: fixed !important;
                        z-index: 1080 !important;
                    }

                    #basic-datatable td.title-cell {
                        max-width: 220px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    #modal-attachments li {
                        margin-bottom: 4px;
                    }

                        #modal-attachments li a {
                            text-decoration: none;
                            cursor: pointer;
                        }

                            #modal-attachments li a:hover {
                                text-decoration: underline;
                            }

                    /* Stacked modal fix: image preview modal must sit above crDetailsModal */
                    #imagePreviewModal {
                        z-index: 1070;
                    }

                    .modal-backdrop + .modal-backdrop {
                        z-index: 1065;
                    }

                    #imagePreviewImg {
                        max-width: 100%;
                        max-height: 70vh;
                    }
                </style>

                <div class="table-responsive">
                    <table id="basic-datatable" class="table table-striped nowrap w-100">
                        <thead>
                            <tr>
                                <th>CR Number</th>
                                <th>Title</th>
                                <th>Change Type</th>
                                <th>Division</th>
                                <th>Module</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Requested By</th>
                                <th>Requested Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                @foreach (var cr in Model)
                                {
                                    <tr>
                                        <td title="@cr.CRNumber">@cr.CRNumber</td>
                                        <td class="title-cell" title="@cr.ChangeTitle">@cr.ChangeTitle</td>
                                        <td>@cr.ChangeType</td>
                                        <td>@(string.IsNullOrEmpty(cr.Division) ? "—" : cr.Division)</td>
                                        <td>@cr.Module</td>
                                        <td>
                                            @if (string.Equals(cr.Priority, "Emergency", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-danger">@cr.Priority</span>
                                            }
                                            else
                                            {
                                                @cr.Priority
                                            }
                                        </td>
                                        <td>
                                            @if (string.Equals(cr.Status, "Assessment", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-info">Sent to IS Officer</span>
                                            }
                                            else if (string.Equals(cr.Status, "AssessmentDraft", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="badge bg-warning">Draft</span>
                                            }
                                            else
                                            {
                                                @cr.Status
                                            }
                                        </td>
                                        <td>@cr.RequestedBy</td>
                                        <td>@cr.RequestedDate.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                @if (cr.Status == "Approved")
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-info btn-view"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#crDetailsModal"
                                                            data-bs-crid="@cr.CRID"
                                                            title="Proceed">
                                                        <i class="ri-login-box-line"></i>
                                                    </button>
                                                }
                                                else if (cr.Status == "AssessmentDraft")
                                                {
                                                    <div class="d-flex gap-1">
                                                        <a href="@Url.Action("EditAssessment", "CRManagement", new { id = cr.CRID })"
                                                           class="btn btn-sm btn-outline-primary"
                                                           title="Edit">
                                                            <i class="ri-edit-line"></i>
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-info btn-view"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#crDetailsModal"
                                                            data-bs-crid="@cr.CRID"
                                                            title="View">
                                                        <i class="ri-eye-line"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CR Details Modal shell — content is loaded from the shared partial via AJAX -->
<div class="modal fade" id="crDetailsModal" tabindex="-1" aria-labelledby="crDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="crDetailsModalContent">
            <!-- populated by AJAX -->
        </div>
    </div>
</div>

<!-- Image Preview Modal (stacked on top of crDetailsModal) -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewModalLabel">Attachment Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div id="imagePreviewSpinner" class="py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <img id="imagePreviewImg" src="" alt="Attachment preview" class="img-fluid d-none" />
            </div>
            <div class="modal-footer">
                <a id="imagePreviewDownloadBtn" href="#" class="btn btn-outline-primary" download>
                    <i class="ri-download-2-line me-1"></i> Download
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#basic-datatable').DataTable({
                responsive: false,
                paging: true,
                pageLength: 10,
                lengthChange: true,
                order: [[8, 'desc']],
                columnDefs: [
                    { orderable: false, targets: 9 },
                    { orderable: false, targets: 1 }
                ]
            });
        });

        var crDetailsModal = document.getElementById('crDetailsModal');
        var $modalContent = $('#crDetailsModalContent');
        var partialUrlBase = '@Url.Action("CRDetailsPartial", "CRManagement")';
        var previewUrlBase = '@Url.Action("PreviewAttachment", "CRManagement")';
        var downloadUrlBase = '@Url.Action("DownloadAttachment", "CRManagement")';

        // Single source of truth for the currently-open CR's id.
        var currentCrId = null;

        // --- Image preview modal wiring ---
        var imagePreviewModalEl = document.getElementById('imagePreviewModal');
        var imagePreviewModal = new bootstrap.Modal(imagePreviewModalEl);
        var $imagePreviewImg = $('#imagePreviewImg');
        var $imagePreviewSpinner = $('#imagePreviewSpinner');
        var $imagePreviewDownloadBtn = $('#imagePreviewDownloadBtn');

        // Delegated click handler: attachments list is injected fresh each time the
        // details modal opens, so binding on the static container avoids needing to
        // re-wire handlers after every AJAX load.
        $modalContent.on('click', 'a.preview-image-link', function (e) {
            e.preventDefault();

            var attachmentId = $(this).data('attachment-id');
            var fileName = $(this).data('file-name');
            var previewUrl = previewUrlBase + '?id=' + encodeURIComponent(attachmentId);
            var downloadUrl = downloadUrlBase + '?id=' + encodeURIComponent(attachmentId);

            $imagePreviewImg.addClass('d-none').attr('src', '');
            $imagePreviewSpinner.removeClass('d-none');
            $imagePreviewDownloadBtn.attr('href', downloadUrl).attr('download', fileName);
            $('#imagePreviewModalLabel').text(fileName || 'Attachment Preview');

            imagePreviewModal.show();

            var img = new Image();
            img.onload = function () {
                $imagePreviewSpinner.addClass('d-none');
                $imagePreviewImg.attr('src', previewUrl).removeClass('d-none');
            };
            img.onerror = function () {
                $imagePreviewSpinner.addClass('d-none');
                $imagePreviewImg.removeClass('d-none').attr('alt', 'Failed to load image');
            };
            img.src = previewUrl;
        });

        // Keep crDetailsModal's backdrop visible when the nested image modal closes
        imagePreviewModalEl.addEventListener('hidden.bs.modal', function () {
            if (crDetailsModal.classList.contains('show')) {
                document.body.classList.add('modal-open');
            }
        });

        // Load the partial fresh every time the modal opens.
        crDetailsModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) {
                console.error('crDetailsModal opened without a relatedTarget button.');
                return;
            }

            var rawCrid = button.getAttribute('data-bs-crid');
            currentCrId = parseInt(rawCrid, 10);
            if (isNaN(currentCrId) || currentCrId <= 0) {
                currentCrId = null;
            }

            $modalContent.html(
                '<div class="modal-body text-center py-5">' +
                '<div class="spinner-border text-primary" role="status"></div></div>'
            );

            if (!currentCrId) {
                $modalContent.html('<div class="modal-body text-danger">Invalid Change Request.</div>');
                return;
            }

            $.get(partialUrlBase, { id: currentCrId })
                .done(function (html) {
                    $modalContent.html(html);

                    // select2 only exists in the DOM when the partial renders the
                    // approver dropdown (status === Submitted), so guard for it.
                    var $approver = $('#modal-approver');
                    if ($approver.length) {
                        $approver.select2({
                            dropdownParent: $(crDetailsModal),
                            width: '100%'
                        });
                    }
                })
                .fail(function () {
                    $modalContent.html('<div class="modal-body text-danger">Failed to load Change Request details.</div>');
                });
        });

        $(crDetailsModal).on('hidden.bs.modal', function () {
            currentCrId = null;
            $modalContent.empty();
        });
    </script>
}
