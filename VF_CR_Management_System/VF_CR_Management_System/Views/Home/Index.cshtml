@model VF_CR_Management_System.Models.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Home Page";
}

<div class="topbar-item d-none d-md-flex mb-3">
    <div>
        <h4 class="page-title fs-18 fw-bold mb-0">Welcome to CR Management System</h4>
    </div>
</div>

<div class="row row-cols-xxl-4 row-cols-md-2 row-cols-1">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 justify-content-between">
                    <div>
                        <h5 class="text-muted fs-13 fw-bold text-uppercase" title="Number of Orders">
                            Total CRs
                        </h5>
                        <h3 class="my-2 py-1 fw-bold">@Model.TotalCRs</h3>
                    </div>
                    <div class="avatar-xl flex-shrink-0">
                        <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-42">
                            <iconify-icon icon="solar:bill-list-bold-duotone"></iconify-icon>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end col -->

    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 justify-content-between">
                    <div>
                        <h5 class="text-muted fs-13 fw-bold text-uppercase" title="Revenue">
                            Pending Approvals
                        </h5>
                        <h3 class="my-2 py-1 fw-bold">@Model.PendingApprovals</h3>
                    </div>
                    <div class="avatar-xl flex-shrink-0">
                        <span class="avatar-title bg-success-subtle text-success rounded-circle fs-42">
                            <iconify-icon icon="solar:armchair-2-bold"></iconify-icon>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end col -->

    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 justify-content-between">
                    <div>
                        <h5 class="text-muted fs-13 fw-bold text-uppercase" title="New Users">
                            Total Holds
                        </h5>
                        <h3 class="my-2 py-1 fw-bold">@Model.TotalHolds</h3>
                    </div>
                    <div class="avatar-xl flex-shrink-0">
                        <span class="avatar-title bg-warning-subtle text-warning rounded-circle fs-42">
                            <iconify-icon icon="solar:stopwatch-pause-bold"></iconify-icon>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end col -->

    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 justify-content-between">
                    <div>
                        <h5 class="text-muted fs-13 fw-bold text-uppercase"
                            title="Customer Satisfaction">
                            Rejected CRs
                        </h5>
                        <h3 class="my-2 py-1 fw-bold">@Model.RejectedCRs</h3>
                    </div>
                    <div class="avatar-xl flex-shrink-0">
                        <span class="avatar-title bg-info-subtle text-danger rounded-circle fs-42">
                            <iconify-icon icon="solar:sticker-smile-circle-bold-duotone"></iconify-icon>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end col -->
</div><!-- end row -->

<div class="row">
    <div class="col-xl-6">
        <div class="card">
            <div class="d-flex card-header justify-content-between align-items-center">
                <div>
                    <h4 class="header-title">CR Statistics</h4>
                </div>
            </div>
            <div class="card-body px-0 pt-0">
                <div dir="ltr" class="px-1">
                    <div id="statistics-chart" class="apex-charts" data-colors="#02c0ce,#777edd"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card">
            <div class="d-flex card-header justify-content-between align-items-center">
                <div>
                    <h4 class="header-title">CR Breakdown</h4>
                </div>
            </div>
            <div class="card-body">
                <div dir="ltr">
                    <div id="simple-pie" class="apex-charts"
                         data-colors="#777edd,#45bbe0,#0acf97,#fa5c7c"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Single source of truth, injected from the server model
        const crStats = @Html.Raw(JsonSerializer.Serialize(new
        {
                totalCRs = Model.TotalCRs,
                pending = Model.PendingApprovals,
                holds = Model.TotalHolds,
                rejected = Model.RejectedCRs
        }));

    document.addEventListener("DOMContentLoaded", function () {

            // Statistics (bar) chart - unrelated data, keep separate
            new ApexCharts(document.querySelector("#statistics-chart"), {
                chart: { type: "bar", height: 300, toolbar: { show: false } },
                series: [
                    { name: "Income", data: [30, 40, 35, 50, 49, 60, 70, 91, 45] },
                    { name: "Expenditure", data: [20, 30, 25, 40, 39, 50, 60, 71, 35] }
                ],
                xaxis: { categories: ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep"] },
                colors: ["#02c0ce", "#777edd"],
                plotOptions: { bar: { columnWidth: "45%", borderRadius: 4 } },
                dataLabels: { enabled: false },
                legend: { position: "top" }
            }).render();

            // Pie chart - now driven directly by the same stats as the cards
            new ApexCharts(document.querySelector("#simple-pie"), {
                chart: { type: "pie", height: 320 },
                series: [crStats.totalCRs, crStats.pending, crStats.holds, crStats.rejected],
                labels: ["Total CRs", "Pending Approvals", "Total Holds", "Rejected CRs"],
                colors: ["#777edd", "#45bbe0", "#0acf97", "#fa5c7c"],
                legend: { position: "bottom" },
                dataLabels: {
                    enabled: true,
                    formatter: function (val) {
                        return val.toFixed(1) + "%";
                    }
                },
                responsive: [{
                    breakpoint: 480,
                    options: {
                        chart: { width: 260 },
                        legend: { position: "bottom" }
                    }
                }]
            }).render();

        });
    </script>
}