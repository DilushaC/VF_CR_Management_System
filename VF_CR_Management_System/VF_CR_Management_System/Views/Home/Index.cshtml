@model VF_CR_Management_System.Models.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Home Page";

    // Simple derived figures for the hero strip - no new model fields needed.
    // NOTE: Model.PendingApprovals now holds the "In Progress" count (everything
    // that is neither Deployed nor Rejected), not "Approved" specifically.
    var total = Model.TotalCRs <= 0 ? 0 : Model.TotalCRs;
    var inProgressPct = total == 0 ? 0 : Math.Round((double)Model.PendingApprovals / total * 100, 0);
    var deployedPct = total == 0 ? 0 : Math.Round((double)Model.TotalHolds / total * 100, 0);
    var rejectedPct = total == 0 ? 0 : Math.Round((double)Model.RejectedCRs / total * 100, 0);
}

<style>
    .crdash {
        --cd-accent: #3b5bdb;
        --cd-ok: #0acf97;
        --cd-warn: #f7b84b;
        --cd-bad: #fa5c7c;
        --cd-info: #45bbe0;
        --cd-line: var(--bs-border-color, #e3e6ec);
        --cd-muted: var(--bs-secondary-color, #6b7385);
        --cd-card: var(--bs-card-bg, var(--bs-body-bg, #fff));
    }

    /* ===== Hero banner ===== */
    .crdash-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 1.5rem;
        padding: 1.75rem 2rem;
        border-radius: 1rem;
        color: #fff;
        background: linear-gradient(135deg, #2f3570 0%, #966675 55%, #451423 100%);
    }

        .crdash-hero::after {
            content: "";
            position: absolute;
            right: -70px;
            top: -90px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            border: 46px solid rgba(255,255,255,.07);
            pointer-events: none;
        }

        .crdash-hero::before {
            content: "";
            position: absolute;
            left: -40px;
            bottom: -80px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,.1) 0%, transparent 70%);
            pointer-events: none;
        }

    .crdash-hero-row {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
    }

    .crdash-hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: .5rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        background: rgba(255,255,255,.14);
    }

    .crdash-hero h2 {
        margin: 0;
        color: #fff;
        font-size: 1.65rem;
        font-weight: 700;
    }

    .crdash-hero p {
        margin: .3rem 0 0;
        color: rgba(255,255,255,.75);
        font-size: .9rem;
        max-width: 48ch;
    }

    .crdash-hero-total {
        text-align: right;
    }

        .crdash-hero-total .num {
            font-size: 2.4rem;
            font-weight: 800;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .crdash-hero-total .lbl {
            font-size: .78rem;
            color: rgba(255,255,255,.7);
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    /* ===== Stat cards ===== */
    .crdash-stat {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--cd-line);
        border-radius: .9rem;
        background: var(--cd-card);
        padding: 1.25rem 1.35rem;
        animation: crdash-rise .45s ease-out backwards;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .crdash-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 26px -10px rgba(23,33,59,.18);
        }

        .crdash-stat:nth-of-type(1) {
            animation-delay: .00s;
        }

        .crdash-stat:nth-of-type(2) {
            animation-delay: .06s;
        }

        .crdash-stat:nth-of-type(3) {
            animation-delay: .12s;
        }

        .crdash-stat:nth-of-type(4) {
            animation-delay: .18s;
        }

    @@keyframes crdash-rise {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }

    .crdash-stat-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
    }

    .crdash-stat-label {
        margin: 0 0 .35rem;
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--cd-muted);
    }

    .crdash-stat-value {
        margin: 0;
        font-size: 1.9rem;
        font-weight: 800;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }

    .crdash-stat-ico {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        display: grid;
        place-items: center;
        border-radius: .7rem;
        font-size: 1.35rem;
    }

    .crdash-stat.is-total .crdash-stat-ico {
        background: rgba(59,91,219,.12);
        color: var(--cd-accent);
    }

    .crdash-stat.is-ok .crdash-stat-ico {
        background: rgba(10,207,151,.14);
        color: var(--cd-ok);
    }

    .crdash-stat.is-info .crdash-stat-ico {
        background: rgba(69,187,224,.16);
        color: var(--cd-info);
    }

    .crdash-stat.is-bad .crdash-stat-ico {
        background: rgba(250,92,124,.14);
        color: var(--cd-bad);
    }

    .crdash-stat-foot {
        display: flex;
        align-items: center;
        gap: .4rem;
        margin-top: .85rem;
        font-size: .8rem;
        color: var(--cd-muted);
    }

    .crdash-stat-bar {
        margin-top: .7rem;
        height: 6px;
        border-radius: 999px;
        background: var(--cd-line);
        overflow: hidden;
    }

        .crdash-stat-bar > span {
            display: block;
            height: 100%;
            border-radius: 999px;
            width: 0%;
            transition: width 1s cubic-bezier(.3,.9,.3,1);
        }

    .crdash-stat.is-total .crdash-stat-bar > span {
        background: var(--cd-accent);
    }

    .crdash-stat.is-ok .crdash-stat-bar > span {
        background: var(--cd-ok);
    }

    .crdash-stat.is-info .crdash-stat-bar > span {
        background: var(--cd-info);
    }

    .crdash-stat.is-bad .crdash-stat-bar > span {
        background: var(--cd-bad);
    }

    /* ===== Chart cards ===== */
    .crdash-chart-card {
        border: 1px solid var(--cd-line);
        border-radius: .9rem;
        overflow: hidden;
    }

        .crdash-chart-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--cd-line);
            padding: 1.1rem 1.3rem;
        }

    .crdash-chart-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .crdash-chart-title i {
            color: var(--cd-accent);
        }

    .crdash-chart-sub {
        margin: .15rem 0 0;
        font-size: .8rem;
        color: var(--cd-muted);
    }

    /* ===== Donut center overlay ===== */
    .crdash-pie-wrap {
        position: relative;
    }

    .crdash-pie-center {
        position: absolute;
        top: 44%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
        line-height: 1.35;
        width: 150px;
    }

        .crdash-pie-center .pc-label {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: var(--cd-muted);
        }

        .crdash-pie-center .pc-total {
            font-size: 1.7rem;
            font-weight: 800;
            line-height: 1.15;
        }

        .crdash-pie-center .pc-breakdown {
            margin-top: .35rem;
            font-size: .72rem;
            color: var(--cd-muted);
        }

            .crdash-pie-center .pc-breakdown div {
                margin-top: .1rem;
            }

            .crdash-pie-center .pc-breakdown b {
                color: inherit;
                font-weight: 700;
            }

    @@media (prefers-reduced-motion: reduce) {
        .crdash-stat {
            animation: none;
        }

        .crdash-stat-bar > span {
            transition: none;
        }
    }
</style>

<div class="crdash">

    <div class="crdash-hero">
        <div class="crdash-hero-row">
            <div>
                <h2>Welcome to CR Management System</h2>
                <p>Here's where every change request stands right now across the pipeline.</p>
            </div>
            <div class="crdash-hero-total">
                <div class="num">@Model.TotalCRs</div>
                <div class="lbl">Total Change Requests</div>
            </div>
        </div>
    </div>

    <div class="row row-cols-xxl-4 row-cols-md-2 row-cols-1 g-3">
        <div class="col">
            <div class="crdash-stat is-total">
                <div class="crdash-stat-top">
                    <div>
                        <h5 class="crdash-stat-label">Total CRs</h5>
                        <h3 class="crdash-stat-value">@Model.TotalCRs</h3>
                    </div>
                    <span class="crdash-stat-ico"><iconify-icon icon="solar:bill-list-bold-duotone"></iconify-icon></span>
                </div>
                <div class="crdash-stat-foot"><i class="ri-stack-line"></i>All requests ever logged</div>
            </div>
        </div><!-- end col -->

        <div class="col">
            <div class="crdash-stat is-ok">
                <div class="crdash-stat-top">
                    <div>
                        <h5 class="crdash-stat-label">In Progress</h5>
                        <h3 class="crdash-stat-value">@Model.PendingApprovals</h3>
                    </div>
                    <span class="crdash-stat-ico"><iconify-icon icon="solar:hourglass-bold-duotone"></iconify-icon></span>
                </div>
                <div class="crdash-stat-bar"><span style="width:@(inProgressPct)%;"></span></div>
                <div class="crdash-stat-foot"><i class="ri-percent-line"></i>@(inProgressPct)% of total</div>
            </div>
        </div><!-- end col -->

        <div class="col">
            <div class="crdash-stat is-info">
                <div class="crdash-stat-top">
                    <div>
                        <h5 class="crdash-stat-label">Deployed CRs</h5>
                        <h3 class="crdash-stat-value">@Model.TotalHolds</h3>
                    </div>
                    <span class="crdash-stat-ico"><iconify-icon icon="solar:golf-bold-duotone"></iconify-icon></span>
                </div>
                <div class="crdash-stat-bar"><span style="width:@(deployedPct)%;"></span></div>
                <div class="crdash-stat-foot"><i class="ri-percent-line"></i>@(deployedPct)% of total</div>
            </div>
        </div><!-- end col -->

        <div class="col">
            <div class="crdash-stat is-bad">
                <div class="crdash-stat-top">
                    <div>
                        <h5 class="crdash-stat-label">Rejected CRs</h5>
                        <h3 class="crdash-stat-value">@Model.RejectedCRs</h3>
                    </div>
                    <span class="crdash-stat-ico"><iconify-icon icon="solar:sticker-smile-circle-bold-duotone"></iconify-icon></span>
                </div>
                <div class="crdash-stat-bar"><span style="width:@(rejectedPct)%;"></span></div>
                <div class="crdash-stat-foot"><i class="ri-percent-line"></i>@(rejectedPct)% of total</div>
            </div>
        </div><!-- end col -->
    </div><!-- end row -->

    <div class="row g-3 mt-1">
        <div class="col-xl-6">
            <div class="card crdash-chart-card mb-0">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h4 class="crdash-chart-title"><i class="ri-bar-chart-grouped-line"></i>CR Submissions</h4>
                        <p class="crdash-chart-sub" id="trend-sub">Monthly submissions for @DateTime.Now.Year</p>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Submission trend filter">
                        <button type="button" class="btn btn-outline-secondary crdash-trend-btn" data-period="week">Weekly</button>
                        <button type="button" class="btn btn-outline-secondary crdash-trend-btn active" data-period="month">Monthly</button>
                        <button type="button" class="btn btn-outline-secondary crdash-trend-btn" data-period="year">Yearly</button>
                    </div>
                </div>
                <div class="card-body px-2 pt-2">
                    <div dir="ltr">
                        <div id="statistics-chart" class="apex-charts" data-colors="#3b5bdb"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card crdash-chart-card mb-0">
                <div class="card-header">
                    <h4 class="crdash-chart-title"><i class="ri-pie-chart-2-line"></i>CR Breakdown</h4>
                    <p class="crdash-chart-sub">Share of requests by current state</p>
                </div>
                <div class="card-body">
                    <div dir="ltr" class="crdash-pie-wrap">
                        <div id="simple-pie" class="apex-charts" data-colors="#0acf97,#fa5c7c,#f7b84b"></div>
                        <div class="crdash-pie-center">
                            <div class="pc-label">Total CRs</div>
                            <div class="pc-total" id="pc-total">0</div>
                            <div class="pc-breakdown">
                                <div>Deployed: <b id="pc-deployed">0</b></div>
                                <div>Rejected: <b id="pc-rejected">0</b></div>
                                <div>In Progress: <b id="pc-inprogress">0</b></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
            // NOTE: "inProgress" here is the "everything not Deployed and not Rejected"
            // bucket, computed server-side in GetDashboardMetricsAsync so Deployed +
            // Rejected + InProgress always sums exactly to TotalCRs.
            const crStats = @Html.Raw(JsonSerializer.Serialize(new
            {
                                totalCRs = Model.TotalCRs,
                                inProgress = Model.PendingApprovals,
                                holds = Model.TotalHolds,
                                rejected = Model.RejectedCRs
            }));

    document.addEventListener("DOMContentLoaded", function () {

                // Animate the stat bars in after load
                requestAnimationFrame(function () {
                    document.querySelectorAll('.crdash-stat-bar > span').forEach(function (el) {
                        var target = el.style.width;
                        el.style.width = '0%';
                        requestAnimationFrame(function () {
                            requestAnimationFrame(function () {
                                el.style.width = target;
                            });
                        });
                    });
                });

                // ===== CR Submissions bar chart: single series, Week/Month/Year filter =====
                var trendChart = new ApexCharts(document.querySelector("#statistics-chart"), {
                    chart: { type: "bar", height: 300, toolbar: { show: false }, fontFamily: "inherit" },
                    series: [{ name: "Submissions", data: [] }],
                    xaxis: { categories: [] },
                    yaxis: {
                        labels: {
                            formatter: function (val) {
                                return Math.round(val);
                            }
                        },
                        forceNiceScale: true,
                        tickAmount: undefined
                    },
                    colors: ["#3b5bdb"],
                    plotOptions: { bar: { columnWidth: "45%", borderRadius: 5 } },
                    dataLabels: { enabled: false },
                    grid: { borderColor: "rgba(120,130,150,.15)", strokeDashArray: 4 },
                    legend: { show: false }
                });
                trendChart.render();

                var trendSubLabels = {
                    week: "Last 8 weeks",
                    month: "Monthly submissions for @DateTime.Now.Year",
                    year: "Submissions by year"
                };

                function loadTrend(period) {
                    $.ajax({
                        url: '@Url.Action("GetSubmissionTrend", "Home")',
                        type: 'GET',
                        data: { period: period },
                        success: function (response) {
                            if (!response || response.success === false) { return; }

                            trendChart.updateOptions({
                                xaxis: { categories: response.labels }
                            });
                            trendChart.updateSeries([
                                { name: "Submissions", data: response.counts }
                            ]);

                            document.getElementById('trend-sub').textContent =
                                trendSubLabels[period] || 'Submissions';
                        },
                        error: function () {
                            console.error('Failed to load submission trend for period: ' + period);
                        }
                    });
                }

                // Filter button clicks
                document.querySelectorAll('.crdash-trend-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.querySelectorAll('.crdash-trend-btn').forEach(function (b) {
                            b.classList.remove('active');
                        });
                        this.classList.add('active');
                        loadTrend(this.dataset.period);
                    });
                });

                // Initial load: monthly
                loadTrend('month');

                // ===== Donut chart: Deployed / Rejected / In Progress only =====
                // These three buckets are computed server-side (GetDashboardMetricsAsync)
                // so that Deployed + Rejected + InProgress always sums exactly to TotalCRs.
                // TotalCRs itself is shown only in the center overlay, never as a ring slice,
                // since a "total" slice next to its own parts double-counts the ring.
                document.getElementById('pc-total').textContent = crStats.totalCRs;
                document.getElementById('pc-deployed').textContent = crStats.holds;
                document.getElementById('pc-rejected').textContent = crStats.rejected;
                document.getElementById('pc-inprogress').textContent = crStats.inProgress;

                new ApexCharts(document.querySelector("#simple-pie"), {
                    chart: { type: "donut", height: 320, fontFamily: "inherit" },
                    series: [crStats.holds, crStats.rejected, crStats.inProgress],
                    labels: ["Deployed CRs", "Rejected CRs", "In Progress"],
                    colors: ["#0acf97", "#fa5c7c", "#f7b84b"],
                    legend: { position: "bottom" },
                    dataLabels: {
                        enabled: true,
                        formatter: function (val) {
                            return val.toFixed(1) + "%";
                        }
                    },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: "65%",
                                labels: { show: false } // built-in label hidden; using HTML overlay instead
                            }
                        }
                    },
                    noData: { text: 'No change requests yet' },
                    responsive: [{
                        breakpoint: 480,
                        options: {
                            chart: { width: 260 },
                            legend: { position: "bottom" }
                        }
                    }]
                }).render();

            });
    </script>
}
